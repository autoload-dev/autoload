load("//godot:defs.bzl", "godot_addon", "godot_pack", "godot_project", "godot_resources")
load("//godot/extension:defs.bzl", "godot_extension")

package(default_visibility = ["//godot/private/tests:__subpackages__"])

# The release directory as upstream ships it: scripts, its own descriptor and prebuilt
# libraries. rules_godot writes the descriptor from the extension, so the shipped one stays
# out of both parts.
godot_extension(
    name = "sentry_native",
    entry_symbol = "sentry_init",
    library = select({
        "@platforms//os:linux": "sentry/bin/linux/libsentry.linux.so",
        "@platforms//os:macos": "sentry/bin/macos/libsentry.macos.dylib",
        "//conditions:default": None,
    }),
    resource_path = "addons/sentry/sentry.gdextension",
    tags = ["manual"],
)

godot_addon(
    name = "sentry",
    srcs = glob(
        ["sentry/**"],
        exclude = [
            "sentry/bin/**",
            "sentry/sentry.gdextension",
        ],
    ),
    strip_prefix = "sentry",
    tags = ["manual"],
    deps = [":sentry_native"],
)

godot_resources(
    name = "main",
    srcs = ["main/main.gd"],
    tags = ["manual"],
    deps = [":sentry"],
)

godot_project(
    name = "vendored_release",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "pack",
    project = ":vendored_release",
    tags = ["manual"],
    deps = [":main"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = [
        "main/main.gd",
        "sentry/sentry_logger.gd",
    ],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "markdown_files",
    testonly = True,
    srcs = ["README.md"],
    tags = ["markdown"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
