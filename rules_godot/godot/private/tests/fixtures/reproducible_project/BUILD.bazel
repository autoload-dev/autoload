load("//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")

# A project with two imported SVG assets and a script, whose import and export the
# reproducibility test repeats.
package(default_visibility = ["//godot:__subpackages__"])

godot_resources(
    name = "icon",
    srcs = ["main/icon.svg"],
    tags = ["manual"],
)

godot_resources(
    name = "other",
    srcs = ["main/other.svg"],
    tags = ["manual"],
)

godot_resources(
    name = "main",
    srcs = [
        "main/main.gd",
        "main/main.tscn",
    ],
    tags = ["manual"],
)

godot_project(
    name = "reproducible_project",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":reproducible_project",
    tags = ["manual"],
    deps = [
        ":icon",
        ":main",
        ":other",
    ],
)
