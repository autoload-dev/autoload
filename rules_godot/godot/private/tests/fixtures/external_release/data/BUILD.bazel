package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

filegroup(
    name = "values",
    srcs = glob(["values/**"]),
)

# A file of a sibling package: a target here cannot place it relative to its own package.
filegroup(
    name = "foreign",
    srcs = ["//:addons/vendor/plugin_settings.cfg"],
)
