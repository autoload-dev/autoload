load("@rules_python//python:defs.bzl", "py_test")
load("//godot:defs.bzl", "godot_test")
load("//godot/private/tests:pack_forms.bzl", "pack_form")
load("//godot/private/tests:packaging.bzl", "in_export_platform")

package(default_testonly = True)

_FIXTURE = "//godot/private/tests/pack_forms/fixtures/project_with_runtime_inputs"

# The fixture's pack in each form: Godot's export, and written without Godot's conversions.
pack_form(
    name = "godot_pack",
    form = "godot",
    pack = _FIXTURE + ":pack",
    tags = ["manual"],
)

pack_form(
    name = "none_pack",
    form = "none",
    pack = _FIXTURE + ":pack",
    tags = ["manual"],
)

# The fixture's pack for Android, whose export needs the ETC2/ASTC variants of the VRAM
# texture that the host's own export does not.
in_export_platform(
    name = "android_pack",
    export_platform = "//godot/platforms:android_arm64",
    tags = ["manual"],
    deps = [_FIXTURE + ":pack"],
)

pack_form(
    name = "android_godot_pack",
    form = "godot",
    pack = ":android_pack",
    tags = ["manual"],
)

pack_form(
    name = "android_none_pack",
    form = "none",
    pack = ":android_pack",
    tags = ["manual"],
)

# Run tests: the main scene checks the translation, the texture and the global class.
godot_test(
    name = "godot_pack_runtime_inputs_test",
    size = "medium",
    pack = ":godot_pack",
    tags = ["godot_process"],
)

godot_test(
    name = "none_pack_runtime_inputs_test",
    size = "medium",
    pack = ":none_pack",
    tags = ["godot_process"],
)

# Build-output test: what both forms pack for the runtime besides the files.
py_test(
    name = "packs_carry_runtime_inputs_test",
    size = "medium",
    srcs = ["runtime_inputs_test.py"],
    data = [
        ":android_godot_pack",
        ":android_none_pack",
        ":godot_pack",
        ":none_pack",
    ],
    main = "runtime_inputs_test.py",
    tags = ["godot_process"],
    deps = ["//tools:pck_lib"],
)
