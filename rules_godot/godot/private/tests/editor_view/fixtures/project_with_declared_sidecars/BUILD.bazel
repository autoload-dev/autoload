load("//godot:defs.bzl", "godot_project", "godot_resources")

# A script whose UID sidecar is declared beside it, on the ruleset's default project file.
package(default_visibility = ["//godot/private/tests/editor_view:__pkg__"])

godot_resources(
    name = "declared",
    srcs = [
        "declared.gd",
        "declared.gd.uid",
    ],
    tags = ["manual"],
)

godot_project(
    name = "project",
    project_file = "//godot/private:default_project.godot",
    tags = ["manual"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["declared.gd"],
    tags = ["gdscript"],
)
