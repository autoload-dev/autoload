load("//godot:defs.bzl", "godot_project", "godot_resources")

# A project whose main scene reports an error and exits with 0.
package(default_visibility = ["//godot/private/tests/run_errors:__pkg__"])

godot_resources(
    name = "main",
    srcs = [
        "main/main.gd",
        "main/main.tscn",
    ],
    tags = ["manual"],
)

godot_project(
    name = "project_reporting_an_error",
    project_file = "project.godot",
    tags = ["manual"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["main/main.gd"],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
