load("@rules_python//python:defs.bzl", "py_test")
load("//godot:defs.bzl", "godot_test")

_FIXTURE = "//godot/private/tests/run_errors/fixtures/project_reporting_an_error"

# Run test: a test that only reports the error passes with Godot's exit status.
godot_test(
    name = "reported_error_keeps_the_exit_status_test",
    size = "small",
    engine_errors = "report",
    project = _FIXTURE,
    tags = ["godot_process"],
    deps = [_FIXTURE + ":main"],
)

# The same test with the default engine_errors, which the next test runs and expects to fail.
godot_test(
    name = "failing_test",
    size = "medium",
    project = _FIXTURE,
    tags = ["manual"],
    deps = [_FIXTURE + ":main"],
)

# Run test: by default, the error fails the test although Godot exits with 0.
py_test(
    name = "reported_error_fails_the_test_test",
    size = "small",
    srcs = ["reported_error_test.py"],
    args = ["$(rootpath :failing_test)"],
    data = [":failing_test"],
    main = "reported_error_test.py",
    tags = ["godot_process"],
)
