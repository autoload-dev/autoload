# The setting kinds and sections of Godot 4.7 the configuration tests construct with.
write_file(
    name = "setting_kinds",
    out = "setting_kinds.json",
    content = [json.encode({
        "kinds": SETTING_KIND_TABLES["4.7"],
        "sections": engine_sections("4.7.2"),
    })],
)

# The setting value cases with setting_values.bzl's decision for each, which project_config_test
# compares with project_config.py's.
write_file(
    name = "setting_value_cases",
    out = "setting_value_cases.json",
    content = [setting_value_cases()],
)

# The feature override cases with setting_values.bzl's decision for each, which project_config_test
# compares with project_config.py's.
write_file(
    name = "override_cases",
    out = "override_cases.json",
    content = [override_cases()],
)

py_test(
    name = "project_config_test",
    size = "small",
    srcs = ["project_config_test.py"],
    data = [
        ":override_cases",
        ":setting_kinds",
        ":setting_value_cases",
    ],
    deps = ["//godot/private:project_config_lib"],
)

py_test(
    name = "pinned_settings_test",
    size = "small",
    srcs = ["pinned_settings_test.py"],
    deps = ["//godot/private:project_config_lib"],
)

