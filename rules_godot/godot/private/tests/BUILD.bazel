# Build-output test: two runs of the import and the export over one project give the same
# bytes.
import_and_pack_reproducibility_test(
    name = "import_and_pack_outputs_are_reproducible_test",
    size = "medium",
    pack = "//godot/private/tests/fixtures/reproducible_project:pack",
    tags = ["godot_process"],
    units = [
        "icon",
        "other",
