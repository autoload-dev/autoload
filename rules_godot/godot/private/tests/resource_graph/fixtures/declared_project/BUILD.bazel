load("//godot:defs.bzl", "godot_project", "godot_resources")
load("//godot/private:analysis.bzl", "godot_resource_graph")

# A project whose scene, script and resource are declared with the runtime references of the
# script and the scene, and its resource graph that requires declared edges.
package(default_visibility = ["//godot/private/tests/resource_graph:__pkg__"])

godot_resources(
    name = "sources",
    srcs = [
        "main/content.tres",
        "main/main.gd",
        "main/main.tscn",
    ],
    runtime_references = {
        "main/main.gd": ["main/content.tres"],
        "main/main.tscn": ["main/main.gd"],
    },
    tags = ["manual"],
)

godot_project(
    name = "declared_project",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_resource_graph(
    name = "graph",
    project = ":declared_project",
    require_declared = True,
    tags = ["manual"],
    deps = [":sources"],
)
