load("@rules_python//python:defs.bzl", "py_test")
load(":resource_graph_tests.bzl", "resource_graph_test_suite")

_FIXTURE = "//godot/private/tests/resource_graph/fixtures/project_with_generated_declarations:"

# Build-output test: the graph action over generated source declarations infers the
# project's edges and finds each of them declared.
py_test(
    name = "resource_graph_infers_declared_edges_test",
    size = "medium",
    srcs = ["resource_graph_test.py"],
    args = ["$(rootpath %sgraph)" % _FIXTURE],
    data = [_FIXTURE + "graph"],
    main = "resource_graph_test.py",
    tags = ["godot_process"],
)

resource_graph_test_suite(name = "resource_graph_test_suite")

filegroup(
    name = "markdown_files",
    testonly = True,
    srcs = ["fixtures/README.md"],
    tags = ["markdown"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["resource_graph_test.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "resource_graph_tests.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
