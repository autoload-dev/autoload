# ==== Interfaces ==============================================================

# A unit's dependents validate against its interface (#158): the base's declarations, the
# coroutine flags of its functions and the classes of its imported assets, as the analyzer
# and the loader read them from its sources, decide the users' validations; an error in a
# function body of the base fails only the base's own validation.
godot_resources(
    name = "interface_base",
    srcs = glob(["fixtures/interface/base/*"]),
    strip_prefix = "fixtures",
)

# An asset without an .import file of its own: Godot writes it during the import, so the
# unit's dependents stage its import result as it is.
godot_resources(
    name = "interface_plain",
    srcs = ["fixtures/interface/plain/plain.png"],
    strip_prefix = "fixtures",
)

godot_resources(
    name = "interface_user",
    srcs = [
        "fixtures/interface/users/scene_user.tscn",
        "fixtures/interface/users/uses.gd",
    ],
    strip_prefix = "fixtures",
    deps = [
        ":interface_base",
        ":interface_plain",
    ],
)

godot_resources(
    name = "interface_misuser",
    srcs = ["fixtures/interface/users/misuses.gd"],
    strip_prefix = "fixtures",
    deps = [":interface_base"],
)

godot_resources(
    name = "interface_body_error_user",
    srcs = ["fixtures/interface/users/body_error_user.gd"],
    strip_prefix = "fixtures",
    deps = [":interface_base"],
)

in_context(
    name = "interface_validations",
    project = ":project",
    tags = ["manual"],
    deps = [
        ":interface_body_error_user",
        ":interface_misuser",
        ":interface_user",
    ],
)

reported_build(
    name = "interface_validations_reported",
    tags = ["manual"],
    deps = [":interface_validations"],
)

py_test(
    name = "dependents_validate_against_interfaces_test",
    size = "small",
    srcs = ["interface_validation_test.py"],
    args = ["$(rootpaths :interface_validations_reported)"],
    data = [":interface_validations_reported"],
    main = "interface_validation_test.py",
    tags = ["godot_process"],
)

# ==== Platform libraries ======================================================

# A script fails the validation of a platform whose runtime cannot load the extension it
# uses, one without a library for that platform, unless it guards the use with ClassDB. The
# editor knows the class in every configuration, so only the platform's library decides.
cc_binary(
    name = "libplatform_probe.so",
    srcs = ["fixtures/platform_probe/probe.cc"],
    linkshared = True,
    deps = ["@godot_cpp"],
)

godot_extension(
    name = "platform_probe_absent",
    entry_symbol = "platform_probe_init",
    library = select({
        "//godot:tool": ":libplatform_probe.so",
        "//conditions:default": None,
    }),
    resource_path = "platform_probe/absent/probe.gdextension",
)

# A library for the platform but none in the tool configuration, as for an extension without a
# library for a remote executor.
godot_extension(
    name = "platform_probe_toolless",
    entry_symbol = "platform_probe_init",
    library = select({
        "//godot:tool": None,
        "//conditions:default": ":libplatform_probe.so",
    }),
    resource_path = "platform_probe/toolless/probe.gdextension",
)

godot_extension(
    name = "platform_probe_everywhere",
    entry_symbol = "platform_probe_init",
    library = ":libplatform_probe.so",
    resource_path = "platform_probe/everywhere/probe.gdextension",
)

[
    godot_resources(
        name = "platform_probe_%s_%s" % (case, use),
        srcs = ["fixtures/platform_probe/%s/%s.gd" % (case, use)],
        strip_prefix = "fixtures",
        deps = [":platform_probe_" + case],
    )
    for case, use in [
        ("absent", "direct"),
        ("absent", "guarded"),
        ("everywhere", "direct"),
        ("toolless", "direct"),
    ]
]

# An editor part runs in the editor, which loads the extension on every platform.
godot_addon(
    name = "platform_probe_editor",
    directory = "addons/platform_probe_editor",
    editor_srcs = [
        "fixtures/addons/platform_probe_editor/editor.gd",
        "fixtures/addons/platform_probe_editor/plugin.cfg",
    ],
    strip_prefix = "fixtures/addons/platform_probe_editor",
    deps = [":platform_probe_absent"],
)

in_context(
    name = "platform_probe_validations",
    project = ":project",
    tags = ["manual"],
    deps = [
        ":platform_probe_absent_direct",
        ":platform_probe_absent_guarded",
        ":platform_probe_editor",
        ":platform_probe_everywhere_direct",
        ":platform_probe_toolless_direct",
    ],
)

# The direct use fails its validation, so the validations are built with failures reported.
reported_build(
    name = "platform_probe_validations_reported",
    tags = ["manual"],
    deps = [":platform_probe_validations"],
)

py_test(
    name = "extension_without_platform_library_fails_its_users_test",
    size = "small",
    srcs = ["absent_extension_validation_test.py"],
    args = ["$(rootpaths :platform_probe_validations_reported)"],
    data = [":platform_probe_validations_reported"],
    main = "absent_extension_validation_test.py",
    tags = ["godot_process"],
)
