# Sections: Class cache, Project code guard, GDScript warnings, Script errors,
# Interfaces, Platform libraries.

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//godot:defs.bzl", "godot_addon", "godot_pack", "godot_project", "godot_resources", "godot_run")
load("//godot/extension:defs.bzl", "godot_extension")
load("//godot/private/tests:content_validation.bzl", "in_context", "reported_build")

package(
    default_testonly = True,
    default_visibility = ["//godot/private/tests:__subpackages__"],
)

godot_project(
    name = "project",
    project_file = "fixtures/project.godot",
)

# ==== Class cache =============================================================

# Script headers whose global classes Godot's scan records: @abstract, one-line
# class_name ... extends ..., bases written as script paths, inner classes with their
# extends on the same or the next line, and an @icon with a trailing comma.
filegroup(
    name = "class_headers",
    srcs = glob(["fixtures/classes/*.gd"]),
    visibility = ["//tools/resources/tests:__pkg__"],
)

godot_resources(
    name = "classes",
    srcs = glob(["fixtures/classes/*.gd"]),
    strip_prefix = "fixtures",
)

godot_run(
    name = "classes_run",
    project = ":project",
    tags = ["manual"],
    deps = [":classes"],
)

in_context(
    name = "class_cache_inputs",
    operations = [":classes_run"],
    project = ":project",
    deps = [":classes"],
)

# The class fragments merged into the cache Godot's own scan writes in the initialization.
py_test(
    name = "class_cache_matches_godot_test",
    size = "small",
    srcs = ["class_cache_test.py"],
    args = ["$(rootpaths :class_cache_inputs)"],
    data = [":class_cache_inputs"],
    main = "class_cache_test.py",
    tags = ["godot_process"],
    deps = ["//tools/resources:class_fragment_lib"],
)

# A unit whose closure holds a global class with an authored UID, used by a scene through
# both, and which uses an extension; and a script outside its closure.
godot_resources(
    name = "thing",
    srcs = [
        "fixtures/closure/thing.gd",
        "fixtures/closure/thing.gd.uid",
    ],
    strip_prefix = "fixtures",
)

godot_resources(
    name = "level",
    srcs = [
        "fixtures/unit/level.gd",
        "fixtures/unit/level.tscn",
    ],
    strip_prefix = "fixtures",
    deps = [
        ":thing",
        "//godot/private/tests/fixtures/project_with_native_extension:hello",
    ],
)

godot_resources(
    name = "outside",
    srcs = ["fixtures/outside/outside.gd"],
    strip_prefix = "fixtures",
)

godot_pack(
    name = "pack",
    project = ":project",
    tags = ["manual"],
    deps = [
        ":level",
        ":outside",
    ],
)

# ==== Project code guard ======================================================

# FR-033: the validation runs no project code. Every kind of code that loading could run
# calls the guard (fixtures/guard/guard.gd), which fails the validation: the autoloads'
# constructors and notifications, static initializers of scripts, tool scripts, scripts
# built into scenes and preloaded scripts, and the constructors, member initializers and
# setters of custom resources that scenes and scripts load.
godot_project(
    name = "autoload_project",
    autoloads = {
        "Hud": "*res://autoloads/hud.tscn",
        "ToolTracker": "*res://autoloads/tool_tracker.gd",
        "Tracker": "*res://autoloads/tracker.gd",
    },
    project_file = "fixtures/project.godot",
)

# The same autoloads declared in the authored project.godot, as Godot's editor writes
# them, the scene by its UID.
godot_project(
    name = "authored_autoload_project",
    project_file = "fixtures/authored/project.godot",
)

godot_resources(
    name = "guard",
    srcs = ["fixtures/guard/guard.gd"],
    strip_prefix = "fixtures",
)

godot_resources(
    name = "autoloads",
    srcs = glob(["fixtures/autoloads/*"]),
    strip_prefix = "fixtures",
    deps = [":guard"],
)

godot_resources(
    name = "autoload_user",
    srcs = ["fixtures/autoload_users/uses.gd"],
    strip_prefix = "fixtures",
    deps = [":autoloads"],
)

godot_resources(
    name = "autoload_misuse",
    srcs = [
        "fixtures/autoload_users/wrong_scene_call.gd",
        "fixtures/autoload_users/wrong_script_call.gd",
    ],
    strip_prefix = "fixtures",
    deps = [":autoloads"],
)

godot_resources(
    name = "code",
    srcs = glob(["fixtures/code/*"]),
    strip_prefix = "fixtures",
    deps = [":guard"],
)

# Scripts of :code reach its validation through a preload and a global class.
godot_resources(
    name = "preloader",
    srcs = ["fixtures/preloader/preloader.gd"],
    strip_prefix = "fixtures",
    deps = [":code"],
)

[
    in_context(
        name = project + "_validations",
        project = ":" + project,
        tags = ["manual"],
        deps = [
            ":autoload_misuse",
            ":autoload_user",
            ":code",
            ":preloader",
        ],
    )
    for project in [
        "autoload_project",
        "authored_autoload_project",
    ]
]

# The misuse fails its validation, so the validations are built with failures reported.
[
    reported_build(
        name = project + "_validations_reported",
        tags = ["manual"],
        deps = [":" + project + "_validations"],
    )
    for project in [
        "autoload_project",
        "authored_autoload_project",
    ]
]

[
    py_test(
        name = "validation_runs_no_project_code_%s_test" % project,
        size = "small",
        srcs = ["project_code_validation_test.py"],
        args = ["$(rootpaths :%s_validations_reported)" % project],
        data = [":%s_validations_reported" % project],
        main = "project_code_validation_test.py",
        tags = ["godot_process"],
    )
    for project in [
        "autoload_project",
        "authored_autoload_project",
    ]
]

# ==== GDScript warnings =======================================================

# The validation follows the project's GDScript warning settings: a project raising
# untyped declarations to errors fails a unit's untyped script, while an add-on below
# res://addons stays exempt, as Godot's default directory_rules exempt res://addons,
# unless the project's directory_rules include its directory.
godot_project(
    name = "warnings_project",
    project_file = "fixtures/project.godot",
    settings = {"debug/gdscript/warnings/untyped_declaration": "2"},
)

godot_project(
    name = "addon_warnings_project",
    project_file = "fixtures/project.godot",
    settings = {
        "debug/gdscript/warnings/directory_rules": '{"res://addons": 0, "res://addons/checked": 1}',
        "debug/gdscript/warnings/untyped_declaration": "2",
    },
)

godot_resources(
    name = "untyped",
    srcs = ["fixtures/warnings/untyped.gd"],
    strip_prefix = "fixtures",
)

godot_addon(
    name = "checked",
    srcs = ["fixtures/addons/checked/untyped.gd"],
    strip_prefix = "fixtures/addons/checked",
)

[
    in_context(
        name = project + "_validations",
        project = ":" + project,
        tags = ["manual"],
        deps = [
            ":checked",
            ":untyped",
        ],
    )
    for project in [
        "project",
        "warnings_project",
        "addon_warnings_project",
    ]
]

# Each raised warning fails its validation, so the validations are built with failures
# reported.
[
    reported_build(
        name = project + "_validations_reported",
        tags = ["manual"],
        deps = [":" + project + "_validations"],
    )
    for project in [
        "project",
        "warnings_project",
        "addon_warnings_project",
    ]
]

[
    py_test(
        name = "validation_follows_warning_settings_%s_test" % project,
        size = "small",
        srcs = ["warning_validation_test.py"],
        args = [
            project,
            "$(rootpaths :%s_validations_reported)" % project,
        ],
        data = [":%s_validations_reported" % project],
        main = "warning_validation_test.py",
        tags = ["godot_process"],
    )
    for project in [
        "project",
        "warnings_project",
        "addon_warnings_project",
    ]
]

