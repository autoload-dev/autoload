load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//godot:__subpackages__"])

# The modules as files, for the module's own documentation and repository rules.
exports_files(
    glob(["*.bzl"]),
    visibility = ["//:__subpackages__"],
)

# Godot's default application icon and boot splash of each profile.
filegroup(
    name = "assets",
    srcs = glob(["*.png"]),
)

# Godot's template activity of each profile, with the BuildConfig its Gradle build
# generates.
filegroup(
    name = "android_sources",
    srcs = glob(["android/**/*.java"]),
)

# Godot's Maven graph of each profile's Android shell: what Gradle resolves for the Maven
# dependencies Godot declares, pinned by rules_godot's godot_android_maven_graph
# installation. Each version is a minimum for Android applications.
filegroup(
    name = "android_maven_graphs",
    srcs = glob(["android/*_install.json"]),
)

bzl_library(
    name = "profiles",
    srcs = ["profiles.bzl"],
    deps = ["//godot/private:versions"],
)

bzl_library(
    name = "setting_kinds",
    srcs = ["setting_kinds.bzl"],
    deps = ["//godot/private:versions"],
)
