load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Test rules that inspect a built Android App Bundle or iOS application for the ruleset's
# own tests and its tests module: their rules, launch templates and inspectors. The tests
# module loads the rules across repositories; they are not supported API.
package(default_visibility = ["//visibility:private"])

# The repository's root module lists these files in the Starlark library it extracts the API
# documentation with (tools/docs/api). Their load visibility still restricts who loads them.
exports_files(
    [
        "android_bundle_test.bzl",
        "ios_app_test.bzl",
    ],
    visibility = ["//visibility:public"],
)

# The launch templates the rules of this package expand.
exports_files(
    glob(["*.tpl"]),
    visibility = ["//visibility:private"],
)

py_library(
    name = "native_symbols",
    srcs = ["native_symbols.py"],
    visibility = ["//godot/private/testing/tests:__pkg__"],
)

py_library(
    name = "inspect_android_bundle_lib",
    srcs = [
        "inspect_android_bundle.py",
        "pck.py",
    ],
    visibility = ["//godot/private/testing/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_android_bundle",
    srcs = ["inspect_android_bundle.py"],
    deps = [":inspect_android_bundle_lib"],
)

py_library(
    name = "inspect_ios_app_lib",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    visibility = ["//godot/private/testing/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_ios_app",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    main = "inspect_ios_app.py",
    deps = [":native_symbols"],
)
