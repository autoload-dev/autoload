load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Test rules that inspect a built Android App Bundle or iOS application for the ruleset's
# own tests and the repository's consumer scenarios: their rules, launch templates and
# inspectors. The scenarios load the rules across repositories; they are not supported API.
package(default_visibility = ["//visibility:private"])

# The launch templates the rules of this package expand.
exports_files(
    glob(["*.tpl"]),
    visibility = ["//visibility:private"],
)

py_library(
    name = "native_symbols",
    srcs = ["native_symbols.py"],
    visibility = ["//godot/private/testing/tests:__pkg__"],
)

py_library(
    name = "inspect_android_bundle_lib",
    srcs = [
        "inspect_android_bundle.py",
        "pck.py",
    ],
    visibility = ["//godot/private/testing/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_android_bundle",
    srcs = ["inspect_android_bundle.py"],
    deps = [":inspect_android_bundle_lib"],
)

py_library(
    name = "inspect_ios_app_lib",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    visibility = ["//godot/private/testing/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_ios_app",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    main = "inspect_ios_app.py",
    deps = [":native_symbols"],
)

# The Starlark libraries of the test rules, by hand: Gazelle's bzl_library plugin leaves out
# modules named like tests. `keep` stops Gazelle from emptying their attributes.
bzl_library(
    name = "android_bundle_test",
    srcs = ["android_bundle_test.bzl"],  # keep
    visibility = ["//godot:__subpackages__"],
    # keep
    deps = [
        "//godot/private:paths",
        "@rules_android//rules:bzl",
        "@rules_java//java/common",
    ],
)

bzl_library(
    name = "ios_app_test",
    srcs = ["ios_app_test.bzl"],  # keep
    visibility = ["//godot:__subpackages__"],
    # keep
    deps = [
        "//godot/private:paths",
        "@rules_apple//apple:providers",
    ],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "apple_bundle.py",
        "inspect_android_bundle.py",
        "inspect_ios_app.py",
        "native_symbols.py",
        "pck.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "android_bundle_test.bzl",
        "ios_app_test.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
