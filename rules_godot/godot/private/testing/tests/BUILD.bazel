load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

py_test(
    name = "inspect_android_bundle_test",
    size = "small",
    srcs = ["inspect_android_bundle_test.py"],
    deps = ["//godot/private/testing:inspect_android_bundle_lib"],
)

py_test(
    name = "inspect_ios_app_test",
    size = "small",
    srcs = ["inspect_ios_app_test.py"],
    deps = [
        "//godot/private/testing:inspect_ios_app_lib",
        "//tools/platforms:native_fixtures",
    ],
)

py_test(
    name = "apple_bundle_test",
    size = "small",
    srcs = ["apple_bundle_test.py"],
    deps = ["//godot/private/testing:inspect_ios_app_lib"],
)

py_test(
    name = "native_symbols_test",
    size = "small",
    srcs = ["native_symbols_test.py"],
    deps = [
        "//godot/private/testing:native_symbols",
        "//tools/platforms:native_fixtures",
    ],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "apple_bundle_test.py",
        "inspect_android_bundle_test.py",
        "inspect_ios_app_test.py",
        "native_symbols_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
