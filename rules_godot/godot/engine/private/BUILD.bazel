        "components.bzl",
        "define_analysis.bzl",
        "engine_selection.bzl",
        "extension_plan.bzl",
        "generator.bzl",
        "hub.bzl",
        "optimization.bzl",
        "pin.bzl",
        "prebuilt.bzl",
        "registration.bzl",
        "repositories.bzl",
        "resolution.bzl",
        "selection.bzl",
        "source_repositories.bzl",
