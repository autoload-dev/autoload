load("//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")

# A project whose main scene prints the version of the runtime that runs it.
package(default_visibility = ["//godot/engine/private/tests/prebuilt_boot:__pkg__"])

godot_resources(
    name = "main",
    srcs = [
        "main/main.gd",
        "main/main.tscn",
    ],
    tags = ["manual"],
)

godot_project(
    name = "version_reporting_project",
    main_scene = "main/main.tscn",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "pack",
    project = ":version_reporting_project",
    tags = ["manual"],
    deps = [":main"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["main/main.gd"],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
