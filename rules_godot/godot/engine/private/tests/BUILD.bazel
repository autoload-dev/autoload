# The godot entrypoint of a desktop godot_engine_build recipe: an executable runtime that
# links through CcInfo. Fetching configures the macOS recipe, so it runs in the
# source-engine lane.
repository_test(
    name = "test_engine_build_godot_is_an_executable_runtime",
    cc = True,
    executable = True,
    runtime = True,
    tags = [
        "manual",
        "source_engine",
        "source_engine_extended",
    ],
    target = "@godot_source_build_fixture_macos_arm64_template_release//:godot",
    target_compatible_with = ["@platforms//os:macos"],
)
