package(default_visibility = ["//godot/engine/private/tests:__subpackages__"])

# Plain target platforms: these tests observe toolchain resolution only.
[platform(
    name = name,
    constraint_values = constraints,
) for name, constraints in {
    "linux_x86_64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    # No component covers this slot, so resolution finds no candidate.
    "linux_riscv64": [
        "@platforms//os:linux",
        "@platforms//cpu:riscv64",
    ],
    "ios_arm64": [
        "@platforms//os:ios",
        "@platforms//cpu:aarch64",
        "@apple_support//constraints:device",
    ],
    # Stand-in remote execution platforms; execution_tests.bzl uses the one unlike the host.
    "remote_linux": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "remote_macos": [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    "ios_sim_arm64": [
        "@platforms//os:ios",
        "@platforms//cpu:aarch64",
        "@apple_support//constraints:simulator",
    ],
}.items()]

resolution_probe(
    name = "probe",
    tags = ["manual"],
)

editor_probe(
    name = "editor_probe",
    tags = ["manual"],
)

resolved_runtime(
    name = "resolved_runtime",
    tags = ["manual"],
)

# An application's runtime with a build profile that disables classes.
resolved_runtime(
    name = "profiled_runtime",
    build_profile = "profile.gdbuild",
    tags = ["manual"],
)

# The class generator of a source recipe, as a generated recipe declares it.
godot_source_generator(
    name = "class_generator",
    outs = ["core/disabled_classes.gen.h"],
    class_profile = True,
    inputs = {},
    spec = "class_spec.json",
    tags = ["manual"],
)

profile_reader(
    name = "profile_reader",
    tags = ["manual"],
)

# The engine objects that read no build profile, as a generated recipe gathers them.
godot_profile_independent(
    name = "profile_independent",
    tags = ["manual"],
    deps = [":profile_reader"],
)

# The same objects of a recipe with a runtime variant of profile.gdbuild, which they keep.
godot_profile_independent(
    name = "variant_independent",
    runtime_profiles = [PROFILE],
    tags = ["manual"],
    deps = [":profile_reader"],
)

# The class generator of a runtime variant, whose application's profile is registered.
godot_source_generator(
    name = "registered_class_generator",
    outs = ["registered/core/disabled_classes.gen.h"],
    class_profile = True,
    inputs = {},
    registered_profile = True,
    spec = "class_spec.json",
    tags = ["manual"],
)

# How a recipe's package selects the runtime variant of profile.gdbuild.
config_setting(
    name = "profile_variant",
    flag_values = {"//godot/private:build_profile_label": PROFILE},
)

filegroup(
    name = "variant_probe",
    srcs = select({
        ":profile_variant": ["profile.gdbuild"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

