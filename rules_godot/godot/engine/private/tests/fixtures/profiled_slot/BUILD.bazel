load("//godot/engine:defs.bzl", "godot_runtime_component")

# A slot as a prebuilt hub with source runtimes registers it: the prebuilt runtime serves
# applications without a build profile, the profiled component the others.

godot_runtime_component(
    name = "runtime_linux_x86_64_release",
    build_profiles = "none",
    cpu = "x86_64",
    platform = "linux",
    runtime = "//godot/engine/private/tests/fixtures:linux_x86_64_release.bin",
    variant = "release",
    version = "4.7.2",
)

godot_runtime_component(
    name = "runtime_linux_x86_64_release_profiled",
    build_profiles = "only",
    cpu = "x86_64",
    platform = "linux",
    runtime = "//godot/engine/private/tests/fixtures:linux_x86_64_release.bin",
    variant = "release",
    version = "4.7.2",
)
