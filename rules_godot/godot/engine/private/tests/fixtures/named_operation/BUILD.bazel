load("//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")

# buildifier: disable=bzl-visibility
load("//godot/engine/private:components.bzl", "resolved_runtime")

package(default_visibility = ["//godot/engine/private/tests:__pkg__"])

# Targets that name their engine themselves, in builds that name no engine: a pack of the
# development engine "beta", which the module registers, and a runtime of the fixture
# engine "custom", which its test registers.
godot_project(
    name = "named_operation",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "pack",
    engine = "beta",
    project = ":named_operation",
    tags = ["manual"],
    deps = [":beta_resources"],
)

# Resources that need the engine "beta": a pack of another engine must not reach them.
godot_resources(
    name = "beta_resources",
    srcs = ["beta.gd"],
    engine = "beta",
    tags = ["manual"],
)

godot_pack(
    name = "default_pack",
    project = ":named_operation",
    tags = ["manual"],
    deps = [":beta_resources"],
)

resolved_runtime(
    name = "runtime",
    engine = "custom",
    tags = ["manual"],
)
