load("//godot/engine:defs.bzl", "godot_runtime_component")

package(default_testonly = True)

# A slot as an engine hub with binaries and sources registers it: the prebuilt runtime
# serves the builds whose runtime needs no tuning, the tuned component, registered after it
# in the order of the names, the others.

godot_runtime_component(
    name = "runtime_linux_x86_64_release",
    cpu = "x86_64",
    platform = "linux",
    runtime = "//godot/engine/private/tests/fixtures:linux_x86_64_release.bin",
    untuned_only = True,
    variant = "release",
    version = "4.7.2",
)

godot_runtime_component(
    name = "runtime_linux_x86_64_release_tuned",
    cpu = "x86_64",
    platform = "linux",
    runtime = "//godot/engine/private/tests/fixtures:linux_x86_64_release.bin",
    variant = "release",
    version = "4.7.2",
)
