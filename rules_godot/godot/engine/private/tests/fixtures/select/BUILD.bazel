load("//godot/engine:defs.bzl", "godot_runtime_component")

config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

godot_runtime_component(
    name = "runtime_linux_x86_64_release",
    cpu = "x86_64",
    platform = "linux",
    runtime = select({
        ":optimized": "optimized.bin",
        "//conditions:default": "default.bin",
    }),
    variant = "release",
    version = "4.7.2",
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
