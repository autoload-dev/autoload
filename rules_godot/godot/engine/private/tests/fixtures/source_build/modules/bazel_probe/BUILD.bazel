package(default_testonly = True)

# The bazel_probe engine module of the ruleset's own source-built engines. A source recipe
# names this target, configures with its config.py and SCsub and compiles its code from
# these files; the source-built runtime fixture compiles its sources.
filegroup(
    name = "bazel_probe",
    srcs = glob(["**"]),
    # The beta recipes' godot_custom_module, a repository's target that is no test, takes
    # the module's code from here.
    testonly = False,
    visibility = ["//visibility:public"],
)

exports_files([
    "register_types.cpp",
    "register_types.h",
])
