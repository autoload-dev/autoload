# The bazel_probe engine module of the ruleset's own source-built engines. A source recipe
# names this config.py and copies the whole directory into the engine's modules; the
# source-built runtime fixture compiles its sources.
exports_files([
    "config.py",
    "register_types.cpp",
    "register_types.h",
])

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "register_types.cpp",
        "register_types.h",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["config.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
