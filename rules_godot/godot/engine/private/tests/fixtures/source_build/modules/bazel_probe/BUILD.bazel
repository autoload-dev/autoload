# The bazel_probe engine module of the ruleset's own source-built engines. A source recipe
# names this target, configures with its config.py and SCsub and compiles its code from
# these files; the source-built runtime fixture compiles its sources.
filegroup(
    name = "bazel_probe",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files([
    "register_types.cpp",
    "register_types.h",
])
