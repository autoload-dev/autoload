load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl"]))

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = ["//godot/engine/private:components"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
