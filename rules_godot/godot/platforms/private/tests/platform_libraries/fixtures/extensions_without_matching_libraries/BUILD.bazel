load("//godot:defs.bzl", "godot_pack", "godot_project")
load("//godot/extension:defs.bzl", "godot_extension")
load("//godot/platforms/private/tests/platform_libraries:library_fixtures.bzl", "cc_fixture")
load("//godot/private/tests:fixture_files.bzl", "fixture_file")

# Extensions without a library for an application's operating system, and projects that
# disable extensions for the runtime, deliver none to the application.
package(
    default_testonly = True,
    default_visibility = ["//godot/platforms/private/tests/platform_libraries:__subpackages__"],
)

fixture_file(
    name = "extension_library",
    out = "extension_library/libandroid_library_fixture.so",
)

cc_fixture(
    name = "ios_library",
    static_archive = True,
    tags = ["manual"],
)

godot_extension(
    name = "android_extension",
    entry_symbol = "android_fixture_init",
    library = select({
        "@platforms//os:android": ":extension_library",
        "//conditions:default": None,
    }),
    resource_path = "native/android.gdextension",
    tags = ["manual"],
)

godot_extension(
    name = "ios_extension",
    entry_symbol = "ios_fixture_init",
    library = select({
        "@platforms//os:ios": ":ios_library",
        "//conditions:default": None,
    }),
    resource_path = "native/ios.gdextension",
    tags = ["manual"],
)

# No library for Android or iOS, as a desktop-only extension.
godot_extension(
    name = "desktop_extension",
    entry_symbol = "desktop_fixture_init",
    library = select({
        "@platforms//os:linux": ":extension_library",
        "//conditions:default": None,
    }),
    resource_path = "native/desktop.gdextension",
    tags = ["manual"],
)

godot_project(
    name = "extensions_without_matching_libraries",
    project_file = "project.godot",
    tags = ["manual"],
)

godot_pack(
    name = "desktop_pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":extensions_without_matching_libraries",
    tags = ["manual"],
    deps = [":desktop_extension"],
)

filegroup(
    name = "runtime",
    tags = ["manual"],
)
