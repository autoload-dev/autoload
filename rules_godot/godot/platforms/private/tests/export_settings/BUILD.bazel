load("@rules_python//python:defs.bzl", "py_test")
load("//godot/platforms/private/tests:backends.bzl", "godot_android_application", "godot_ios_application")
load("//godot/platforms/private/tests:transitions.bzl", "configured_outputs")
load("//godot/private/tests:packaging.bzl", "pack_facts")
load(":export_settings_tests.bzl", "export_settings_test_suite")

package(default_testonly = True)

_DEFAULT = "//godot/platforms/private/tests/export_settings/fixtures/packs_with_and_without_version_options:"

_CONFIGURED = "//godot/platforms/private/tests/export_settings/fixtures/packs_with_export_options:"

export_settings_test_suite(name = "export_settings_test_suite")

# The applications' shell files only; their runtime component is empty.
godot_android_application(
    name = "android_app_from_project_settings",
    application_id = "org.example.game",
    pack = _DEFAULT + "android_pack",
    runtime = _DEFAULT + "runtime",
    tags = ["manual"],
)

godot_android_application(
    name = "android_app_with_export_options",
    application_id = "org.example.game",
    pack = _CONFIGURED + "android_pack",
    runtime = _DEFAULT + "runtime",
    tags = ["manual"],
)

godot_ios_application(
    name = "ios_app_from_project_settings",
    bundle_id = "org.example.game",
    executable_name = "custom_engine_name",
    pack = _DEFAULT + "ios_pack",
    runtime = _DEFAULT + "runtime",
    tags = ["manual"],
)

godot_ios_application(
    name = "ios_app_with_export_options",
    bundle_id = "org.example.game",
    pack = _CONFIGURED + "ios_pack",
    runtime = _DEFAULT + "runtime",
    tags = ["manual"],
)

# Build-output test: the Android bootstrap's manifest, its assets/_cl_ command line and its
# pack follow the project settings and the export options, as Godot's exporter does.
py_test(
    name = "android_bootstrap_follows_project_settings_and_export_options_test",
    size = "medium",
    srcs = ["android_bootstrap_test.py"],
    data = [
        ":android_app_from_project_settings.godot_bootstrap",
        ":android_app_from_project_settings.godot_bootstrap.java",
        ":android_app_from_project_settings.godot_bootstrap.manifest",
        ":android_app_with_export_options.godot_bootstrap",
        ":android_app_with_export_options.godot_bootstrap.manifest",
        ":android_app_with_export_options.godot_bootstrap.resources",
        "//godot/private/engine:android_sources",
    ],
    main = "android_bootstrap_test.py",
    tags = ["godot_process"],
    deps = ["//tools/platforms:godot_shell_lib"],
)

# Build-output test: the iOS shell's Godot.plist, privacy manifest, launch screen and pack
# follow the project settings and the export options, as Godot's exporter does.
py_test(
    name = "ios_shell_follows_project_settings_and_export_options_test",
    size = "medium",
    srcs = ["ios_shell_test.py"],
    data = [
        ":ios_app_from_project_settings.godot_shell",
        ":ios_app_from_project_settings.godot_shell.plist",
        ":ios_app_with_export_options.godot_shell",
        ":ios_app_with_export_options.godot_shell.plist",
    ],
    main = "ios_shell_test.py",
    tags = ["godot_process"],
)

pack_facts(
    name = "android_facts",
    pack = _DEFAULT + "android_pack",
    tags = ["manual"],
)

pack_facts(
    name = "ios_facts",
    pack = _DEFAULT + "ios_pack",
    tags = ["manual"],
)

pack_facts(
    name = "macos_facts",
    pack = _CONFIGURED + "macos_pack",
    tags = ["manual"],
)

# Build-output test: the facts Godot reports for an Android, iOS and macOS export list every
# option of the exporter and the version of a project that sets none.
py_test(
    name = "export_facts_list_exporter_options_and_default_version_test",
    size = "medium",
    srcs = ["export_facts_test.py"],
    data = [
        ":android_facts",
        ":ios_facts",
        ":macos_facts",
    ],
    main = "export_facts_test.py",
    tags = ["godot_process"],
)

# The Android shell's Java sources and manifest of a debuggable build and of a release
# build (-c opt), which leaves out the plugin that passes bazel run's Godot arguments.
[
    configured_outputs(
        name = "android_launch_arguments_plugin_%s_%s" % (mode, group),
        compilation_mode = mode,
        output_group = group,
        platform = "//godot/platforms:android_arm64",
        tags = ["manual"],
        target = ":android_app_from_project_settings.godot_bootstrap",
    )
    for mode in [
        "fastbuild",
        "opt",
    ]
    for group in [
        "java",
        "manifest",
    ]
]

# Build-output tests: debuggable builds carry the launch arguments plugin and register it;
# release builds carry neither. One test per mode, whose outputs share runfiles paths.
[
    py_test(
        name = "android_launch_arguments_plugin_in_%s_builds_test" % mode,
        size = "medium",
        srcs = ["android_launch_arguments_test.py"],
        args = [
            "--plugin" if mode == "fastbuild" else "--no-plugin",
            "$(rootpath :android_launch_arguments_plugin_%s_manifest)" % mode,
            "$(rootpaths :android_launch_arguments_plugin_%s_java)" % mode,
        ],
        data = [
            ":android_launch_arguments_plugin_%s_java" % mode,
            ":android_launch_arguments_plugin_%s_manifest" % mode,
        ],
        main = "android_launch_arguments_test.py",
        tags = ["godot_process"],
    )
    for mode in [
        "fastbuild",
        "opt",
    ]
]
