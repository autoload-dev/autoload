load("@rules_python//python:defs.bzl", "py_test")
load(":desktop_package_tests.bzl", "desktop_package_test_suite")
load(":signing.bzl", "adhoc_signed")

package(default_testonly = True)

_RUNTIMES = "//godot/platforms/private/tests/desktop_package/fixtures/desktop_runtimes_without_engine:"

_MACOS_APP = "//godot/platforms/private/tests/desktop_package/fixtures/macos_app_from_project:"

_DSYMS = "//godot/platforms/private/tests/desktop_package/fixtures/macos_apps_with_dsyms:"

_ICON = "//godot/platforms/private/tests/desktop_package/fixtures/macos_app_with_liquid_glass_icon:"

desktop_package_test_suite(name = "desktop_package_test_suite")

# Build-output test: a Linux and a macOS bundle run the stub runtime over their pack, and
# the macOS bundle's shell files come from Godot's export of the project.
py_test(
    name = "desktop_bundles_run_and_carry_export_facts_test",
    size = "small",
    srcs = ["desktop_bundles_test.py"],
    args = [
        "$(rootpaths %slinux_app)" % _RUNTIMES,
        "$(rootpaths %sapp)" % _MACOS_APP,
    ],
    data = [
        _MACOS_APP + "app",
        _RUNTIMES + "linux_app",
    ],
    main = "desktop_bundles_test.py",
    tags = ["godot_process"],
)

adhoc_signed(
    name = "adhoc_signed_bundle_verifies_test_app",
    app = _MACOS_APP + "signed_app",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

# Build-output test: the application signed in adhoc mode verifies with codesign.
py_test(
    name = "adhoc_signed_bundle_verifies_test",
    size = "small",
    srcs = ["adhoc_signing_test.py"],
    args = ["$(rootpaths :adhoc_signed_bundle_verifies_test_app)"],
    data = [":adhoc_signed_bundle_verifies_test_app"],
    main = "adhoc_signing_test.py",
    tags = ["godot_process"],
    target_compatible_with = ["@platforms//os:macos"],
)

# Build-output test: Xcode's actool compiles the pack's Icon Composer .icon into the asset
# catalog of the bundle, whose Info.plist names the icon.
py_test(
    name = "macos_bundle_carries_liquid_glass_icon_test",
    size = "small",
    srcs = ["liquid_glass_icon_test.py"],
    args = ["$(rootpaths %sapp)" % _ICON],
    data = [_ICON + "app"],
    main = "liquid_glass_icon_test.py",
    tags = ["godot_process"],
    target_compatible_with = ["@platforms//os:macos"],
)

# Build-output test: the extension's .dSYM has compile units of its sources and the UUID of
# the stripped library the application packages.
py_test(
    name = "extension_dsym_matches_packaged_library_test",
    size = "small",
    srcs = ["dsym_test.py"],
    args = [
        "$(rootpaths %sprebuilt_runtime_app)" % _DSYMS,
        "$(rootpaths %sprebuilt_runtime_app_debug_symbols)" % _DSYMS,
    ],
    data = [
        _DSYMS + "prebuilt_runtime_app",
        _DSYMS + "prebuilt_runtime_app_debug_symbols",
    ],
    main = "dsym_test.py",
    tags = ["godot_process"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//tools/platforms:native_symbols_lib"],
)
