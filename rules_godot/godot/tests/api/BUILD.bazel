load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//lib:collections.bzl", "collections")
load("@rules_python//python:defs.bzl", "py_test")
load(
    ":modules.bzl",
    "CROSS_REPOSITORY_MODULES",
    "PUBLIC_APIS",
    "PUBLIC_TARGETS",
    "SUPPORT_MODULES",
)
load(":rules.bzl", "DOCS", "DOCS_DEPS", "api_reference")

package(default_visibility = ["//visibility:private"])

_MODULES = PUBLIC_APIS.keys() + CROSS_REPOSITORY_MODULES.keys() + SUPPORT_MODULES

# The bzl_library of each classified module, which Gazelle generates beside it and names after
# it (//tools/gazelle at the repository's root).
_LIBRARIES = [module.removesuffix(".bzl") for module in _MODULES]

# The BUILD files of the packages of the classified modules.
_BUILD_FILES = collections.uniq([module.partition(":")[0] + ":BUILD.bazel" for module in _MODULES])

# Every Starlark module of the ruleset outside its tests, with the libraries of its loads.
bzl_library(
    name = "sources",
    visibility = ["//godot/tests:__subpackages__"],
    deps = _LIBRARIES,
)

api_reference(
    name = "bcr_docs",
    apis = PUBLIC_APIS,
)

# The libraries of the ruleset's Starlark modules that the inventory's test can find: those
# beside a classified module and those a classified module loads. A module in a new package
# that no classified module loads escapes it (rules_godot/docs/internal/api-reference.md).
genquery(
    name = "libraries",
    expression = "kind(bzl_library, siblings(set(%s)) + deps(set(%s)))" % (
        " ".join(_BUILD_FILES),
        " ".join(_LIBRARIES),
    ),
    opts = ["--output=xml"],
    scope = _BUILD_FILES + _LIBRARIES,
)

# The packages whose public rules are consumer interfaces, none of private or tests: those of
# the classified modules and of the documented public targets. A public rule in a package of
# neither escapes the inventory's test (rules_godot/docs/internal/api-reference.md).
_API_BUILD_FILES = [
    label
    for label in collections.uniq(_BUILD_FILES + [
        target.partition(":")[0] + ":BUILD.bazel"
        for target in PUBLIC_TARGETS
    ])
    if not [part for part in label.partition(":")[0].split("/") if part in ("private", "tests")]
]

# The public rules of the API packages, which PUBLIC_TARGETS documents; the modules' libraries
# are no build targets of their own.
genquery(
    name = "public_rules",
    expression = (
        'attr(visibility, "//visibility:public", kind(rule, siblings(set(%s))))' +
        " except kind(bzl_library, siblings(set(%s)))"
    ) % (
        " ".join(_API_BUILD_FILES),
        " ".join(_API_BUILD_FILES),
    ),
    scope = _API_BUILD_FILES,
)

# Every module has its role, and the public rules are the documented public targets.
py_test(
    name = "inventory_test",
    size = "small",
    srcs = [DOCS + "api_docs.py"],
    args = [
        "$(rootpath :modules.bzl)",
        "$(rootpath :libraries)",
        "$(rootpath :public_rules)",
    ],
    data = [
        ":libraries",
        ":modules.bzl",
        ":public_rules",
        ":sources",
    ],
    main = DOCS + "api_docs.py",
    deps = DOCS_DEPS,
)

py_test(
    name = "bcr_metadata_test",
    size = "small",
    srcs = [DOCS + "bcr_metadata_test.py"],
    args = [
        "$(rootpath :modules.bzl)",
        "$(rootpaths :bcr_docs)",
    ],
    data = [
        ":bcr_docs",
        ":modules.bzl",
    ],
    main = DOCS + "bcr_metadata_test.py",
    deps = DOCS_DEPS,
)
