load("@bazel_skylib//rules:build_test.bzl", "build_test")

# The registry's documentation metadata builds, which the release workflow archives
# (rules_godot/BUILD.bazel); the tests' --build_tests_only would leave it out otherwise.
build_test(
    name = "bcr_docs_test",
    size = "small",
    targets = ["//:bcr_docs"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
