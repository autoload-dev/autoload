"""
godot_extension_library: native code linked into the one file Godot loads on the target
platform, and the provider that hands it and its entry symbol to godot_extension.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//godot/private:macros.bzl", "CALLER_PACKAGE")
load(":ios_framework.bzl", "ios_framework")

visibility(["//godot/extension", "//godot/extension/private"])

GodotExtensionLibraryInfo = provider(
    doc = "An extension library that godot_extension_library linked, as one configuration has it.",
    fields = {
        "entry_symbol": "string: the GDExtension entry symbol, the only symbol the library exports",
        "library": "Target: the shared library, framework import or archive of this configuration",
    },
)

# Attributes every rule has, which reach each target the macro declares.
_RULE_ATTRS = ["compatible_with", "deprecation", "exec_compatible_with", "exec_properties", "features", "restricted_to", "toolchains"]

def _extension_library_rule_impl(ctx):
    library = ctx.attr.library
    return [
        DefaultInfo(files = library[DefaultInfo].files, runfiles = library[DefaultInfo].default_runfiles),
        GodotExtensionLibraryInfo(entry_symbol = ctx.attr.entry_symbol, library = library),
    ]

_extension_library = rule(
    doc = "The extension library of the configuration's operating system, with its entry symbol.",
    implementation = _extension_library_rule_impl,
    attrs = {
        "library": attr.label(doc = "The linked library of this configuration.", mandatory = True),
        "entry_symbol": attr.string(doc = "The library's GDExtension entry symbol.", mandatory = True),
    },
)

def _require_c_identifier(entry_symbol):
    if not entry_symbol or entry_symbol[0].isdigit() or not entry_symbol.replace("_", "a").isalnum():
        fail("entry_symbol must be a C identifier; got %r" % entry_symbol)

def _keep_entry_source(name, entry_symbol, generated):
    """
    Declare a C source that references the entry symbol, which nothing else does.

    Linked whole, it pulls the object that defines the entry symbol out of the code's
    archives into every link: the shared library's and, on iOS, the application's.
    """
    keep = name + ".keep_entry"
    write_file(
        name = keep,
        out = keep + ".c",
        content = [
            "// Generated by godot_extension_library: keeps the GDExtension entry symbol linked.",
            "extern unsigned char %s(void *, void *, void *);" % entry_symbol,
            "__attribute__((used)) static unsigned char (*const rules_godot_entry)(void *, void *, void *) = %s;" % entry_symbol,
            "",
        ],
        **generated
    )
    return keep

def _shared_library(name, archive, library_name, entry_symbol, generated, link_attrs):
    """
    Declare the shared library linked from archive, which exports only the entry symbol.

    Returns:
        The name of the shared library target.
    """

    # A cc_binary names its output after the target. The part after the slash names the
    # delivered file, while the target stays in the macro's namespace.
    shared = name + ".shared/lib" + library_name + ".so"

    # The library exports only its entry symbol, as godot-cpp's own build does. Each
    # extension links its own godot-cpp, and an exported copy would be shared with the
    # other extensions in the process: dyld binds weak definitions across images.
    exports = name + ".exports"
    write_file(
        name = exports,
        out = exports + ".lds",
        content = ["{ global: %s; local: *; };" % entry_symbol],
        **generated
    )

    # Not cc_shared_library: it links only the static libraries its aspect reaches through
    # deps and drops others, such as the Objective-C targets of rules_swift_package_manager
    # behind their minimum-OS transition. Shared dependencies load from beside the extension
    # library, where the extension places them, as vendors' libraries expect (@loader_path,
    # $ORIGIN).
    apple_exports = ["-Wl,-exported_symbol,_" + entry_symbol]
    cc_binary(
        name = shared,
        deps = [":" + archive],
        linkshared = True,
        additional_linker_inputs = select({
            Label("@platforms//os:macos"): [],
            Label("@platforms//os:ios"): [],
            "//conditions:default": [":" + exports],
        }),
        linkopts = select({
            Label("@platforms//os:macos"): apple_exports + ["-Wl,-rpath,@loader_path"],
            # The binary of a framework in the application's Frameworks directory, beside
            # the frameworks it loads. The framework rewrites its install name, which
            # needs header room for a longer one.
            Label("@platforms//os:ios"): apple_exports + [
                "-Wl,-rpath,@executable_path/Frameworks",
                "-Wl,-rpath,@loader_path/..",
                "-Wl,-headerpad_max_install_names",
            ],
            "//conditions:default": [
                "-Wl,-rpath,$$ORIGIN",
                "-Wl,--version-script,$(execpath :%s)" % exports,
            ],
        }),
        **(generated | link_attrs)
    )
    return shared

def _godot_extension_library_impl(
        name,
        visibility,
        deps,
        entry_symbol,
        library_name,
        linkopts,
        linkstatic,
        ios_linkage,
        ios_bundle_id,
        tags,
        **kwargs):
    _require_c_identifier(entry_symbol)
    library_name = library_name or name
    tags = tags or []

    # Unset attributes stay unset on the declared targets.
    kwargs = {key: value for key, value in kwargs.items() if value != None}
    generated = {key: kwargs[key] for key in ["testonly", "target_compatible_with"] if key in kwargs} | {
        "visibility": CALLER_PACKAGE,
        "tags": tags + ["manual"],
    }
    rule_attrs = {key: kwargs[key] for key in _RULE_ATTRS if key in kwargs}
    keep = _keep_entry_source(name, entry_symbol, generated)

    # The code and the entry symbol's reference, which every link takes whole. On iOS with
    # static linkage it is the archive the application links.
    archive = name + ".archive"
    cc_library(
        name = archive,
        srcs = [":" + keep],
        deps = deps,
        linkopts = linkopts,
        alwayslink = True,
        linkstatic = True,
        **(generated | rule_attrs)
    )
    shared = _shared_library(name, archive, library_name, entry_symbol, generated, rule_attrs | {"linkstatic": linkstatic})
    ios_library = ios_framework(name, shared, library_name, ios_bundle_id, generated) if ios_linkage == "framework" else archive
    _extension_library(
        name = name,
        library = select({
            Label("@platforms//os:ios"): ":" + ios_library,
            "//conditions:default": ":" + shared,
        }),
        entry_symbol = entry_symbol,
        visibility = visibility,
        tags = tags,
        **{key: kwargs[key] for key in ["testonly", "target_compatible_with"] + _RULE_ATTRS if key in kwargs}
    )

godot_extension_library = macro(
    doc = """
    Link native code into the extension library Godot loads on the target platform.

    The library links what deps provide into one file, exports only the entry symbol, so
    extensions in one process never run each other's godot-cpp, and finds its shared
    dependencies beside it. It passes the entry symbol on, so a godot_extension of it
    names none.

    | Operating system | What it produces |
    | --- | --- |
    | Linux, Android | a shared library, `lib<library_name>.so` |
    | macOS | a dynamic library, `lib<library_name>.so` |
    | iOS | a dynamic framework, `<library_name>.framework`, or with `ios_linkage = "static"` the archive the application links |

    Every link takes the code whole, so objects that nothing references, such as static
    registrations, stay in it. Creates the named target, which provides the library of
    the configuration, and the private targets `<name>.archive`, the code with a
    reference to the entry symbol, `<name>.shared/lib<library_name>.so`, the shared
    library, and on iOS `<name>.ios_framework`, the framework import.

    Example:
    ```starlark
    cc_library(
        name = "paths",
        srcs = ["register_types.cc"],
        deps = ["@godot_cpp//:godot_cpp"],
    )

    godot_extension_library(
        name = "paths_library",
        deps = [":paths"],
        entry_symbol = "platform_paths_init",
    )
    ```

    See [extensions](../../gdextension.md).
    """,
    implementation = _godot_extension_library_impl,
    inherit_attrs = "common",
    attrs = {
        "deps": attr.label_list(
            doc = """
            The native code, compiled against the GDExtension API: rules_cc dependencies
            or any target that provides CcInfo. Shared libraries among them are runtime
            dependencies placed beside the extension library, and iOS applications embed
            the dynamic frameworks they link, transitive ones included.
            """,
            mandatory = True,
        ),
        "entry_symbol": attr.string(
            doc = "The GDExtension entry function that deps define, the only symbol the library exports.",
            mandatory = True,
            configurable = False,
        ),
        "library_name": attr.string(
            doc = """
            The library's name in its file names, as lib<library_name>.so and
            <library_name>.framework; the target's name by default.
            """,
            configurable = False,
        ),
        "linkopts": attr.string_list(doc = "Linker options of the library, and on iOS of the application."),
        "linkstatic": attr.bool(
            doc = """
            Whether the shared library links its C++ dependencies statically, as cc_binary's;
            True by default, so the library needs no shared library of its dependencies.
            """,
            default = True,
        ),
        "ios_linkage": attr.string(
            doc = """
            How iOS applications take the library: "framework", the default, embeds a
            dynamic framework with its own godot-cpp; "static" links the archive into the
            executable, where all static extensions share one godot-cpp and its main loop
            callbacks.
            """,
            default = "framework",
            values = ["framework", "static"],
            configurable = False,
        ),
        "ios_bundle_id": attr.string(
            doc = "CFBundleIdentifier of the iOS framework; empty derives one from the label and library_name.",
            configurable = False,
        ),
    },
)
