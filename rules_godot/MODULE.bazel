# ==== Maven ===================================================================

# Godot's Gradle declarations for the app template and the Android shell library
# (platform/android/java/app/config.gradle, app/build.gradle, lib/build.gradle), with the
# modules whose labels the shell library's aar_import names directly. rules_godot
# contributes them to the consumer's shared maven installation, where they are floors: the
# consumer's resolution may select higher versions. Resolved alone, they are Godot's Maven
# graph, the minimums every Android application is checked against.
GODOT_ANDROID_ARTIFACTS = [
    "androidx.annotation:annotation-jvm:1.8.1",
    "androidx.core:core-splashscreen:1.0.1",
    "androidx.documentfile:documentfile:1.1.0",
    "androidx.fragment:fragment:1.8.6",
    "org.jetbrains:annotations:13.0",
    "org.jetbrains.kotlin:kotlin-stdlib:2.1.21",
]

# Maven Central and Google's Maven, which hold every module of Godot's graph.
GODOT_ANDROID_REPOSITORIES = [
    "https://repo.maven.apache.org/maven2",
    "https://dl.google.com/dl/android/maven2",
]

# The shared installation also serves the build tools, whose protobuf libraries bring Guava;
# with Guava in the graph, highest-wins selects Guava's empty listenablefuture placeholder,
# which leaves ListenableFuture undefined in every application that does not package Guava.
# Godot's own graph selects 1.0. A consumer's root request decides over this one.
GODOT_LISTENABLEFUTURE_VERSION = "1.0"

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = GODOT_ANDROID_ARTIFACTS,
    known_contributing_modules = ["protobuf"],
    repositories = GODOT_ANDROID_REPOSITORIES,
    resolver = "gradle",
    use_starlark_android_rules = True,
)
maven.artifact(
    name = "maven",
    artifact = "listenablefuture",
    force_version = True,
    group = "com.google.guava",
    version = GODOT_LISTENABLEFUTURE_VERSION,
)
use_repo(maven, "maven")

maven_development = use_extension(
    "@rules_jvm_external//:extensions.bzl",
    "maven",
    dev_dependency = True,
)

# The pin of the shared installation, only where this module is the root: consumers pin their
# own, and a second dependency's lock file beside protobuf's fails the extension. The root's
# last install decides the settings, so keep them in sync with the install above; artifacts
# add up, so it names none.
maven_development.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    known_contributing_modules = ["protobuf"],
    lock_file = "//third_party/maven:maven_install.json",
    repositories = GODOT_ANDROID_REPOSITORIES,
    resolver = "gradle",
    use_starlark_android_rules = True,
)

# Godot's Maven graph: what Gradle resolves for rules_godot's contribution alone. Its lock is
# committed beside the template activities and read by each Android application's minimum
# check; repin with `REPIN=1 bazel run @godot_android_maven_graph//:pin`.
maven_development.install(
    name = "godot_android_maven_graph",
    artifacts = GODOT_ANDROID_ARTIFACTS,
    lock_file = "//godot/private/engine:android/maven_graph_install.json",
    repositories = GODOT_ANDROID_REPOSITORIES,
    resolver = "gradle",
)
maven_development.artifact(
    name = "godot_android_maven_graph",
    artifact = "listenablefuture",
    force_version = True,
    group = "com.google.guava",
    version = GODOT_LISTENABLEFUTURE_VERSION,
)
use_repo(maven_development, "godot_android_maven_graph")

# rules_android and bazel_worker_java resolve their own tools from Maven without a lock
# file, so every output base resolves and downloads all of them eagerly. As the root
# module, the ruleset pins those repositories like its consumer modules do: pinned
# artifacts are fetched lazily through Bazel's shared repository cache.
maven_development.install(
    name = "rules_android_maven",
    known_contributing_modules = ["rules_android"],
    lock_file = "//third_party/maven:rules_android_maven_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolver = "maven",
)
maven_development.install(
    name = "android_ide_common_30_1_3",
    known_contributing_modules = ["rules_android"],
    lock_file = "//third_party/maven:android_ide_common_30_1_3_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolver = "maven",
)
maven_development.install(
    name = "bazel_worker_maven",
    known_contributing_modules = ["bazel_worker_java"],
    lock_file = "//third_party/maven:bazel_worker_maven_install.json",
    repositories = [
        "https://maven-central.storage-download.googleapis.com/maven2",
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    resolver = "maven",
)

# ==== Starlark libraries ======================================================

# The bzl_library targets that Gazelle generates (tools/gazelle at the repository's root)
# depend on the Starlark libraries of the modules whose files they load. rules_android 0.8.1
# exports its API files but keeps the transitive Starlark library private; rules_android_ndk
# 0.1.5 exports no files. Each patch changes BUILD visibility only; an override applies only
# where this module is the root.
single_version_override(
    module_name = "rules_android",
    patch_strip = 1,
    patches = ["//third_party/rules_android:doc_visibility.patch"],
)

single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//third_party/rules_android_ndk:doc_visibility.patch"],
)

# ==== Test fixtures ===========================================================

repository_fixtures = use_extension(
    "//godot/engine/private/tests/split_templates:fixtures.bzl",
