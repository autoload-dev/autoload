# Sections: Toolchains, Godot engines, Maven, Starlark libraries, Test fixtures, BuildBuddy.

module(
    name = "autoload_rules_godot",
    version = "0.1.1",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

# Builds Godot's Java/Kotlin Android shell library from source; no Kotlin toolchain is
# registered.
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_swift", version = "4.3.0")
bazel_dep(name = "apple_support", version = "2.12.0")

# The version Bazel 10's bazel_tools requires, so Bazel 9 and 10 resolve the same graph.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Build settings and file helpers of the ruleset's rules.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The Starlark unit and analysis tests of the ruleset's tests packages.
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

# The repository's own tooling at its root, whose linters `--config=check` and `aspect lint`
# apply here; consumers never see it.
bazel_dep(name = "autoload_dev", dev_dependency = True)
local_path_override(
    module_name = "autoload_dev",
    path = "..",
)

# ==== Toolchains ==============================================================

# Repositories that godot_android_toolchains' generated SDK and toolchain repositories
# name: this host's SDK, whose API level setting the Linux SDK follows, and rules_java's tools,
# which rules_android's SDK helper names.
android_sdk = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
use_repo(android_sdk, "androidsdk")

# The SDK of //godot/platforms/private/tests, at the API level and build tools the
# repository provisions (tools/android/sdk.json); a dependency's tags would apply to consumers without their own.
android_sdk_development = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)
android_sdk_development.configure(
    api_level = 35,
    build_tools_version = "35.0.0",
)

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(java_toolchains, "remote_java_tools")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.14")

# The host interpreter that configures source recipes during repository fetching.
use_repo(python, "python_3_14_host")

# Python targets of this module import only packages that have an __init__.py of their own.
python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
python_config.explicit_init_py(default = True)

# The Android toolchains of //godot/platforms/private/tests.
godot_android_toolchains = use_extension(
    "//godot:extensions.bzl",
    "godot_android_toolchains",
    dev_dependency = True,
)
godot_android_toolchains.configure(ndk_api_level = 24)
use_repo(godot_android_toolchains, "android_toolchains")

# Registered here rather than per test with --extra_toolchains, which survives the exec
# transition and would split the tests' tools into exec configurations of their own. The
# root module's registrations precede rules_android's, and the hub's precede the host SDK's,
# as the repository's root module registers them too.
register_toolchains(
    "@android_toolchains//:all",
    "@androidsdk//:all",
    dev_dependency = True,
)

# ==== Godot engines ===========================================================

# Every engine a module registers with godot_engines has its toolchains in one repository,
# which this module registers, so no module registers an engine's toolchains itself. A root
# module's own registrations and --extra_toolchains come first.
godot_engine_toolchains = use_extension("//godot:extensions.bzl", "godot_engines")
use_repo(godot_engine_toolchains, "godot_engines_toolchains")

register_toolchains("@godot_engines_toolchains//:all")

# The ruleset's own development engines; consumers register their own.
godot_engines = use_extension("//godot:extensions.bzl", "godot_engines", dev_dependency = True)

# Godot's official 4.7.2, which targets that name no engine take.
godot_engines.engine(
    name = "godot",
    default = True,
    version = "4.7.2",
)

# The next-minor engine of //godot/extension/tests/compatibility and
# //godot/platforms/private/tests/engine_probe, which select it with a test transition on
# --//godot:engine=beta. Registered under that engine name rather than per test with
# --extra_toolchains, which survives the exec transition and would split the tests' tools
# into exec configurations of their own; only builds that name the engine fetch its editor
# and templates. The prerelease shell AAR is a GitHub release asset, not a catalogued Maven
# artifact.
godot_engines.engine(
    name = "beta",
    version = "4.8.0-beta1",
)
godot_engines.binaries(
    android_shell_integrity = "sha256-G1KpV92jFIn4OirzO17zy2euXFLyE40BSATgYs9MI5Y=",
    android_shell_urls = ["https://github.com/godotengine/godot-builds/releases/download/4.8-beta1/godot-lib.4.8.beta1.template_release.aar"],
    engine = "beta",
)
use_repo(
    godot_engines,
    "beta",
    "beta_templates_ios",
    "godot",
    "godot_editor_linux_arm64",
    "godot_editor_linux_x86_64",
    "godot_editor_macos",
)

