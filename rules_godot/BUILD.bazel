package(default_visibility = ["//visibility:public"])

# Gazelle (`bazel run //tools/gazelle:update` at the repository's root) generates a
# bzl_library per Starlark module of the ruleset's packages, named after its file; the
# white-box tests' modules stay out (tools/gazelle/BUILD.bazel).
# It names the library of an external load after the loaded file; these loads resolve to the
# library that the module behind them declares instead.
# gazelle:resolve starlark @autoload_rules_godot//godot:defs.bzl //godot:defs
# gazelle:resolve starlark @autoload_rules_godot//godot:providers.bzl //godot:providers
# gazelle:resolve starlark @platforms//host:constraints.bzl @platforms//host:constraints_lib
# gazelle:resolve starlark @rules_android//providers:providers.bzl @rules_android//rules:bzl
# gazelle:resolve starlark @rules_android//rules:android_neverlink_aspect.bzl @rules_android//rules:bzl
# gazelle:resolve starlark @rules_android//rules:android_split_transition.bzl @rules_android//rules:bzl
# gazelle:resolve starlark @rules_android//rules:dex_desugar_aspect.bzl @rules_android//rules:bzl
# gazelle:resolve starlark @rules_android//rules:rules.bzl @rules_android//rules:bzl
# gazelle:resolve starlark @rules_android_ndk//:rules.bzl @rules_android_ndk//:rules.bzl
# gazelle:resolve starlark @rules_apple//apple/internal/aspects:resource_aspect.bzl @rules_apple//apple:aspects
# gazelle:resolve starlark @rules_apple//apple/internal/aspects:swift_usage_aspect.bzl @rules_apple//apple:aspects
# gazelle:resolve starlark @rules_java//java/common:java_common.bzl @rules_java//java/common:common
# gazelle:resolve starlark @rules_java//java/common:java_info.bzl @rules_java//java/common:common
# gazelle:resolve starlark @rules_java//java/common:proguard_spec_info.bzl @rules_java//java/common:proguard_spec_info_bzl

# The extractions of the public entrypoints, by name: the Stardoc metadata the Bazel Central
# Registry renders as the API reference, which the release workflow archives
# (.github/workflows/release_prep.sh). Each entrypoint exports exactly its public symbols, so
# the extraction takes all of them.
_BCR_DOCS = {
    "bcr_docs_godot_app": "//godot:app.bzl",
    "bcr_docs_godot_defs": "//godot:defs.bzl",
    "bcr_docs_godot_engine_defs": "//godot/engine:defs.bzl",
    "bcr_docs_godot_extension_defs": "//godot/extension:defs.bzl",
    "bcr_docs_godot_extension_repositories": "//godot/extension:repositories.bzl",
    "bcr_docs_godot_extensions": "//godot:extensions.bzl",
    "bcr_docs_godot_platforms_defs": "//godot/platforms:defs.bzl",
    "bcr_docs_godot_providers": "//godot:providers.bzl",
    "bcr_docs_godot_testing_adapter": "//godot/testing:adapter.bzl",
}

[
    starlark_doc_extract(
        name = name,
        src = module,
        render_main_repo_name = True,
        # Gazelle's bzl_library beside the module, named after its file, and the modules
        # its libraries miss: those that @bazel_tools's http.bzl loads, which has no
        # bzl_library, and rules_apple's internal aspects, whose libraries are private to
        # rules_apple and which its public library reaches. Drop each once its upstream
        # module has a public bzl_library that Gazelle can resolve.
        deps = [
            module.removesuffix(".bzl"),
            "@bazel_tools//tools/build_defs/repo:cache.bzl",
            "@bazel_tools//tools/build_defs/repo:utils.bzl",
            "@rules_apple//apple",
        ],
    )
    for name, module in _BCR_DOCS.items()
]

filegroup(
    name = "bcr_docs",
    srcs = [":%s.binaryproto" % name for name in _BCR_DOCS],
)

# The module's declarations and Bazel settings with those of its registry test module, which
# the root module's setup checks read (tools/setup/checkout.py). bcr/ is ignored, so its files
# belong to this package.
filegroup(
    name = "module_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "MODULE.bazel",
        "bcr/smoke/.bazelversion",
        "bcr/smoke/MODULE.bazel",
        "//third_party/maven:android_ide_common_30_1_3_install.json",
        "//third_party/maven:bazel_worker_maven_install.json",
        "//third_party/maven:rules_android_maven_install.json",
    ],
)
