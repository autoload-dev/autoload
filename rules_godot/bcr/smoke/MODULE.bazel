"""The Bazel Central Registry's test module of rules_godot: a consumer that exports a pack."""

module(name = "rules_godot_bcr_smoke")

bazel_dep(name = "autoload_rules_godot", version = "0.0.0")
local_path_override(
    module_name = "autoload_rules_godot",
    path = "../..",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")

godot_engines = use_extension("@autoload_rules_godot//godot:extensions.bzl", "godot_engines")
godot_engines.engine(
    name = "godot",
    default = True,
    version = "4.7.2",
)
