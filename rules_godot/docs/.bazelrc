# The documentation module's settings.
build --incompatible_strict_action_env

import %workspace%/../../shared.bazelrc

# Opt in to BuildBuddy with --config=buildbuddy, or --config=buildbuddy-linux to test remotely.
import %workspace%/../../buildbuddy.bazelrc
# Bazel normalizes the command as a path; run the executable script by its relative path.
build:buildbuddy --workspace_status_command=../../buildbuddy_status.sh
# Tell this module's invocations apart in BuildBuddy's history and trends.
build:buildbuddy --build_metadata=TAGS=docs

# Personal settings for every module of this repository, such as `common --config=buildbuddy`,
# go in user.bazelrc at the repository root; git ignores it.
try-import %workspace%/../../user.bazelrc
