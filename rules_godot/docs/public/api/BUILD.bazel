load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_python//python:defs.bzl", "py_test")
load(
    ":modules.bzl",
    "CROSS_REPOSITORY_MODULES",
    "EXTERNAL_LOADS",
    "PUBLIC_APIS",
    "SUPPORT_MODULES",
)
load(":rules.bzl", "api_reference")

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "sources",
    srcs = PUBLIC_APIS.keys() + CROSS_REPOSITORY_MODULES.keys() + SUPPORT_MODULES,
    deps = EXTERNAL_LOADS,
)

api_reference(
    name = "bcr_docs",
    apis = PUBLIC_APIS,
)

py_test(
    name = "bcr_metadata_test",
    size = "small",
    srcs = ["//tools/docs:bcr_metadata_test.py"],
    args = [
        "$(rootpath :modules.bzl)",
        "$(rootpaths :bcr_docs)",
    ],
    data = [
        ":bcr_docs",
        ":modules.bzl",
    ],
    main = "//tools/docs:bcr_metadata_test.py",
    deps = [
        "//tools/docs:coverage_lib",
        "//tools/docs:inventory_lib",
        "//tools/docs:surface_lib",
    ],
)
