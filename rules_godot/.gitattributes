# Configuration for `git archive`, which builds the ruleset's release archive from this
# directory (.github/workflows/release_prep.sh). Development-only directories stay out of it;
# bcr/ stays in, because the Bazel Central Registry runs its test module (registry-test-module-in-bcr).
# docs/ holds the guides, which the repository shows; the registry renders the API
# documentation from the release's documentation archive.
docs export-ignore
# A link to the repository's Bazelisk wrapper, outside this directory.
tools/bazel export-ignore
# The ruleset's own tests at any depth: consumers cannot run them, since their development
# dependencies are not theirs (release-archives-without-tests, docs/internal/conventions.md).
tests export-ignore
# The registry test modules in bcr/ keep their tests: the registry runs them from the archive.
bcr/**/tests -export-ignore
