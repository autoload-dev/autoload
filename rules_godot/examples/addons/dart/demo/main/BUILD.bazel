load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//addons/dart/demo:__subpackages__"])

# The demo's Dart scripts: resources of the scene, and what //addons/dart/demo:dart compiles.
SCRIPTS = [
    "counter.dart",
    "dart_demo.dart",
    "greeting.dart",
    "spinner.dart",
]

filegroup(
    name = "scripts",
    srcs = SCRIPTS,
)

godot_resources(
    name = "main",
    srcs = ["dart_demo.tscn"] + SCRIPTS + [script + ".uid" for script in SCRIPTS],
    prefix = "main",
    deps = ["//addons/dart/demo:dart"],
)
