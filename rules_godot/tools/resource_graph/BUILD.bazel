load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//godot/private:visibility.bzl", "NOT_ACTUALLY_PUBLIC")

# A project's resource graph: the scanner, the graph it builds, queries over the graph and
# their command line. Pack selection reads the graph and its queries.
package(default_visibility = ["//tools:__subpackages__"])

# The errors and warnings that the graph and pack selection report.
py_library(
    name = "diagnostics_lib",
    srcs = ["diagnostics.py"],
)

# The repository's Gazelle extension for Godot (tools/gazelle in the root module) imports the
# resource scanner.
py_library(
    name = "scan_lib",
    srcs = ["scan.py"],
    visibility = NOT_ACTUALLY_PUBLIC,
    deps = [
        ":diagnostics_lib",
        "//tools/project:statements_lib",
        "//tools/resources:text_lib",
    ],
)

py_library(
    name = "graph_lib",
    srcs = ["graph.py"],
    deps = [
        ":diagnostics_lib",
        ":scan_lib",
        "//tools/resources:text_lib",
    ],
)

# Queries over a graph, for maintainers (query.py); no build action reads them.
py_library(
    name = "query_lib",
    srcs = ["query.py"],
    deps = [
        ":graph_lib",
        "//tools/resources:text_lib",
    ],
)

# The command line that scans, checks and queries graphs. It is a library of its own, so
# other tools import the graph without it.
py_library(
    name = "command_lib",
    srcs = ["command.py"],
    deps = [
        ":diagnostics_lib",
        ":graph_lib",
        ":query_lib",
    ],
)

# The rules of godot/private run it through their private _resource_graph attributes;
# maintainers run its queries with bazel run.
py_binary(
    name = "resource_graph",
    srcs = ["command.py"],
    main = "command.py",
    visibility = ["//godot/private:__pkg__"],
    deps = [":command_lib"],
)

# Selects a pack's resources from the graph and checks that their references exist. It is a
# tool of its own, so changing it reruns pack selections but no graph scans.
py_library(
    name = "selection_lib",
    srcs = ["selection.py"],
    deps = [
        ":diagnostics_lib",
        ":graph_lib",
        ":query_lib",
        "//tools/resources:files_lib",
        "//tools/resources:text_lib",
    ],
)

py_binary(
    name = "pack_selection",
    srcs = ["selection.py"],
    main = "selection.py",
    visibility = ["//godot/private:__pkg__"],
    deps = [":selection_lib"],
)
