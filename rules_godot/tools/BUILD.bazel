load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# The build tools serve the ruleset's own rules only. A rule's private attribute is checked
# against the package that defines the rule, so no consumer needs to see a tool.
package(default_visibility = ["//tools:ruleset"])

# The ruleset's own packages, the default visibility of every tool package.
package_group(
    name = "ruleset",
    packages = [
        "//godot/...",
        "//tools/...",
    ],
)

py_library(
    name = "digest_lib",
    srcs = ["digest.py"],
)

py_library(
    name = "template_lib",
    srcs = ["template.py"],
)

# Output paths that manifests name as path mapping stages them.
py_library(
    name = "mapped_paths_lib",
    srcs = ["mapped_paths.py"],
)

# Project actions (imports, initialization, probes) and pack exports are separate
# tools on shared staging, so a change to one does not rerun the other's actions.
py_library(
    name = "godot_staging_lib",
    srcs = ["godot_staging.py"],
    deps = [
        ":mapped_paths_lib",
        "//tools/pack:pck_lib",
        "//tools/project:config_lib",
        "//tools/resources:files_lib",
        "//tools/resources:node_ids_lib",
        "//tools/resources:text_lib",
        "//tools/resources:uids_lib",
    ],
)

# The action plugin that records each editor action's result, which the content validation
# carries as data beside the tools of this package that run editor actions.
filegroup(
    name = "action_plugin",
    srcs = glob(["action/*"]),
    visibility = ["//tools/validation:__pkg__"],
)

py_library(
    name = "godot_actions_lib",
    srcs = ["godot_actions.py"],
    # The action plugin that records each editor action's result; data of the
    # two tools that run editor actions only, so editing it reruns only those.
    data = glob(["action/*"]),
    deps = [
        ":godot_staging_lib",
        "//tools/project:config_lib",
        "//tools/resources:files_lib",
    ],
)

py_binary(
    name = "godot_actions",
    srcs = ["godot_actions.py"],
    deps = [":godot_actions_lib"],
)

# Derives and syncs a runtime profile: a tool of its own, with the action plugin it joins and
# its own profile plugin, so a change to it reruns only profile derivations.
py_library(
    name = "runtime_profile_lib",
    srcs = ["runtime_profile.py"],
    data = glob([
        "action/*",
        "profile/*",
    ]),
    deps = [
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
    ],
)

py_binary(
    name = "runtime_profile",
    srcs = ["runtime_profile.py"],
    deps = [":runtime_profile_lib"],
)

py_library(
    name = "godot_export_lib",
    srcs = ["godot_export.py"],
    data = glob(["action/*"]) + [
        "adaptive_icon.xml.tpl",
        "export_presets.cfg.tpl",
    ],
    deps = [
        ":godot_staging_lib",
        ":template_lib",
        "//tools/pack:contents_lib",
        "//tools/pack:pck_lib",
        "//tools/project:config_lib",
    ],
)

py_binary(
    name = "godot_export",
    srcs = ["godot_export.py"],
    deps = [":godot_export_lib"],
)

py_library(
    name = "godot_run_lib",
    srcs = ["godot_run.py"],
    deps = [
        ":godot_staging_lib",
        "//tools/pack:pck_lib",
        "//tools/project:config_lib",
        "//tools/project:statements_lib",
        "@rules_python//python/runfiles",
    ],
)

exports_files(
    ["run/errors.gd"],
    visibility = ["//tools/tests:__pkg__"],
)

# The run logger is data of the runner of runs and tests only, not of the
# editor view and metadata sync that share godot_run_lib.
py_binary(
    name = "godot_run",
    srcs = ["godot_run.py"],
    data = ["run/errors.gd"],
    deps = [":godot_run_lib"],
)

py_library(
    name = "godot_editor_lib",
    srcs = ["godot_editor.py"],
    data = ["editor_view.gitignore.tpl"],
    deps = [
        ":godot_metadata_sync_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        "//tools/project:config_lib",
        "//tools/resources:files_lib",
    ],
)

py_binary(
    name = "godot_editor",
    srcs = ["godot_editor.py"],
    data = ["editor_view.gitignore.tpl"],
    deps = [
        ":godot_metadata_sync_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        "//tools/project:config_lib",
        "//tools/resources:files_lib",
    ],
)

py_library(
    name = "godot_sync_lib",
    srcs = ["godot_sync.py"],
    deps = [":godot_run_lib"],
)

py_library(
    name = "godot_metadata_sync_lib",
    srcs = ["godot_metadata_sync.py"],
    deps = [
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
        ":metadata_index_lib",
        "//tools/resources:files_lib",
        "//tools/resources:node_ids_lib",
        "//tools/resources:uids_lib",
    ],
)

py_library(
    name = "metadata_index_lib",
    srcs = ["metadata_index.py"],
    deps = [
        ":godot_staging_lib",
        "//tools/resources:files_lib",
        "//tools/resources:node_ids_lib",
        "//tools/resources:uids_lib",
    ],
)

py_binary(
    name = "metadata_index",
    srcs = ["metadata_index.py"],
    deps = [":metadata_index_lib"],
)

py_binary(
    name = "godot_metadata_sync",
    srcs = ["godot_metadata_sync.py"],
    deps = [
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
        ":metadata_index_lib",
        "//tools/resources:files_lib",
        "//tools/resources:node_ids_lib",
        "//tools/resources:uids_lib",
    ],
)
