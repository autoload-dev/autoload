load("@rules_python//python:defs.bzl", "py_library")

# The build tools serve the ruleset's own rules only. A rule's private attribute is checked
# against the package that defines the rule, so no consumer needs to see a tool.
package(default_visibility = ["//tools:ruleset"])

# The ruleset's own packages, the default visibility of every tool package.
package_group(
    name = "ruleset",
    packages = [
        "//godot/...",
        "//tools/...",
    ],
)

py_library(
    name = "digest_lib",
    srcs = ["digest.py"],
)

py_library(
    name = "template_lib",
    srcs = ["template.py"],
)
