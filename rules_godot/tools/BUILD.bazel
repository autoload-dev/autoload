load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# The ruleset's own packages. Tool libraries are visible to them only.
package_group(
    name = "ruleset",
    packages = [
        "//godot/...",
        "//tools/...",
    ],
)

# The statements of Godot's configuration files, which the graph and several tools read
# without the composition of settings on top of them.
py_library(
    name = "project_statements_lib",
    srcs = ["project_statements.py"],
)

# Godot settings composed per purpose without evaluating expressions, which most tools read.
py_library(
    name = "project_config_lib",
    srcs = ["project_config.py"],
    deps = [":project_statements_lib"],
)

# Composes a purpose's project.godot and checks a project's settings: the command line over
# the library, so a change to it reruns only its own actions.
py_library(
    name = "project_config_command_lib",
    srcs = ["project_config_command.py"],
    deps = [":project_config_lib"],
)

py_binary(
    name = "project_config",
    srcs = ["project_config_command.py"],
    main = "project_config_command.py",
    deps = [":project_config_command_lib"],
)

# What the build tools read from Godot's text resources. The graph builds on it in a module
# of its own, so a change to the graph reruns none of the actions of the tools that stage,
# validate, index or pack files.
py_library(
    name = "resource_text_lib",
    srcs = ["resource_text.py"],
)

py_library(
    name = "resource_graph_lib",
    srcs = ["resource_graph.py"],
    deps = [
        ":project_statements_lib",
        ":resource_text_lib",
    ],
)

# Queries over a graph, for maintainers (resource_graph_query.py); no build action reads them.
py_library(
    name = "resource_graph_query_lib",
    srcs = ["resource_graph_query.py"],
    deps = [
        ":resource_graph_lib",
        ":resource_text_lib",
    ],
)

# Scans, checks and queries graphs: the command line over the graph's libraries, so the
# scanner and reference detection stay a library that other tools import without it.
py_library(
    name = "resource_graph_command_lib",
    srcs = ["resource_graph_command.py"],
    deps = [
        ":resource_graph_lib",
        ":resource_graph_query_lib",
    ],
)

py_binary(
    name = "resource_graph",
    srcs = ["resource_graph_command.py"],
    main = "resource_graph_command.py",
    deps = [":resource_graph_command_lib"],
)

# Selects a pack's resources from the graph: a tool of its own, so a change to it reruns
# only selections, and a change to it alone no graph scans.
py_library(
    name = "pack_selection_lib",
    srcs = ["pack_selection.py"],
    deps = [
        ":godot_files_lib",
        ":resource_graph_lib",
        ":resource_graph_query_lib",
        ":resource_text_lib",
    ],
)

py_binary(
    name = "pack_selection",
    srcs = ["pack_selection.py"],
    deps = [":pack_selection_lib"],
)

py_library(
    name = "godot_files_lib",
    srcs = ["godot_files.py"],
    visibility = ["//tools:ruleset"],
)

py_library(
    name = "digest_lib",
    srcs = ["digest.py"],
)

py_library(
    name = "pck_lib",
    srcs = ["pck.py"],
    visibility = ["//tools:ruleset"],
)

py_library(
    name = "template_lib",
    srcs = ["template.py"],
)

# Output paths that manifests name as path mapping stages them.
py_library(
    name = "mapped_paths_lib",
    srcs = ["mapped_paths.py"],
    visibility = ["//tools:ruleset"],
)

# Project actions (imports, initialization, probes) and pack exports are separate
# tools on shared staging, so a change to one does not rerun the other's actions.
py_library(
    name = "godot_staging_lib",
    srcs = ["godot_staging.py"],
    visibility = ["//tools:ruleset"],
    deps = [
        ":godot_files_lib",
        ":mapped_paths_lib",
        ":node_ids_lib",
        ":pck_lib",
        ":project_config_lib",
        ":resource_text_lib",
        ":resource_uids_lib",
    ],
)

py_library(
    name = "godot_actions_lib",
    srcs = ["godot_actions.py"],
    # The action plugin that records each editor action's result; data of the
    # two tools that run editor actions only, so editing it reruns only those.
    data = glob(["action/*"]),
    deps = [
        ":godot_files_lib",
        ":godot_staging_lib",
        ":project_config_lib",
    ],
)

py_binary(
    name = "godot_actions",
    srcs = ["godot_actions.py"],
    deps = [":godot_actions_lib"],
)

# Derives and syncs a runtime profile: a tool of its own, with the action plugin it joins and
# its own profile plugin, so a change to it reruns only profile derivations.
py_library(
    name = "runtime_profile_lib",
    srcs = ["runtime_profile.py"],
    data = glob([
        "action/*",
        "profile/*",
    ]),
    deps = [
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
    ],
)

py_binary(
    name = "runtime_profile",
    srcs = ["runtime_profile.py"],
    deps = [":runtime_profile_lib"],
)

py_library(
    name = "class_fragment_lib",
    srcs = ["class_fragment.py"],
    visibility = ["//tools:ruleset"],
    deps = [
        ":mapped_paths_lib",
        ":resource_text_lib",
    ],
)

py_binary(
    name = "class_fragment",
    srcs = ["class_fragment.py"],
    deps = [
        ":mapped_paths_lib",
        ":resource_text_lib",
    ],
)

# What the validations of a unit's dependents read from it (#158): a tool of its own, so a
# change to it reruns only interfaces.
py_library(
    name = "unit_interface_lib",
    srcs = ["unit_interface.py"],
    visibility = ["//tools:ruleset"],
    deps = [
        ":class_fragment_lib",
        ":godot_files_lib",
        ":godot_staging_lib",
        ":mapped_paths_lib",
        ":resource_text_lib",
    ],
)

py_binary(
    name = "unit_interface",
    srcs = ["unit_interface.py"],
    deps = [":unit_interface_lib"],
)

# The per-unit content validation: a tool of its own, so a change to it reruns only
# validations.
py_library(
    name = "godot_validation_lib",
    srcs = ["godot_validation.py"],
    data = glob(["action/*"]) + ["validation/validate.gd"],
    deps = [
        ":class_fragment_lib",
        ":godot_staging_lib",
        ":project_config_lib",
        ":resource_text_lib",
        ":resource_uids_lib",
    ],
)

py_binary(
    name = "godot_validation",
    srcs = ["godot_validation.py"],
    deps = [":godot_validation_lib"],
)

py_library(
    name = "pack_contents_lib",
    srcs = ["pack_contents.py"],
    deps = [
        ":digest_lib",
        ":godot_files_lib",
    ],
)

py_library(
    name = "godot_export_lib",
    srcs = ["godot_export.py"],
    data = glob(["action/*"]) + [
        "adaptive_icon.xml.tpl",
        "export_presets.cfg.tpl",
    ],
    deps = [
        ":godot_staging_lib",
        ":pack_contents_lib",
        ":pck_lib",
        ":project_config_lib",
        ":template_lib",
    ],
)

py_binary(
    name = "godot_export",
    srcs = ["godot_export.py"],
    deps = [":godot_export_lib"],
)

# Writes a pack's PCK without Godot; a tool of its own, without the editor's action
# plugin, so a change to either tool reruns only its own actions.
py_library(
    name = "pack_writer_lib",
    srcs = ["pack_writer.py"],
    deps = [
        ":class_fragment_lib",
        ":godot_files_lib",
        ":godot_staging_lib",
        ":pack_contents_lib",
        ":pck_lib",
        ":resource_text_lib",
        ":resource_uids_lib",
    ],
)

py_binary(
    name = "pack_writer",
    srcs = ["pack_writer.py"],
    deps = [":pack_writer_lib"],
)

py_library(
    name = "godot_run_lib",
    srcs = ["godot_run.py"],
    deps = [
        ":godot_staging_lib",
        ":pck_lib",
        ":project_config_lib",
        ":project_statements_lib",
        "@rules_python//python/runfiles",
    ],
)

exports_files(
    ["run/errors.gd"],
    visibility = ["//tools/tests:__pkg__"],
)

# The run logger is data of the runner of runs and tests only, not of the
# editor view and metadata sync that share godot_run_lib.
py_binary(
    name = "godot_run",
    srcs = ["godot_run.py"],
    data = ["run/errors.gd"],
    deps = [":godot_run_lib"],
)

py_library(
    name = "godot_editor_lib",
    srcs = ["godot_editor.py"],
    data = ["editor_view.gitignore.tpl"],
    deps = [
        ":godot_files_lib",
        ":godot_metadata_sync_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        ":project_config_lib",
    ],
)

py_binary(
    name = "godot_editor",
    srcs = ["godot_editor.py"],
    data = ["editor_view.gitignore.tpl"],
    deps = [
        ":godot_files_lib",
        ":godot_metadata_sync_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        ":project_config_lib",
    ],
)

py_library(
    name = "godot_sync_lib",
    srcs = ["godot_sync.py"],
    deps = [":godot_run_lib"],
)

py_library(
    name = "godot_metadata_sync_lib",
    srcs = ["godot_metadata_sync.py"],
    deps = [
        ":godot_files_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
        ":metadata_index_lib",
        ":node_ids_lib",
        ":resource_uids_lib",
    ],
)

py_library(
    name = "node_ids_lib",
    srcs = ["node_ids.py"],
    deps = [":resource_text_lib"],
)

py_library(
    name = "metadata_index_lib",
    srcs = ["metadata_index.py"],
    deps = [
        ":godot_files_lib",
        ":godot_staging_lib",
        ":node_ids_lib",
        ":resource_uids_lib",
    ],
)

py_binary(
    name = "metadata_index",
    srcs = ["metadata_index.py"],
    deps = [":metadata_index_lib"],
)

py_library(
    name = "resource_uids_lib",
    srcs = ["resource_uids.py"],
    deps = [
        ":godot_files_lib",
        ":resource_text_lib",
    ],
)

py_binary(
    name = "godot_metadata_sync",
    srcs = ["godot_metadata_sync.py"],
    deps = [
        ":godot_files_lib",
        ":godot_run_lib",
        ":godot_staging_lib",
        ":godot_sync_lib",
        ":metadata_index_lib",
        ":node_ids_lib",
        ":resource_uids_lib",
    ],
)

py_library(
    name = "common_content_lib",
    srcs = ["common_content.py"],
    deps = [":project_statements_lib"],
)

py_binary(
    name = "common_content",
    srcs = ["common_content.py"],
    deps = [":project_statements_lib"],
)
