load("@rules_python//python:defs.bzl", "py_library")

# The launcher of bazel run on a godot_app. The host's python3 runs these sources
# directly, so they use only the standard library.
filegroup(
    name = "launch",
    srcs = glob(["launch*.py"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "launch_lib",
    srcs = glob(["launch*.py"]),
    imports = ["."],
    visibility = ["//tools/platforms/tests:__pkg__"],
)

exports_files(
    ["launch.py"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "launch.py",
        "launch_android.py",
        "launch_common.py",
        "launch_desktop.py",
        "launch_editor.py",
        "launch_ios.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
