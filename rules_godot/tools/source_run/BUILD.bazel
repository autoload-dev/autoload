load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Source runs: the runner that runs a declared project or PCK with isolated writable state
# for godot_run and godot_test, and the run logger it adds to every run.
package(default_visibility = ["//tools:__subpackages__"])

py_library(
    name = "run_lib",
    srcs = ["run.py"],
    deps = [
        "//tools/editor_action:process_lib",
        "//tools/inputs:manifest_lib",
        "//tools/inputs:originals_lib",
        "//tools/inputs:runfiles_lib",
        "//tools/pack:pck_lib",
        "//tools/project:config_lib",
        "//tools/project:statements_lib",
        "//tools/resources:text_lib",
        "//tools/staging:project_lib",
    ],
)

exports_files(
    ["errors.gd"],
    visibility = ["//tools/source_run/tests:__pkg__"],
)

# The runner of runs and tests, which the rules of godot/private start. The run logger is its
# data only.
py_binary(
    name = "source_run",
    srcs = ["run.py"],
    data = ["errors.gd"],
    main = "run.py",
    visibility = ["//godot/private:__pkg__"],
    deps = [":run_lib"],
)
