load("@rules_python//python:defs.bzl", "py_test")

package(default_testonly = True)

py_test(
    name = "editor_view_test",
    size = "small",
    srcs = ["editor_view_test.py"],
    deps = [
        "//tools:godot_editor_lib",
        "//tools:godot_metadata_sync_lib",
        "//tools/resources:node_ids_lib",
    ],
)

py_test(
    name = "execution_test",
    size = "small",
    srcs = ["execution_test.py"],
    data = ["//tools:run/errors.gd"],
    deps = [
        "//tools:godot_run_lib",
        "//tools/pack:pck_lib",
    ],
)

py_test(
    name = "export_configuration_test",
    size = "small",
    srcs = ["export_configuration_test.py"],
    deps = ["//tools:godot_export_lib"],
)

py_test(
    name = "action_plugin_test",
    size = "small",
    srcs = ["action_plugin_test.py"],
    deps = [
        # Carries the action plugin, data of the tools that run editor actions only.
        "//tools:godot_actions_lib",
        "//tools:godot_staging_lib",
    ],
)

py_test(
    name = "godot_actions_test",
    size = "small",
    srcs = ["godot_actions_test.py"],
    deps = [
        "//tools:godot_actions_lib",
        "//tools:godot_staging_lib",
    ],
)

py_test(
    name = "godot_export_test",
    size = "small",
    srcs = ["godot_export_test.py"],
    deps = [
        "//tools:godot_export_lib",
        "//tools/pack/tests:empty_pck",
        "//tools/resources:node_ids_lib",
    ],
)

py_test(
    name = "godot_staging_test",
    size = "small",
    srcs = ["godot_staging_test.py"],
    deps = [
        "//tools:godot_staging_lib",
        "//tools:mapped_paths_lib",
    ],
)

py_test(
    name = "mapped_paths_test",
    size = "small",
    srcs = ["mapped_paths_test.py"],
    deps = ["//tools:mapped_paths_lib"],
)

py_test(
    name = "template_test",
    size = "small",
    srcs = ["template_test.py"],
    deps = ["//tools:template_lib"],
)

py_test(
    name = "runtime_profile_test",
    size = "small",
    srcs = ["runtime_profile_test.py"],
    deps = ["//tools:runtime_profile_lib"],
)
