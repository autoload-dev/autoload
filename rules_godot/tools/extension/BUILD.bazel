load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "bindings",
    srcs = ["bindings.py"],
    main = "bindings.py",
)

py_library(
    name = "bindings_lib",
    srcs = ["bindings.py"],
    visibility = ["//tools:ruleset"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["bindings.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
