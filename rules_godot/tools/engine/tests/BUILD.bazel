load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_testonly = True)

# Writes Godot source files for the tests of the include graph and the build profile.
py_library(
    name = "source_files",
    testonly = True,
    srcs = ["source_files.py"],
)

py_test(
    name = "build_profile_test",
    size = "small",
    srcs = ["build_profile_test.py"],
    deps = [
        ":source_files",
        "//tools/engine:support",
    ],
)

