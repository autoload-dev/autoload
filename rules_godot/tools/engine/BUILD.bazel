load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Like every tool package, the engine tools serve the ruleset's own rules only: the rules of
# generated engine repositories name them through private attributes, which Bazel checks
# against the package that defines the rule.
package(default_visibility = ["//tools:ruleset"])

py_binary(
    name = "generator",
    srcs = [
        "build_profile.py",
        "class_db.py",
        "custom_modules.py",
        "generator.py",
        "include_graph.py",
        "source_tree.py",
    ],
    main = "generator.py",
)

# Configures a source recipe into its pin and merges pins into a lock file.
py_binary(
    name = "pin",
    srcs = [
        "build_file.py",
        "build_profile.py",
        "class_db.py",
        "compile_options.py",
        "configure.py",
        "custom_modules.py",
        "define_analysis.py",
        "generator_inputs.py",
        "generators.py",
        "include_graph.py",
        "lock.py",
        "module_graph.py",
        "patches.py",
        "pin.py",
        "recipe_options.py",
        "render.py",
        "source_tree.py",
        "variants.py",
    ],
    main = "pin.py",
)

py_binary(
    name = "revision",
    srcs = ["revision.py"],
)

py_library(
    name = "support",
    srcs = [
        "build_file.py",
        "build_profile.py",
        "class_db.py",
        "compile_options.py",
        "configure.py",
        "custom_modules.py",
        "define_analysis.py",
        "generator.py",
        "generator_inputs.py",
        "generators.py",
        "include_graph.py",
        "lock.py",
        "module_graph.py",
        "patches.py",
        "pin.py",
        "recipe_options.py",
        "render.py",
        "revision.py",
        "source_tree.py",
        "tree.py",
        "tree_link.py",
        "variants.py",
    ],
)

# The scripts, which the engine's repository rules (godot/engine/private/repositories.bzl)
# also run by label; a repository rule reads a file without a target. Private to this
# package, also in a consumer's build without --incompatible_no_implicit_file_export,
# which would make the files its targets use public.
exports_files(
    glob(["*.py"]),
    visibility = ["//visibility:private"],
)
