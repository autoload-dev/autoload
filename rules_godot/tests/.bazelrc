# The consumer module's settings: the root module's build settings, so its scenarios build
# as a consumer of the ruleset does, and the mobile configurations of its configuration
# suites and API contract cases.
build --incompatible_strict_action_env
# Application settings must not create separate compiler/code-generator builds.
build --incompatible_exclude_starlark_flags_from_exec_config
build --macos_minimum_os=11.0
# Source-built editors compile for the execution platform; Godot's floor is macOS 11.
build --host_macos_minimum_os=11.0
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --java_language_version=21
build --tool_java_language_version=21
test --test_output=errors

# Opt in to the integration tests, which download the pinned editor.
test:integration --test_tag_filters=integration

# The SDK and NDK toolchains of this host and of remote Linux executors.
build:android-toolchains --extra_toolchains=@androidsdk//:all
build:android-toolchains --extra_toolchains=@android_toolchains//:all
build:android --config=android-toolchains
build:android --platforms=@autoload_rules_godot//godot/platforms:android_arm64

build:official --platforms=@autoload_rules_godot//godot/platforms:ios_sim_x86_64
# The arm64 Simulator slot, which the hub builds from the release's sources.
build:source --platforms=@autoload_rules_godot//godot/platforms:ios_sim_arm64

build:aab --@autoload_rules_godot//godot:android_format=aab

import %workspace%/../../shared.bazelrc

# Opt in to BuildBuddy with --config=buildbuddy, or --config=buildbuddy-linux to test remotely.
import %workspace%/../../buildbuddy.bazelrc
# Bazel normalizes the command as a path; run the executable script by its relative path.
build:buildbuddy --workspace_status_command=../../buildbuddy_status.sh
# Tell this module's invocations apart in BuildBuddy's history and trends.
build:buildbuddy --build_metadata=TAGS=tests

# Personal settings for every module of this repository, such as `common --config=buildbuddy`,
# go in user.bazelrc at the repository root; git ignores it.
try-import %workspace%/../../user.bazelrc
