load("@autoload_rules_godot//godot:defs.bzl", "godot_project", "godot_resources", "godot_run", "godot_test")

godot_resources(
    name = "icon",
    srcs = ["main/icon.svg"],
)

godot_resources(
    name = "direct",
    srcs = ["main/direct.gd"],
)

godot_project(
    name = "script_run",
    project_file = "project.godot",
)

# Bazel splits args like a shell.
godot_test(
    name = "script_runs_with_imports_and_arguments_test",
    size = "small",
    args = [
        "--",
        "'declared value'",
    ],
    main = "main/direct.gd",
    project = ":script_run",
    deps = [
        ":direct",
        ":icon",
    ],
)

godot_run(
    name = "direct_run",
    args = [
        "--",
        "'declared value'",
    ],
    main = "main/direct.gd",
    project = ":script_run",
    deps = [
        ":direct",
        ":icon",
    ],
)
