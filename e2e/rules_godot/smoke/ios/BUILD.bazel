load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load("@autoload_rules_godot//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

# The ruleset's configured applications and artifact test rule, which it does not support
# as API.
# buildifier: disable=bzl-visibility
load("@autoload_rules_godot//godot/private:configured_app.bzl", "godot_configured_app")

# buildifier: disable=bzl-visibility
load("@autoload_rules_godot//godot/private/testing:ios_app_test.bzl", "ios_app_test")

# The iOS smoke path: an iOS application that embeds a godot-cpp extension as a dynamic
# framework, and one that links it statically and exports its entry symbol, inspected with
# the public artifact test. The tests are tagged `ios`, which CI's macOS job runs, and the
# other targets are manual; the Simulator applications carry their iOS configuration.

godot_project(
    name = "ios",
    main_scene = "main/main.tscn",
    project_file = "project.godot",
    tags = ["manual"],
)

# counter, main, pack and app embed the extension as a framework.

godot_cc_extension(
    name = "counter",
    srcs = ["native/counter.cc"],
    entry_symbol = "native_counter_init",
    resource_path = "main/native_counter/counter.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

godot_resources(
    name = "main",
    srcs = [
        "main/main.gd",
        "main/main.gd.uid",
        "main/main.tscn",
        "main/native_counter/counter.gd",
        "main/native_counter/counter.gd.uid",
    ],
    tags = ["manual"],
    deps = [":counter"],
)

godot_pack(
    name = "pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":ios",
    tags = ["manual"],
    deps = [
        ":counter",
        ":main",
    ],
)

godot_app(
    name = "app",
    application_id = "org.example.smoke.ios",
    pack = ":pack",
    tags = ["manual"],
)

# Their static_ counterparts link the extension's archive instead.

godot_cc_extension(
    name = "static_counter",
    srcs = ["native/counter.cc"],
    entry_symbol = "native_counter_init",
    ios_linkage = "static",
    resource_path = "main/native_counter/counter.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

godot_resources(
    name = "static_main",
    srcs = [
        "main/main.gd",
        "main/main.gd.uid",
        "main/main.tscn",
        "main/native_counter/counter.gd",
        "main/native_counter/counter.gd.uid",
    ],
    tags = ["manual"],
    deps = [":static_counter"],
)

godot_pack(
    name = "static_pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":ios",
    tags = ["manual"],
    deps = [
        ":static_counter",
        ":static_main",
    ],
)

godot_app(
    name = "static_app",
    application_id = "org.example.smoke.ios.static",
    pack = ":static_pack",
    tags = ["manual"],
)

# Both applications for the x86_64 Simulator of the official templates.
[
    godot_configured_app(
        name = "simulator_" + app,
        app = ":" + app,
        platform = "@autoload_rules_godot//godot/platforms:ios_sim_x86_64",
        tags = ["manual"],
    )
    for app in [
        "app",
        "static_app",
    ]
]

ios_app_test(
    name = "app_embeds_extension_framework_test",
    size = "small",
    app = ":simulator_app",
    files = [
        "Frameworks/counter.framework/Info.plist",
        "Frameworks/counter.framework/counter",
    ],
    # Tagged ios: only CI's macOS job runs it (shared.bazelrc).
    tags = [
        "godot_process",
        "ios",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)

ios_app_test(
    name = "static_app_links_extension_test",
    size = "small",
    app = ":simulator_static_app",
    symbols = ["native_counter_init"],
    # Tagged ios: only CI's macOS job runs it (shared.bazelrc).
    tags = [
        "godot_process",
        "ios",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)
