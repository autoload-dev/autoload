load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Another package than the application's: its public debug symbols target is visible here.
build_test(
    name = "app_debug_symbols_are_visible_test",
    tags = ["godot_process"],
    targets = ["//e2e/rules_godot/smoke/linux:app.debug_symbols"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
