load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_addon",
    "godot_pack",
    "godot_project",
    "godot_resources",
)
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")
load("@rules_python//python:defs.bzl", "py_test")

# The Linux smoke path: build, inspect and boot a Linux application whose C ABI and
# godot-cpp extensions load and whose imported texture is usable, with an add-on of the
# project's own. Linux hosts only.
_LINUX = ["@platforms//os:linux"]

# The extensions build their editor libraries for the host too, where the host constraint
# would fail them; they are manual instead, and the project carries the constraint.
godot_cc_extension(
    name = "hello",
    srcs = ["native/hello.cc"],
    entry_symbol = "rules_godot_library_init",
    resource_path = "native/hello.gdextension",
    tags = ["manual"],
)

godot_cc_extension(
    name = "cpp_example",
    srcs = ["native/cpp_example.cc"],
    entry_symbol = "example_library_init",
    resource_path = "native/cpp_example.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

godot_cc_extension(
    name = "counter",
    srcs = ["native/counter.cc"],
    entry_symbol = "native_counter_init",
    resource_path = "addons/native_counter/counter.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

# An add-on of the project's own, as a consumer keeps one beside its content: a GDScript
# wrapper at res://addons/native_counter over a godot-cpp extension class.
godot_addon(
    name = "native_counter",
    srcs = [
        "main/addons/native_counter/counter.gd",
        "main/addons/native_counter/counter.gd.uid",
    ],
    strip_prefix = "main/addons/native_counter",
    target_compatible_with = _LINUX,
    deps = [":counter"],
)

godot_resources(
    name = "suites",
    testonly = True,
    srcs = [
        "tests/CounterTest.gd",
        "tests/CounterTest.gd.uid",
    ],
    target_compatible_with = _LINUX,
    deps = [
        ":native_counter",
        "@autoload_gdunit//gdunit",
    ],
)

gdunit_test(
    name = "project_addon_counts_test",
    size = "small",
    project = ":linux",
    suites = [":suites"],
    tags = ["godot_process"],
    target_compatible_with = _LINUX,
)

godot_resources(
    name = "main",
    srcs = [
        "main/icon.svg",
        "main/main.gd",
        "main/main.tscn",
    ],
    target_compatible_with = _LINUX,
)

godot_project(
    name = "linux",
    project_file = "project.godot",
    target_compatible_with = _LINUX,
)

godot_pack(
    name = "pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":linux",
    target_compatible_with = _LINUX,
    deps = [
        ":cpp_example",
        ":hello",
        ":main",
        ":native_counter",
    ],
)

# debug_symbols/ shows that the application's debug symbols target is visible to another
# package.
godot_app(
    name = "app",
    application_id = "org.example.smoke.linux",
    pack = ":pack",
    target_compatible_with = _LINUX,
    visibility = ["//e2e/rules_godot/smoke/linux:__subpackages__"],
)

[
    filegroup(
        name = "app_" + group,
        srcs = [":app"],
        output_group = group,
        target_compatible_with = _LINUX,
    )
    for group in [
        "archive",
        "bundle",
    ]
]

py_test(
    name = "app_boots_with_extensions_test",
    size = "small",
    srcs = ["app_boots_with_extensions_test.py"],
    args = [
        "$(rlocationpath :app_bundle)",
        "$(rlocationpath :app_archive)",
    ],
    data = [
        ":app_archive",
        ":app_bundle",
    ],
    tags = ["godot_process"],
    target_compatible_with = _LINUX,
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = [
        "main/addons/native_counter/counter.gd",
        "main/main.gd",
        "tests/CounterTest.gd",
    ],
    tags = ["gdscript"],
)
