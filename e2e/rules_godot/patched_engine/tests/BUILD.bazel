load("@autoload_rules_godot//godot:defs.bzl", "godot_test")
load("@rules_python//python:defs.bzl", "py_test")

# The application boots with the patched runtime that --extra_toolchains registers and
# reports the custom module's answer and the patched engine name. The source-engine lane
# runs it with each registration set: engines/stable, engines/beta and engines/source, the
# last with a fuller editor and a reduced runtime of one snapshot.
filegroup(
    name = "app_bundle",
    srcs = ["//e2e/rules_godot/patched_engine:app"],
    output_group = "bundle",
    tags = ["manual"],
)

py_test(
    name = "app_runs_patched_engine_test",
    size = "small",
    srcs = ["app_runs_patched_engine_test.py"],
    args = ["$(rlocationpath :app_bundle)"],
    data = [":app_bundle"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

# A build profile leaves the Tree class out of the same runtime.
filegroup(
    name = "app_without_tree_bundle",
    srcs = ["//e2e/rules_godot/patched_engine:app_without_tree"],
    output_group = "bundle",
    tags = ["manual"],
)

# A registered runtime profile's build option leaves the advanced GUI out of a variant.
filegroup(
    name = "app_without_advanced_gui_bundle",
    srcs = ["//e2e/rules_godot/patched_engine:app_without_advanced_gui"],
    output_group = "bundle",
    tags = ["manual"],
)

py_test(
    name = "app_build_profile_test",
    size = "small",
    srcs = ["app_build_profile_test.py"],
    args = [
        "$(rlocationpath :app_bundle)",
        "$(rlocationpath :app_without_tree_bundle)",
        "$(rlocationpath :app_without_advanced_gui_bundle)",
    ],
    data = [
        ":app_bundle",
        ":app_without_advanced_gui_bundle",
        ":app_without_tree_bundle",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

# The editor runs the same probe scene, so the module and patch exist in the editor role.
godot_test(
    name = "source_built_editor_test",
    project = "//e2e/rules_godot/patched_engine",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["//e2e/rules_godot/patched_engine:main"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "app_build_profile_test.py",
        "app_runs_patched_engine_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
