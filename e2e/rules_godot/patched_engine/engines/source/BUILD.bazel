load("@autoload_rules_godot//godot/engine:defs.bzl", "godot_editor_component", "godot_runtime_component")

_ORIGIN = "godotengine/godot@2ea68c7, a 4.7 maintenance-branch snapshot"

# Separate recipes of one source: a fuller editor and a reduced runtime, both with the
# bazel_probe module and the engine-name patch. Register with --extra_toolchains.
godot_editor_component(
    name = "editor_macos_arm64",
    cpu = "arm64",
    editor = "@patched_macos_arm64_editor//:godot",
    origin = _ORIGIN,
    platform = "macos",
    tags = ["manual"],
    version = "4.7.3-rc",
)

godot_runtime_component(
    name = "runtime_macos_arm64_release",
    cpu = "arm64",
    origin = _ORIGIN,
    platform = "macos",
    runtime = "@patched_macos_arm64_template_release//:godot",
    tags = ["manual"],
    variant = "release",
    version = "4.7.3-rc",
)
