# The bazel_probe engine module; MODULE.bazel adds it to the source recipes through this
# config.py, and the recipe copies the whole directory.
package(default_visibility = ["//visibility:public"])

exports_files(["config.py"])

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "register_types.cpp",
        "register_types.h",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["config.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
