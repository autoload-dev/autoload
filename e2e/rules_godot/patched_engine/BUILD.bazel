load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load("@autoload_rules_godot//godot:defs.bzl", "godot_pack", "godot_project", "godot_resources")

package(default_visibility = ["//visibility:public"])

godot_resources(
    name = "main",
    srcs = [
        "main/main.gd",
        "main/main.tscn",
    ],
)

godot_project(
    name = "patched_engine",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    preset_settings = {"script_export_mode": "0"},
    project = ":patched_engine",
    deps = [":main"],
)

# The engines/stable and engines/beta packages register the patched source-built runtimes;
# each run prioritizes one of them with --extra_toolchains. The 4.8 beta compiles its arm64
# runtime for macOS 13.0, so the app's minimum must cover both runtimes.
godot_app(
    name = "app",
    macos_minimum_os_version = "13.0",
    pack = ":pack",
    tags = ["manual"],
)

# The same runtime without the classes a build profile disables; only the sources that
# register classes compile again.
godot_app(
    name = "app_without_tree",
    build_profile = "classes.gdbuild",
    macos_minimum_os_version = "13.0",
    pack = ":pack",
    tags = ["manual"],
)

# A build option compiles a runtime variant: MODULE.bazel registers the profile, so the
# engine's recipes declare the variant beside their own graph.
godot_app(
    name = "app_without_advanced_gui",
    build_profile = "no_advanced_gui.gdbuild",
    macos_minimum_os_version = "13.0",
    pack = ":pack",
    tags = ["manual"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["main/main.gd"],
    tags = ["gdscript"],
)
