load("@autoload_rules_godot//godot:defs.bzl", "godot_addon")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

# The shared add-on: a godot-cpp extension class behind a GDScript wrapper at
# res://addons/native_counter, used by its own suites and by its demo, a second project that reuses it.
package(default_visibility = ["//e2e/rules_godot/shared_addon:__subpackages__"])

godot_cc_extension(
    name = "counter",
    srcs = ["native/counter.cc"],
    entry_symbol = "native_counter_init",
    resource_path = "addons/native_counter/counter.gdextension",
    deps = ["@godot_cpp"],
)

godot_addon(
    name = "native_counter",
    srcs = [
        "runtime/counter.gd",
        "runtime/counter.gd.uid",
    ],
    strip_prefix = "runtime",
    deps = [":counter"],
)
