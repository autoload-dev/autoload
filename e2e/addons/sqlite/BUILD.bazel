load("@autoload_rules_godot//godot:defs.bzl", "godot_editor", "godot_metadata_sync", "godot_project")

package(default_testonly = True)

godot_project(
    name = "sqlite",
    project_file = "project.godot",
    visibility = ["//e2e/addons/sqlite:__subpackages__"],
)

godot_editor(
    name = "edit",
    project = ":sqlite",
    deps = [
        "//e2e/addons/sqlite/database:suites",
    ],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":sqlite",
    tags = ["godot_process"],
    deps = [
        "//e2e/addons/sqlite/database:suites",
    ],
)
