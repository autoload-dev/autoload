load("@autoload_rules_godot//godot:defs.bzl", "godot_editor", "godot_metadata_sync", "godot_project")

package(default_testonly = True)

exports_files(
    ["project.godot"],
    visibility = ["//e2e/addons/app_auth/login:__pkg__"],
)

godot_project(
    name = "tests",
    project_file = "project.godot",
    visibility = ["//e2e/addons/app_auth:__subpackages__"],
)

godot_editor(
    name = "edit",
    project = ":tests",
    deps = ["//e2e/addons/app_auth/login:suites"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":tests",
    deps = ["//e2e/addons/app_auth/login:suites"],
)
