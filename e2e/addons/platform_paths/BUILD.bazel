load("@autoload_rules_godot//godot:defs.bzl", "godot_editor", "godot_metadata_sync", "godot_project")

package(default_testonly = True)

exports_files(
    ["project.godot"],
    visibility = [
        "//e2e/addons/platform_paths/locations:__pkg__",
        "//e2e/addons/platform_paths/results:__pkg__",
    ],
)

godot_project(
    name = "platform_paths",
    project_file = "project.godot",
    visibility = ["//e2e/addons/platform_paths:__subpackages__"],
)

godot_editor(
    name = "edit",
    project = ":platform_paths",
    deps = [
        "//e2e/addons/platform_paths/locations:suites",
        "//e2e/addons/platform_paths/results:suites",
    ],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":platform_paths",
    tags = ["godot_process"],
    deps = [
        "//e2e/addons/platform_paths/locations:suites",
        "//e2e/addons/platform_paths/results:suites",
    ],
)
