load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "PlatformPathsTest.gd",
        "PlatformPathsTest.gd.uid",
    ],
    prefix = "locations",
    visibility = ["//e2e/addons/platform_paths:__pkg__"],
    deps = [
        ":fixtures",
        "@autoload_gdunit//gdunit",
        "@autoload_platform_paths//platform_paths",
    ],
)

gdunit_test(
    name = "locations",
    size = "small",
    project = "//e2e/addons/platform_paths:tests",
    suites = [":suites"],
)

godot_resources(
    name = "fixtures",
    srcs = [
        "fixtures/documents-only-user-dirs.dirs.tpl",
        "fixtures/malformed-user-dirs.dirs.tpl",
        "fixtures/user-dirs.dirs.tpl",
    ],
    prefix = "locations",
)
