load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_testonly = True)

filegroup(
    name = "fixtures",
    srcs = [
        "fixtures/plain.dart",
        "fixtures/probe.dart",
    ],
    visibility = ["//e2e/addons/dart:__pkg__"],
)

godot_resources(
    name = "suites",
    srcs = [
        "ScriptTest.gd",
        "ScriptTest.gd.uid",
        "fixtures/plain.dart",
        "fixtures/plain.dart.uid",
        "fixtures/probe.dart",
        "fixtures/probe.dart.uid",
    ],
    prefix = "scripts",
    visibility = ["//e2e/addons/dart:__pkg__"],
    deps = [
        # The suites load the fixture scripts through constants, which no scan sees.
        "//e2e/addons/dart:dart_extension",  # keep
        "@autoload_gdunit//gdunit",
    ],
)

gdunit_test(
    name = "scripts",
    size = "small",
    project = "//e2e/addons/dart",
    suites = [":suites"],
)
