load("@autoload_dart//dart:defs.bzl", "godot_dart_extension")
load("@autoload_rules_godot//godot:defs.bzl", "godot_editor", "godot_metadata_sync", "godot_project")

package(default_testonly = True)

# The Dart language with the suites' fixture scripts.
godot_dart_extension(
    name = "dart_extension",
    srcs = ["//e2e/addons/dart/scripts:fixtures"],
    visibility = ["//e2e/addons/dart:__subpackages__"],
)

godot_project(
    name = "dart",
    project_file = "project.godot",
    visibility = ["//e2e/addons/dart:__subpackages__"],
)

godot_editor(
    name = "edit",
    project = ":dart",
    deps = [
        "//e2e/addons/dart/scripts:suites",
    ],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":dart",
    tags = ["godot_process"],
    deps = [
        "//e2e/addons/dart/scripts:suites",
    ],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
