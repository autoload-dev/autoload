# Bazel convenience symlinks of the root module and of rules_godot/; MODULE.bazel.lock and
# the Maven locks remain versioned.
/bazel-*
/rules_godot/bazel-*
/rules_godot/e2e/*/bazel-*
# Personal Bazel settings every module of this repository imports.
/user.bazelrc
# The Bazel slot a Codex worktree leased (tools/codex/worktree.sh).
/.bazel-slot

# Local development caches, Python environments and agent worktrees.
/.claude/worktrees/
/.cache/
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Godot-generated caches. Keep authored *.uid and *.import sidecar files.
.godot/
.import/
export_credentials.cfg

# Private signing material and machine-local settings.
.secrets/
.signing/
*.p12
*.pfx
*.p8
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
.env
.env.local
.env.*.local
xcuserdata/
.DS_Store

# Diagnostic logs of the last Bazel invocation (shared.bazelrc).
bazel-remote-grpc.log
/execution_log.binpb.zst
# Swift Package Manager's scratch directory beside examples/Package.swift.
/examples/.build/
# The add-on examples' local iOS provisioning profiles.
/examples/addons/*/signing/

# The add-on generator's self-test module (aspect work <lane>:addon-template).
/addons/.selftest/
/examples/addons/selftest/
