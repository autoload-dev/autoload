amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Local checks before a push. CI runs every lane on every run (tools/ci/verification.py), so
// no step selects paths: the pre-push hook runs the quick checks, and `hk check` adds the
// slower ones that need Bazel in several modules. Policy: docs/internal/verification.md.
local function task(name: String): Step = new {
  exclusive = true
  check = "mise run \(name)"
}

// Formatting, lint, the workflows and the setup contracts: seconds with a warm Bazel.
local quick = new Mapping<String, Step> {
  ["lint"] = task("lint")
  ["lint:ci"] = task("lint:ci")
  ["test:setup"] = task("test:setup")
}

// The conventions, the API reference and the repository tooling's tests.
local thorough = new Mapping<String, Step> {
  ["conventions"] = task("conventions")
  ["docs"] = task("docs")
  ["test:tools"] = task("test:tools")
}

hooks {
  ["check"] {
    steps {
      for (name, step in quick) {
        [name] = step
      }
      for (name, step in thorough) {
        [name] = step
      }
    }
  }
  ["pre-push"] {
    steps {
      ["pushed-checkout"] {
        exclusive = true
        check = "bash tools/pre_push_checkout.sh"
        stdin = "{{ hook_stdin }}"
      }
      for (name, step in quick) {
        [name] = step
      }
    }
  }
}
