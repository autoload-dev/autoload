amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Local checks; `mise run setup` installs the hooks. pre-commit works on the staged files,
// pre-push is the safety net over the whole branch, `hk check` adds the slower checks. CI runs
// every lane on every run (tools/ci/work.py). Policy: docs/internal/verification.md.

// A piece of the lanes' work (tools/ci/work.py). Work that runs Bazel holds its module's
// server, so it runs alone.
local function task(name: String): Step = new {
  exclusive = true
  check = "python3 -m tools.ci.work run \(name)"
}

// The Python, Starlark and Bazel sources the formatter handles; Buildifier also lints the
// Starlark ones, as .buildifier.json sets.
local sources = List("*.py", "*.bzl", "**/BUILD", "**/BUILD.bazel", "**/MODULE.bazel")

// Formatting, lint, the workflows and the setup contracts: seconds with a warm Bazel. The
// workflow and setup checks run no Bazel, so they run beside lint.
local quick = new Mapping<String, Step> {
  ["lint"] = task("lint")
  ["lint:ci"] = (task("lint:ci")) { exclusive = false }
  ["test:setup"] = (task("test:setup")) { exclusive = false }
}

// The conventions, the API reference and the repository tooling's tests.
local thorough = new Mapping<String, Step> {
  ["conventions"] = task("conventions")
  ["docs"] = task("docs")
  ["test:tools"] = task("test:tools")
}

// The Code Health review of a change (AGENTS.md, "Code Health"); it passes with a note
// without the CodeScene CLI or a sign-in.
local codeHealth = "python3 -m tools.code_health.codescene --if-available"

hooks {
  ["check"] {
    steps {
      for (name, step in quick) {
        [name] = step
      }
      for (name, step in thorough) {
        [name] = step
      }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      // Fix only: formatting is idempotent, so a check first would only add a Bazel run.
      ["format"] {
        glob = sources
        exclusive = true
        fix = "bazel run --config=host-execution //tools/format -- {{files}}"
      }
      ["ruff"] {
        glob = List("*.py")
        depends = "format"
        exclusive = true
        check = "bazel run --config=host-execution //tools/lint -- {{files}}"
      }
      ["code-health"] {
        depends = "format"
        check = "\(codeHealth) --staged"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["pushed-checkout"] {
        exclusive = true
        check = "bash tools/pre_push_checkout.sh"
        stdin = "{{ hook_stdin }}"
      }
      for (name, step in quick) {
        [name] = step
      }
      ["test:fast"] = task("test:fast")
      // The branch against its merge base, which also covers commits made without the
      // pre-commit hook.
      ["code-health"] { check = codeHealth }
    }
  }
}
