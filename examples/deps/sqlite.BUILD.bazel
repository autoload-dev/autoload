load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "sqlite",
    srcs = ["sqlite3.c"],
    hdrs = ["sqlite3.h"],
    defines = ["SQLITE_OMIT_LOAD_EXTENSION"],
    includes = ["."],
    # iOS lacks gethostuuid; configure SQLite's disabled fallback explicitly.
    local_defines = select({
        "@platforms//os:ios": ["HAVE_GETHOSTUUID=0"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": ["-pthread"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
)
