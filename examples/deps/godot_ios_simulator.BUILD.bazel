load("@rules_apple//apple:apple.bzl", "apple_static_xcframework_import")

# The arm64 iOS Simulator engine library of godot-mobile-plugins/godot-ios-builds, wrapped in
# an XCFramework by the repository's patch commands. The simulator build has no Vulkan or Metal
# renderer, so it needs neither MoltenVK nor the camera library; the frameworks and libraries
# match the official iOS templates.
apple_static_xcframework_import(
    name = "engine",
    has_swift = True,
    sdk_dylibs = [
        "c++",
        "z",
        "iconv",
    ],
    sdk_frameworks = [
        "ARKit",
        "AVFoundation",
        "AudioToolbox",
        "CoreAudio",
        "CoreGraphics",
        "CoreHaptics",
        "CoreMedia",
        "CoreMotion",
        "CoreText",
        "CoreVideo",
        "Foundation",
        "GameController",
        "Metal",
        "OpenGLES",
        "QuartzCore",
        "Security",
        "SystemConfiguration",
        "UIKit",
        "UniformTypeIdentifiers",
    ],
    visibility = ["//visibility:public"],
    xcframework_imports = glob(["libgodot.xcframework/**"]),
    alwayslink = False,
)
