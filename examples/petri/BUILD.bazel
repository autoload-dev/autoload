load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)

package(default_visibility = ["//visibility:public"])

# Every target that runs Godot names the engine simulation (examples/engines/simulation),
# Godot with the reaction_diffusion module whose class Petri's scripts use.

exports_files(["project.godot"])

godot_project(
    name = "petri",
    main_scene = "main/petri.tscn",
    project_file = "project.godot",
)

godot_editor(
    name = "edit",
    engine = "simulation",
    project = ":petri",
    deps = ["//examples/petri/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    engine = "simulation",
    project = ":petri",
    tags = ["godot_process"],
    deps = ["//examples/petri/main"],
)

godot_pack(
    name = "pack",
    engine = "simulation",
    project = ":petri",
    deps = ["//examples/petri/main"],
)

godot_run(
    name = "run",
    engine = "simulation",
    headless = False,
    pack = ":pack",
)

godot_app(
    name = "app",
    application_id = "org.example.rulesgodot.petri",
    engine = "simulation",
    pack = ":pack",
)

godot_project(
    name = "test_project",
    project_file = "project.godot",
    visibility = ["//visibility:private"],
)

godot_metadata_sync(
    name = "test_update",
    size = "small",
    testonly = True,
    engine = "simulation",
    project = ":test_project",
    tags = ["godot_process"],
    visibility = ["//visibility:private"],
    deps = ["//examples/petri/tests:suites"],
)

godot_editor(
    name = "test_edit",
    testonly = True,
    engine = "simulation",
    project = ":test_project",
    visibility = ["//visibility:private"],
    deps = ["//examples/petri/tests:suites"],
)

filegroup(
    name = "markdown_files",
    testonly = True,
    srcs = ["README.md"],
    tags = ["markdown"],
)
