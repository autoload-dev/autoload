load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "DishTest.gd",
        "DishTest.gd.uid",
        "FieldTest.gd",
        "FieldTest.gd.uid",
        "LayoutTest.gd",
        "LayoutTest.gd.uid",
        "SceneTest.gd",
        "SceneTest.gd.uid",
    ],
    prefix = "tests",
    visibility = ["//examples/petri:__pkg__"],
    deps = [
        "//examples/petri/main",
        "@autoload_gdunit//gdunit",
    ],
)

gdunit_test(
    name = "tests",
    size = "small",
    engine = "simulation",
    project = "//examples/petri",
    suites = [":suites"],
    tags = [
        # Its editor and engine are built from source: the Source engine workflow runs it.
        "source_engine",
    ],
)

# `godot_app` tags its targets `manual`: only this test builds the desktop application.
# Its engine is built from source: the Source engine workflow runs it.
build_test(
    name = "app_build_test",
    size = "small",
    tags = [
        "godot_process",
        "source_engine",
    ],
    targets = ["//examples/petri:app"],
)
