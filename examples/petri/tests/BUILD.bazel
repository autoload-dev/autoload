load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "DishTest.gd",
        "DishTest.gd.uid",
        "FieldTest.gd",
        "FieldTest.gd.uid",
        "LayoutTest.gd",
        "LayoutTest.gd.uid",
        "SceneTest.gd",
        "SceneTest.gd.uid",
    ],
    prefix = "tests",
    visibility = ["//examples/petri:__pkg__"],
    deps = [
        "//examples/petri/main",
        "@autoload_gdunit//gdunit",
    ],
)

gdunit_test(
    name = "tests",
    size = "small",
    engine = "simulation",
    project = "//examples/petri",
    suites = [":suites"],
    tags = [
        "godot_process",
        # Its editor and engine are built from source: the Source engine workflow runs it.
        "source_engine",
    ],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = [
        "DishTest.gd",
        "FieldTest.gd",
        "LayoutTest.gd",
        "SceneTest.gd",
    ],
    tags = ["gdscript"],
)
