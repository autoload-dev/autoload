load("@autoload_rules_godot//godot:defs.bzl", "godot_editor", "godot_pack", "godot_project")

package(default_visibility = ["//examples/addons/gdunit:__subpackages__"])

godot_project(
    name = "gdunit",
    project_file = "project.godot",
)

# The game without its suites, which only its tests and the editor load.
godot_pack(
    name = "pack",
    project = ":gdunit",
    deps = ["//examples/addons/gdunit/main"],
)

godot_editor(
    name = "edit",
    testonly = True,
    project = ":gdunit",
    deps = ["//examples/addons/gdunit/tests:suites"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
