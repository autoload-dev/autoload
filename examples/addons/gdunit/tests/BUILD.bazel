load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

# The suites use the game's code and GdUnit, both through their deps; the editor opens them.
godot_resources(
    name = "suites",
    testonly = True,
    srcs = ["ScoreboardTest.gd"],
    visibility = ["//examples/addons/gdunit:__pkg__"],
    deps = [
        "//examples/addons/gdunit/main",
        "@autoload_gdunit//gdunit",
    ],
)

gdunit_test(
    name = "unit_tests",
    size = "small",
    project = "//examples/addons/gdunit",
    suites = [":suites"],
    tags = ["godot_process"],
)
