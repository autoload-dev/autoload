load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)

package(default_visibility = ["//visibility:public"])

exports_files(["project.godot"])

godot_project(
    name = "platform_paths",
    main_scene = "main/paths_demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":platform_paths",
    deps = ["//examples/addons/platform_paths/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":platform_paths",
    deps = ["//examples/addons/platform_paths/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":platform_paths",
    tags = ["godot_process"],
    deps = ["//examples/addons/platform_paths/main"],
)

godot_app(
    name = "app",
    application_id = "org.example.platformpaths",
    pack = ":pack",
)
