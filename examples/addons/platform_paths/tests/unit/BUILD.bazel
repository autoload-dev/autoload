load("@rules_godot//godot:defs.bzl", "godot_resources")
load("@rules_godot//godot/gdunit:defs.bzl", "godot_gdunit_test")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "PathContractTest.gd",
        "PathContractTest.gd.uid",
    ],
    prefix = "unit",
    visibility = ["//addons/platform_paths/tests:__pkg__"],
    deps = [
        "//addons/platform_paths",
        "@gdunit4",
    ],
)

godot_gdunit_test(
    name = "unit",
    size = "small",
    project = "//addons/platform_paths/tests:tests",
    suites = [":suites"],
)
