load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)
load("//examples:releases.bzl", "android_release", "ios_release")

package(default_visibility = ["//visibility:public"])

godot_project(
    name = "sqlite",
    main_scene = "main/database_demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":sqlite",
    deps = ["//examples/addons/sqlite/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":sqlite",
    deps = ["//examples/addons/sqlite/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":sqlite",
    tags = ["godot_process"],
    deps = ["//examples/addons/sqlite/main"],
)

godot_app(
    name = "app",
    application_id = "org.example.sqlite",
    pack = ":pack",
)

android_release(
    name = "android_release",
    app = ":app",
)

ios_release(
    name = "ios_release",
    app = ":app",
)
