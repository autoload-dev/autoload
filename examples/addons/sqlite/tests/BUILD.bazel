load("@rules_godot//godot:defs.bzl", "godot_editor", "godot_metadata_sync", "godot_project")

package(default_testonly = True)

exports_files(
    ["project.godot"],
    visibility = [
        "//addons/sqlite/tests/unit:__pkg__",
    ],
)

godot_project(
    name = "tests",
    project_file = "project.godot",
    visibility = ["//addons/sqlite/tests:__subpackages__"],
)

godot_editor(
    name = "edit",
    project = ":tests",
    deps = [
        "//addons/sqlite/tests/unit:suites",
    ],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":tests",
    deps = [
        "//addons/sqlite/tests/unit:suites",
    ],
)
