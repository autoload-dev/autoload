load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")
load("@autoload_rules_godot//godot/gdunit:defs.bzl", "godot_gdunit_test")

package(default_testonly = True)

godot_resources(
    name = "suites",
    srcs = [
        "DatabaseTest.gd",
        "DatabaseTest.gd.uid",
    ],
    prefix = "unit",
    visibility = ["//addons/sqlite/tests:__pkg__"],
    deps = [
        "//addons/sqlite",
        "@gdunit4",
    ],
)

godot_gdunit_test(
    name = "unit",
    size = "small",
    project = "//addons/sqlite/tests:tests",
    suites = [":suites"],
)
