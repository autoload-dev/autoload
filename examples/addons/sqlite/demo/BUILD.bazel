load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)

package(default_visibility = ["//visibility:public"])

exports_files(["project.godot"])

godot_project(
    name = "demo",
    main_scene = "main/database_demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":demo",
    deps = ["//examples/addons/sqlite/demo/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":demo",
    deps = ["//examples/addons/sqlite/demo/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":demo",
    deps = ["//examples/addons/sqlite/demo/main"],
)

godot_app(
    name = "app",
    application_id = "org.example.sqlite",
    pack = ":pack",
)
