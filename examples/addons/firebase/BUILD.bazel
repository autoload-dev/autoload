load("@autoload_firebase//config:defs.bzl", "firebase_config")
load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)
load("//examples:releases.bzl", "android_release", "ios_release")

package(default_visibility = ["//visibility:public"])

_APPLICATION_ID = "dev.autoload.examples.firebase"

exports_files(["project.godot"])

# Placeholder configuration of a Firebase project: replace both files with those of your
# Firebase apps, downloaded from the Firebase console.
firebase_config(
    name = "firebase_config",
    application_id = _APPLICATION_ID,
    google_service_info_plist = "GoogleService-Info.plist",
    google_services_json = "google-services.json",
)

godot_project(
    name = "firebase",
    main_scene = "main/demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":firebase",
    deps = ["//examples/addons/firebase/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":firebase",
    deps = ["//examples/addons/firebase/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":firebase",
    tags = ["godot_process"],
    deps = ["//examples/addons/firebase/main"],
)

godot_app(
    name = "app",
    application_id = _APPLICATION_ID,
    # A device build needs a provisioning profile for the application id. Put yours at
    # examples/addons/firebase/signing/firebase.mobileprovision (gitignored) and build with
    # --define=ios_signing=local, e.g. via `build:ios --define=ios_signing=local` in user.bazelrc.
    ios_provisioning_profile = select({
        ":local_ios_signing": "//examples/addons/firebase:provisioning_profile",
        "//conditions:default": None,
    }),
    pack = ":pack",
    # rules_godot rejects any non-empty platform_resources on desktop platforms.
    platform_resources = select({
        "@platforms//os:android": [":firebase_config"],
        "@platforms//os:ios": [":firebase_config"],
        "//conditions:default": [],
    }),
)

config_setting(
    name = "local_ios_signing",
    define_values = {"ios_signing": "local"},
)

# The local, gitignored iOS provisioning profile of the example applications. Empty without
# one; only device builds with --define=ios_signing=local select it.
filegroup(
    name = "provisioning_profile",
    srcs = glob(
        ["signing/firebase*.mobileprovision"],
        allow_empty = True,
    ),
)

android_release(name = "android_release")

ios_release(name = "ios_release")
