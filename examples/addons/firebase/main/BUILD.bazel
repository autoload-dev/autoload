load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/addons/firebase:__subpackages__"])

godot_resources(
    name = "main",
    srcs = [
        "demo.gd",
        "demo.gd.uid",
        "demo.tscn",
        "firestore_demo.gd",
        "firestore_demo.gd.uid",
    ],
    prefix = "main",
    deps = [
        "@autoload_firebase//analytics",
        "@autoload_firebase//firestore",
    ],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = [
        "demo.gd",
        "firestore_demo.gd",
    ],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
