load("@autoload_rules_godot//godot:defs.bzl", "godot_test")

# buildifier: disable=bzl-visibility
load("@autoload_rules_godot//godot/private/testing:ios_app_test.bzl", "ios_app_test")

package(default_testonly = True)

# Runs the exported demo headless, where Firebase is unsupported: any engine error, such as a
# missing class or a failed check of demo.gd, fails it.
godot_test(
    name = "exported",
    size = "small",
    headless = True,
    pack = "//examples/addons/firebase:pack",
)

# The iOS lane tests it: the application embeds each extension's framework and the Firebase
# frameworks they link, which their extensions do not list.
ios_app_test(
    name = "app_embeds_firebase_frameworks_test",
    size = "small",
    app = "//examples/addons/firebase:app",
    files = [
        "Frameworks/%s.framework/%s" % (framework, framework)
        for framework in [
            "FirebaseAnalytics",
            "FirebaseCore",
            "FirebaseFirestore",
            "firebase_analytics",
            "firebase_core",
            "firebase_firestore",
        ]
    ],
    tags = [
        "ios",
        "manual",
    ],
)
