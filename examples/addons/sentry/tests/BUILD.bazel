load("@autoload_rules_godot//godot:defs.bzl", "godot_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_testonly = True)

# Runs the exported demo headless: any engine error, such as a missing class, fails it.
godot_test(
    name = "exported",
    size = "small",
    headless = True,
    pack = "//examples/addons/sentry:pack",
    tags = ["godot_process"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)

# `godot_app` tags its targets `manual`: only this test builds the desktop application.
build_test(
    name = "app_build_test",
    size = "small",
    tags = ["godot_process"],
    targets = ["//examples/addons/sentry:app"],
)
