load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/addons/sentry:__subpackages__"])

godot_resources(
    name = "main",
    srcs = [
        "demo.gd",
        "demo.gd.uid",
        "demo.tscn",
    ],
    prefix = "main",
    deps = ["@autoload_sentry//sentry"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["demo.gd"],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
