load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

package(default_visibility = ["//visibility:private"])

godot_cc_extension(
    name = "app_auth",
    srcs = ["//addons/app_auth/native:registration"],
    entry_symbol = "app_auth_addon_init",
    platform_deps = select({
        "@platforms//os:android": ["//addons/app_auth/backends/android:plugin"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:osx": [],
        "@platforms//os:ios": [],
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    # The editor registers the API with the unsupported backend: logins belong to running
    # games, so the tool configuration builds neither AppAuth nor its Swift package. Source
    # runs and applications load the library with the platform's backend.
    deps = ["//addons/app_auth/native"] + select({
        "@autoload_rules_godot//godot:tool": ["//addons/app_auth/backends/unsupported"],
        "//conditions:default": [":platform_backend"],
    }),
)

alias(
    name = "platform_backend",
    actual = select({
        "@platforms//os:osx": "//addons/app_auth/backends/apple",
        "@platforms//os:ios": "//addons/app_auth/backends/apple",
        "@platforms//os:android": "//addons/app_auth/backends/android",
        "//conditions:default": "//addons/app_auth/backends/unsupported",
    }),
)
