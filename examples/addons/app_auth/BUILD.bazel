load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)
load("//examples:releases.bzl", "android_release", "ios_release")

package(default_visibility = ["//visibility:public"])

# The application ID is also the redirect scheme AppAuth's Android redirect activity claims.
_APPLICATION_ID = "org.example.appauth"

godot_project(
    name = "app_auth",
    main_scene = "main/login_demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":app_auth",
    deps = ["//examples/addons/app_auth/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":app_auth",
    deps = ["//examples/addons/app_auth/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":app_auth",
    tags = ["godot_process"],
    deps = ["//examples/addons/app_auth/main"],
)

godot_app(
    name = "app",
    android_manifest_values = {"appAuthRedirectScheme": _APPLICATION_ID},
    application_id = _APPLICATION_ID,
    # AppAuth's Swift package needs macOS 12.
    macos_minimum_os_version = "12.0",
    pack = ":pack",
)

android_release(name = "android_release")

ios_release(name = "ios_release")

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
