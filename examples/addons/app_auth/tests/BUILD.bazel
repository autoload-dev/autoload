load("@autoload_rules_godot//godot:defs.bzl", "godot_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_testonly = True)

godot_test(
    name = "exported",
    size = "small",
    headless = True,
    pack = "//examples/addons/app_auth:pack",
)

# `godot_app` tags its targets `manual`: only this test builds the desktop application.
build_test(
    name = "app_build_test",
    size = "small",
    tags = ["godot_process"],
    targets = ["//examples/addons/app_auth:app"],
)
