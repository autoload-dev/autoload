load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//examples/addons/app_auth:__subpackages__"])

cc_library(
    name = "backend_api",
    hdrs = ["backend.h"],
)

cc_library(
    name = "validation",
    srcs = ["validation.cc"],
    hdrs = ["validation.h"],
)

cc_library(
    name = "id_token",
    srcs = ["id_token.cc"],
    hdrs = ["id_token.h"],
)

cc_library(
    name = "native",
    srcs = [
        "app_auth.cc",
        "app_auth_login.cc",
        "app_auth_result.cc",
    ],
    hdrs = [
        "app_auth.h",
        "app_auth_login.h",
        "app_auth_result.h",
    ],
    deps = [
        ":backend_api",
        ":id_token",
        ":validation",
        "@godot_cpp",
    ],
)

filegroup(
    name = "registration",
    srcs = ["register_types.cc"],
)
