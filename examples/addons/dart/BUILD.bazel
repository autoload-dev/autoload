load("@autoload_dart//dart:defs.bzl", "godot_dart_extension")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)

package(default_visibility = ["//visibility:public"])

# The Dart language, with the demo's scripts compiled in.
godot_dart_extension(
    name = "dart_extension",
    srcs = ["//examples/addons/dart/main:scripts"],
)

godot_project(
    name = "dart",
    main_scene = "main/dart_demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":dart",
    deps = ["//examples/addons/dart/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":dart",
    deps = ["//examples/addons/dart/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":dart",
    tags = ["godot_process"],
    deps = ["//examples/addons/dart/main"],
)
