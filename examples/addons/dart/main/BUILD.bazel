load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/addons/dart:__subpackages__"])

# The demo's Dart scripts, which //examples/addons/dart:dart_extension compiles.
filegroup(
    name = "scripts",
    srcs = [
        "counter.dart",
        "dart_demo.dart",
        "greeting.dart",
        "spinner.dart",
    ],
)

godot_resources(
    name = "main",
    srcs = [
        "counter.dart",
        "counter.dart.uid",
        "dart_demo.dart",
        "dart_demo.dart.uid",
        "dart_demo.tscn",
        "greeting.dart",
        "greeting.dart.uid",
        "spinner.dart",
        "spinner.dart.uid",
    ],
    prefix = "main",
    # Godot runs the Dart scripts with the extension; no reference names it.
    deps = ["//examples/addons/dart:dart_extension"],  # keep
)
