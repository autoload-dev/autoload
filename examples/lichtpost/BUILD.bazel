load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
    "godot_runtime_profile",
)

package(default_visibility = ["//visibility:public"])

exports_files(["project.godot"])

godot_project(
    name = "lichtpost",
    main_scene = "main/game.tscn",
    project_file = "project.godot",
)

godot_editor(
    name = "edit",
    project = ":lichtpost",
    deps = ["//examples/lichtpost/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":lichtpost",
    tags = ["godot_process"],
    deps = ["//examples/lichtpost/main"],
)

# The classes and build options a smaller runtime leaves out, as Godot's detection finds them
# in the game; `bazel run :update_profile` writes the file, `:update_profile.test` checks it.
godot_runtime_profile(
    name = "update_profile",
    size = "small",
    profile = "runtime.gdbuild",
    project = ":lichtpost",
    tags = ["godot_process"],
    deps = ["//examples/lichtpost/main"],
)

godot_pack(
    name = "pack",
    project = ":lichtpost",
    deps = ["//examples/lichtpost/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_app(
    name = "app",
    application_id = "org.example.rulesgodot.lichtpost",
    pack = ":pack",
)

# The same game with a runtime cut to what it uses: the default engine builds it from its
# release's sources with runtime.gdbuild, which MODULE.bazel registers. Desktop only; the
# mobile lanes ship :app.
godot_app(
    name = "slim_app",
    application_id = "org.example.rulesgodot.lichtpost",
    build_profile = "runtime.gdbuild",
    pack = ":pack",
)

godot_project(
    name = "test_project",
    project_file = "project.godot",
    visibility = ["//visibility:private"],
)

godot_metadata_sync(
    name = "test_update",
    size = "small",
    testonly = True,
    project = ":test_project",
    tags = ["godot_process"],
    visibility = ["//visibility:private"],
    deps = ["//examples/lichtpost/tests:suites"],
)

godot_editor(
    name = "test_edit",
    testonly = True,
    project = ":test_project",
    visibility = ["//visibility:private"],
    deps = ["//examples/lichtpost/tests:suites"],
)
