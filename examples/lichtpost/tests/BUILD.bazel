load("@autoload_gdunit//gdunit:defs.bzl", "gdunit_test")
load("@autoload_rules_godot//godot:defs.bzl", "godot_resources", "godot_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_testonly = True)

godot_resources(
    name = "helpers",
    srcs = [
        "GameFixture.gd",
        "GameFixture.gd.uid",
    ],
    prefix = "tests",
    deps = [
        "//examples/lichtpost/main",
        "//examples/lichtpost/main/levels/level_01",
        "//examples/lichtpost/main/run",
    ],
)

godot_resources(
    name = "suites",
    srcs = [
        "InputTest.gd",
        "InputTest.gd.uid",
        "LayoutTest.gd",
        "LayoutTest.gd.uid",
        "LevelTest.gd",
        "LevelTest.gd.uid",
        "ReplayTest.gd",
        "ReplayTest.gd.uid",
        "RouteTest.gd",
        "RouteTest.gd.uid",
        "SceneTest.gd",
        "SceneTest.gd.uid",
        "SoundTest.gd",
        "SoundTest.gd.uid",
    ],
    prefix = "tests",
    visibility = ["//examples/lichtpost:__pkg__"],
    runtime_deps = [":replays"],
    deps = [
        ":helpers",
        "//examples/lichtpost/main/components:courier",
        "//examples/lichtpost/main/components:light",
        "//examples/lichtpost/main/components:sound",
        "//examples/lichtpost/main/levels/level_01",
        "//examples/lichtpost/main/rules:replay",
        "//examples/lichtpost/main/rules:route",
        "//examples/lichtpost/main/run:definitions",
        "//examples/lichtpost/main/run/view",
        "//examples/lichtpost/main/ui",
        "@autoload_gdunit//gdunit",
    ],
)

godot_resources(
    name = "replays",
    srcs = [
        "delivery.json",
        "fall.json",
        "invalid.json",
        "level_01_layout_hashes.json",
        "pipe.json",
    ],
    prefix = "tests",
)

gdunit_test(
    name = "tests",
    size = "small",
    project = "//examples/lichtpost",
    suites = [":suites"],
)

godot_resources(
    name = "recorder",
    srcs = [
        "record.gd",
        "record.gd.uid",
    ],
    prefix = "tests",
    deps = ["//examples/lichtpost/main/rules:route"],
)

godot_test(
    name = "record",
    main = "tests/record.gd",
    project = "//examples/lichtpost",
    tags = ["manual"],
    deps = [":recorder"],
)

# `godot_app` tags its targets `manual`: only this test builds the desktop application.
build_test(
    name = "app_build_test",
    size = "small",
    tags = ["godot_process"],
    targets = ["//examples/lichtpost:app"],
)

# The same for the application whose runtime is built from source with runtime.gdbuild:
# the Source engine workflow runs it.
build_test(
    name = "slim_app_build_test",
    size = "small",
    tags = [
        "godot_process",
        "source_engine",
    ],
    targets = ["//examples/lichtpost:slim_app"],
)
