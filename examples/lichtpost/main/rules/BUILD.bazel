load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/lichtpost:__subpackages__"])

godot_resources(
    name = "route",
    srcs = [
        "route_model.gd",
        "route_model.gd.uid",
    ],
    prefix = "main/rules",
)

godot_resources(
    name = "replay",
    srcs = [
        "replay.gd",
        "replay.gd.uid",
    ],
    prefix = "main/rules",
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = [
        "replay.gd",
        "route_model.gd",
    ],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
