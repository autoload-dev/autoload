load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/lichtpost:__subpackages__"])

godot_resources(
    name = "font",
    srcs = [
        "AtkinsonHyperlegible-Regular.ttf",
        "AtkinsonHyperlegible-Regular.ttf.import",
        "OFL.txt",
    ],
    prefix = "main/shared/ui",
)

godot_resources(
    name = "ui",
    srcs = [
        "interface_theme.tres",
    ],
    prefix = "main/shared/ui",
    deps = [
        ":font",
    ],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
