load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/lichtpost:__subpackages__"])

godot_resources(
    name = "shared",
    srcs = [
        "primitives.gd",
        "primitives.gd.uid",
    ],
    prefix = "main/shared",
    deps = [
        "//examples/lichtpost/main/shared/palette",
    ],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["primitives.gd"],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
