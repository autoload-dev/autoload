load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

package(default_visibility = ["//examples/projects/lichtpost:__subpackages__"])

godot_resources(
    name = "definitions",
    srcs = [
        "level_definition.gd",
        "level_definition.gd.uid",
        "section_pattern.gd",
        "section_pattern.gd.uid",
    ],
    prefix = "main/run",
    deps = ["//examples/projects/lichtpost/main/shared/palette"],
)

godot_resources(
    name = "run",
    srcs = [
        "run.gd",
        "run.gd.uid",
        "run.tscn",
    ],
    prefix = "main/run",
    deps = [
        ":definitions",
        "//examples/projects/lichtpost/main/components:sound",
        "//examples/projects/lichtpost/main/rules:replay",
        "//examples/projects/lichtpost/main/rules:route",
        "//examples/projects/lichtpost/main/run/view",
    ],
)
