load("@rules_godot//godot:app.bzl", "godot_app")
load(
    "@rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)
load(":source_engine.bzl", "SOURCE_ENGINE_ONLY")

package(default_visibility = ["//visibility:public"])

exports_files(["project.godot"])

# Petri's engine is the build's, as --config=petri selects; source_engine.bzl turns it into
# the targets' gate.
config_setting(
    name = "with_source_engine",
    flag_values = {"@rules_godot//godot:engine": "petri"},
)

godot_project(
    name = "petri",
    main_scene = "main/petri.tscn",
    project_file = "project.godot",
)

godot_editor(
    name = "edit",
    project = ":petri",
    target_compatible_with = SOURCE_ENGINE_ONLY,
    deps = ["//projects/petri/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":petri",
    target_compatible_with = SOURCE_ENGINE_ONLY,
    deps = ["//projects/petri/main"],
)

godot_pack(
    name = "pack",
    project = ":petri",
    target_compatible_with = SOURCE_ENGINE_ONLY,
    deps = ["//projects/petri/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_app(
    name = "app",
    application_id = "org.example.rulesgodot.petri",
    pack = ":pack",
    target_compatible_with = SOURCE_ENGINE_ONLY,
)

godot_project(
    name = "test_project",
    project_file = "project.godot",
    visibility = ["//visibility:private"],
)

godot_metadata_sync(
    name = "test_update",
    size = "small",
    testonly = True,
    project = ":test_project",
    target_compatible_with = SOURCE_ENGINE_ONLY,
    visibility = ["//visibility:private"],
    deps = ["//projects/petri/tests:suites"],
)

godot_editor(
    name = "test_edit",
    testonly = True,
    project = ":test_project",
    target_compatible_with = SOURCE_ENGINE_ONLY,
    visibility = ["//visibility:private"],
    deps = ["//projects/petri/tests:suites"],
)
