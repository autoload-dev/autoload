load("@rules_godot//godot/engine:defs.bzl", "godot_runtime_component")

# arm64 iOS Simulator runtimes for every application of this module; MODULE.bazel registers
# them ahead of the official hub, whose simulator libraries contain x86_64 code only.
godot_runtime_component(
    name = "runtime_ios_arm64_simulator_release",
    cpu = "arm64",
    environment = "simulator",
    platform = "ios",
    runtime = "@godot_ios_simulator_arm64_release//:engine",
    variant = "release",
    version = "4.7.2",
)

godot_runtime_component(
    name = "runtime_ios_arm64_simulator_debug",
    cpu = "arm64",
    environment = "simulator",
    platform = "ios",
    runtime = "@godot_ios_simulator_arm64_debug//:engine",
    variant = "debug",
    version = "4.7.2",
)
