load("@bazel_skylib//rules:build_test.bzl", "build_test")

# The engine simulation: Godot with the reaction_diffusion module, which Petri uses.
# MODULE.bazel registers it with this module and this lock file, which the pin targets of
# the engine's generated hub name.
exports_files(
    ["simulation.lock.json"],
    visibility = ["//visibility:public"],
)

# Fails while the lock file has no current pin for one of the engine's recipes, naming the
# pin command, as after a change of its modules, options or rules_godot's code. The check is
# the same on every host, so CI's Linux job runs it alone: its tag keeps it out of the macOS
# job (shared.bazelrc), whose runners configure the recipes again in every run.
build_test(
    name = "pinned_test",
    tags = ["engine_pins"],
    targets = ["@simulation//:pinned"],
)
