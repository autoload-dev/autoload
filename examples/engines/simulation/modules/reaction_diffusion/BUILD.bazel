# The reaction_diffusion engine module; MODULE.bazel adds it to Petri's source build through
# this config.py, and the recipe copies the whole directory.
exports_files(["config.py"])

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "gray_scott_field.cpp",
        "gray_scott_field.h",
        "register_types.cpp",
        "register_types.h",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["config.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
