load("@rules_cc//cc:objc_library.bzl", "objc_library")

package(default_visibility = ["//firestore:__subpackages__"])

objc_library(
    name = "apple",
    srcs = ["apple_backend.mm"],
    copts = [
        "-fmodules",
        "-fcxx-modules",
    ],
    target_compatible_with = ["@platforms//os:ios"],
    deps = [
        "//firestore/native:backend_api",
        "//third_party/ios:firestore",
    ],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
