load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "google_services_lib",
    srcs = ["google_services.py"],
    imports = ["."],
    tags = ["lint-genfiles"],
    visibility = ["//config/tests:__pkg__"],
)

py_binary(
    name = "google_services",
    srcs = ["google_services.py"],
    tags = ["lint-genfiles"],
    visibility = ["//visibility:public"],
    deps = [":google_services_lib"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = ["google_services.py"],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
