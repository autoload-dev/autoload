load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//analytics:__subpackages__"])

cc_library(
    name = "unsupported",
    srcs = ["unsupported_backend.cc"],
    deps = ["//analytics/native:backend_api"],
    alwayslink = True,
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = ["unsupported_backend.cc"],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
