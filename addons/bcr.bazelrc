# The settings of the add-on modules' registry test modules, addons/<module>/bcr/<name>/, in
# this repository: they use the rules beside them rather than a release, as the convention
# check and manual runs need. Each test module try-imports this file, which no release
# archive contains; tools/ci/release_archive.py passes the same override itself.
common --override_module=autoload_rules_godot=../../../../rules_godot

import %workspace%/../../../../shared.bazelrc
