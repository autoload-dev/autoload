load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

package(default_visibility = ["//visibility:private"])

godot_cc_extension(
    name = "sqlite",
    srcs = ["database.cc"],
    entry_symbol = "sqlite_addon_init",
    visibility = ["//visibility:public"],
    deps = [
        "@godot_cpp",
        "@sqlite",
    ],
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = ["database.cc"],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
