# The module's declarations and Bazel settings with those of its registry test module, which
# the root module's setup checks read (tools/setup/checkout.py). bcr/ is ignored, so its files
# belong to this package.
filegroup(
    name = "module_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "MODULE.bazel",
        "bcr/smoke/.bazelversion",
        "bcr/smoke/MODULE.bazel",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "markdown_files",
    testonly = True,
    srcs = ["README.md"],
    tags = ["markdown"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
