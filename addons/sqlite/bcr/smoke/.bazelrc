# The registry tests this module against each new release; a lockfile would only drift.
common --lockfile_mode=off

# The settings the rules_godot README asks consumers to add.
build --incompatible_exclude_starlark_flags_from_exec_config
common --experimental_output_paths=strip
common --modify_execution_info=(?!Godot).*=-supports-path-mapping

test --test_output=errors

# In this repository, builds use the rules beside the module; the release archive and the
# registry have no such file.
try-import %workspace%/../../../bcr.bazelrc
