# Configuration for `git archive`, which builds the module's release archive
# (.github/workflows/release_prep.sh). The module's white-box tests in tests/ stay out of it;
# its example applications live in the root module's examples/addons/<module>/ and its
# end-to-end tests in e2e/addons/<module>/.
tests export-ignore
# The registry test modules in bcr/ keep their tests: the registry runs them from the archive.
bcr/**/tests -export-ignore
