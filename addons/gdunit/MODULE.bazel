"""GdUnit4 for Godot applications built with Bazel: the GdUnit add-on and gdunit_test, which runs
GdUnit suites as a Bazel test."""

module(
    name = "autoload_gdunit",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

# gdunit_test builds on rules_godot's test adapter (godot/testing:adapter.bzl), public API that
# may still change, which releases after 0.1.1 provide: raise the version to the release that
# has it before this module is released, and keep the two in step. Builds in this repository
# use the rules beside it (addons/module.bazelrc and the root MODULE.bazel).
bazel_dep(name = "autoload_rules_godot", version = "0.1.1")
bazel_dep(name = "package_metadata", version = "0.0.15")

# The third-party archives, each declared with its version in third_party/archives.bzl.
archives = use_extension("//third_party:archives.bzl", "archives")
use_repo(archives, "gdunit4")

# The repository's own tooling at its root, whose linters `aspect lint` applies here; consumers
# never see it.
bazel_dep(name = "autoload_dev", dev_dependency = True)
local_path_override(
    module_name = "autoload_dev",
    path = "../..",
)
