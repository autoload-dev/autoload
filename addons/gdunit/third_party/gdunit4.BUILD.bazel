# GdUnit4's release sources: the files of its add-on directory, which
# //gdunit assembles into the add-on.
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@autoload_gdunit//third_party:archives.bzl", "ARCHIVES")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["@autoload_gdunit//gdunit:__pkg__"],
)

# The archive's identity and license, for the SBOM and license tools that read package
# metadata. Its package URL comes from the archive's declaration in archives.bzl, like its
# URLs.
package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = ARCHIVES["gdunit4"].purl,
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "addons/gdUnit4/LICENSE",
)

# The editor plugin and the scenes it docks. Godot instantiates scenes while packing, these
# create GdUnit's singletons, and the export then crashes at exit. GdUnit's runtime classes
# use other classes of its UI directory, which stay in the runtime part.
_EDITOR = [
    "addons/gdUnit4/plugin.cfg",
    "addons/gdUnit4/plugin.gd",
    "addons/gdUnit4/src/network/GdUnitServer.tscn",
    "addons/gdUnit4/src/ui/GdUnitConsole.tscn",
    "addons/gdUnit4/src/ui/GdUnitInspector.tscn",
]

filegroup(
    name = "runtime",
    srcs = glob(
        ["addons/gdUnit4/**"],
        exclude = _EDITOR + ["addons/gdUnit4/test/**"],
    ),
)

filegroup(
    name = "editor",
    srcs = _EDITOR,
)
