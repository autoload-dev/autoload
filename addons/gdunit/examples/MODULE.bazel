"""Example application of autoload_gdunit: a Godot project that consumes the module as an
external Bazel module and tests its scripts with GdUnit, as applications outside this
repository do. tests/ holds the module's own tests, which consume it the same way. The
module builds no application (addon.pkl): no Android SDK or Maven graph."""

module(name = "autoload_gdunit_examples")

bazel_dep(name = "autoload_gdunit", version = "0.1.0")
local_path_override(
    module_name = "autoload_gdunit",
    path = "..",
)

bazel_dep(name = "autoload_rules_godot", version = "0.1.1")

# The rules of this repository, so that the add-ons are built against the rules they are
# changed with.
local_path_override(
    module_name = "autoload_rules_godot",
    path = "../../..",
)

bazel_dep(name = "platforms", version = "1.1.0")

# The module's tests in tests/ are driven by Python.
bazel_dep(name = "rules_python", version = "2.5.1")

# Python targets import only packages that have an __init__.py of their own.
python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
python_config.explicit_init_py(default = True)

godot_engines = use_extension("@autoload_rules_godot//godot:extensions.bzl", "godot_engines")
godot_engines.prebuilt(
    name = "godot",
    version = "4.7.2",
)
use_repo(godot_engines, "godot")

register_toolchains("@godot//toolchains:all")
