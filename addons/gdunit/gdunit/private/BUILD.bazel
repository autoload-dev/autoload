# The GdUnit test adapter gdunit_test runs as its main script; each test declares it as
# resources of its own, which use GdUnit through the suites' deps. Public because the test
# target lives in the caller's package.
exports_files(
    ["run.gd"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "gdscript_files",
    testonly = True,
    srcs = ["run.gd"],
    tags = ["gdscript"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "gdunit_test.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
