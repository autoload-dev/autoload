"""Dart: a Godot add-on of autoload-dev that scripts Godot projects in Dart, compiled ahead of time."""

module(
    name = "autoload_dart",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

# The release of rules_godot the add-ons need. Builds in this repository use the rules beside
# them instead (addons/module.bazelrc and the root MODULE.bazel).
bazel_dep(name = "autoload_rules_godot", version = "0.1.1")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")

# The Python that generates the Dart runtime's version file.
bazel_dep(name = "rules_python", version = "2.5.1")

# rules_dart compiles scripts with the SDK release whose sources build the add-on's embedded
# runtime; an AOT snapshot runs only on the runtime of its own release.
bazel_dep(name = "rules_dart", version = "0.10.0")

dart = use_extension("@rules_dart//dart:extensions.bzl", "dart")
dart.toolchain(dart_version = "3.14.1")
use_repo(dart, "dart_toolchains")

register_toolchains("@dart_toolchains//:all")

bazel_dep(name = "icu", version = "78.2.bcr.3")
bazel_dep(name = "zlib", version = "1.4")

# The third-party archives, each declared with its version in third_party/archives.bzl.
archives = use_extension("//third_party:archives.bzl", "archives")
use_repo(archives, "dart_sdk_source")

# The add-ons' own godot-cpp, with the classes their native code uses.
godot_cpp_bindings = use_repo_rule(
    "@autoload_rules_godot//godot/extension:repositories.bzl",
    "godot_cpp_bindings",
)

godot_cpp_bindings(
    name = "godot_cpp",
    enabled_classes = [
        "ClassDB",
        "Engine",
        "FileAccess",
        "JSON",
        "ProjectSettings",
        "RefCounted",
        "ResourceFormatLoader",
        "ResourceFormatSaver",
        "ResourceLoader",
        "ResourceSaver",
        "ScriptExtension",
        "ScriptLanguageExtension",
    ],
)

# The repository's own tooling at its root, whose linters `aspect lint` applies here; consumers
# never see it.
bazel_dep(name = "autoload_dev", dev_dependency = True)
local_path_override(
    module_name = "autoload_dev",
    path = "../..",
)
