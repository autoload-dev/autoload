load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

exports_files(["defs.bzl"])

# Dart as a Godot script language, on the Dart VM's AOT runtime. godot_dart_extension
# links it into a project's extension, beside the snapshot of the project's scripts.
cc_library(
    name = "dart",
    srcs = glob([
        "native/*.cc",
        "native/*.h",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "@dart_sdk_source//:dart_engine_aot",
        "@godot_cpp",
    ],
    alwayslink = True,
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "native/instance.cc",
        "native/instance.h",
        "native/language.cc",
        "native/language.h",
        "native/register.cc",
        "native/runtime.cc",
        "native/runtime.h",
        "native/script.cc",
        "native/script.h",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
