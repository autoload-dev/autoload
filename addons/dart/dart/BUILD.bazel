load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:private"])

# The public module as a file, for the registry's documentation and consumers' own.
exports_files(
    ["defs.bzl"],
    visibility = ["//visibility:public"],
)

# Dart as a Godot script language, on the Dart VM's AOT runtime. godot_dart_extension
# links it into a project's extension, beside the snapshot of the project's scripts.
cc_library(
    name = "dart",
    srcs = glob([
        "native/*.cc",
        "native/*.h",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "@dart_sdk_source//:dart_engine_aot",
        "@godot_cpp",
    ],
    alwayslink = True,
)
