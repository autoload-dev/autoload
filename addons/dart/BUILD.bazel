load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

# The module's identity and license, which REPO.bazel gives every target.
package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

# Its text is the repository's LICENSE, which aspect generate copies to the module's root,
# so that the release archive holds it.
license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MPL-2.0",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

# The module's declarations and Bazel settings with those of its registry test module, which
# the root module's setup checks read (tools/setup/checkout.py). bcr/ is ignored, so its files
# belong to this package.
filegroup(
    name = "module_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "MODULE.bazel",
        "bcr/smoke/.bazelversion",
        "bcr/smoke/MODULE.bazel",
    ],
    visibility = ["//visibility:public"],
)
