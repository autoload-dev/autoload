"""Sentry: Godot add-ons of autoload-dev, consumed by Godot applications through Bazel."""

module(
    name = "autoload_sentry",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

# The release of rules_godot the add-ons need. Builds in this repository use the rules beside
# them instead (addons/module.bazelrc and the root MODULE.bazel).
bazel_dep(name = "autoload_rules_godot", version = "0.1.1")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_apple", version = "5.4.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Android: the Sentry Android SDK that Sentry for Godot's export plugin adds to a Gradle
# build, and the Kotlin runtime its Godot plugin is compiled against. They join the
# application's @maven graph, which lists autoload_sentry in known_contributing_modules.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "io.sentry:sentry-android:8.64.0",
        "org.jetbrains.kotlin:kotlin-stdlib:2.0.21",
    ],
    repositories = [
        "https://repo.maven.apache.org/maven2",
        "https://dl.google.com/dl/android/maven2",
    ],
)
use_repo(maven, "maven")

# The third-party archives, each declared with its version in third_party/archives.bzl.
archives = use_extension("//third_party:archives.bzl", "archives")
use_repo(archives, "sentry_godot")

# The repository's own tooling at its root, whose linters `aspect lint` applies here; consumers
# never see it.
bazel_dep(name = "autoload_dev", dev_dependency = True)
local_path_override(
    module_name = "autoload_dev",
    path = "../..",
)
