load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_testonly = True)

cc_test(
    name = "validation_test",
    size = "small",
    srcs = ["validation_test.cc"],
    deps = ["//app_auth/native:validation"],
)

cc_test(
    name = "id_token_test",
    size = "small",
    srcs = ["id_token_test.cc"],
    deps = ["//app_auth/native:id_token"],
)

test_suite(
    name = "tests",
    tests = [
        ":id_token_test",
        ":validation_test",
    ],
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "id_token_test.cc",
        "validation_test.cc",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
