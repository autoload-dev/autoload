load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//app_auth:__subpackages__"])

# Always linked: the editor library lists it beside the shared native layer that calls it,
# and GNU ld takes archive members only for symbols already undefined when it reaches them.
cc_library(
    name = "unsupported",
    srcs = ["unsupported_backend.cc"],
    deps = ["//app_auth/native:backend_api"],
    alwayslink = True,
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = ["unsupported_backend.cc"],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
