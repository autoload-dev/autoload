load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

package(default_visibility = ["//visibility:private"])

godot_cc_extension(
    name = "app_auth",
    srcs = ["//app_auth/native:registration"],
    entry_symbol = "app_auth_addon_init",
    platform_deps = select({
        "@platforms//os:android": ["//app_auth/native/backends/android:plugin"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:osx": [],
        "@platforms//os:ios": [],
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    # The editor registers the API with the unsupported backend: logins belong to running
    # games, so the tool configuration builds neither AppAuth for Android nor for Apple. Source
    # runs and applications load the library with the platform's backend.
    deps = ["//app_auth/native"] + select({
        "@autoload_rules_godot//godot:tool": ["//app_auth/native/backends/unsupported"],
        "//conditions:default": [":platform_backend"],
    }),
)

alias(
    name = "platform_backend",
    actual = select({
        "@platforms//os:osx": "//app_auth/native/backends/apple",
        "@platforms//os:ios": "//app_auth/native/backends/apple",
        "@platforms//os:android": "//app_auth/native/backends/android",
        "//conditions:default": "//app_auth/native/backends/unsupported",
    }),
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
