"""App Auth: a Godot add-on of autoload-dev that signs users in with OAuth and OpenID Connect."""

module(
    name = "autoload_app_auth",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

# The release of rules_godot the add-ons need. Builds in this repository use the rules beside
# them instead (addons/module.bazelrc and the root MODULE.bazel).
bazel_dep(name = "autoload_rules_godot", version = "0.1.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_cc", version = "0.2.28")

# The add-ons' own godot-cpp, with the classes their native code uses.
godot_cpp_bindings = use_repo_rule(
    "@autoload_rules_godot//godot/extension:repositories.bzl",
    "godot_cpp_bindings",
)

godot_cpp_bindings(
    name = "godot_cpp",
    enabled_classes = [
        "Engine",
        "JSON",
        "OS",
        "RefCounted",
    ],
)

# AppAuth for Android, which the add-on's Android plugin calls. An application's root module
# lists this module in its maven installation's known_contributing_modules.
bazel_dep(name = "rules_jvm_external", version = "7.2")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = ["net.openid:appauth:0.11.1"],
    repositories = [
        "https://dl.google.com/dl/android/maven2",
        "https://repo.maven.apache.org/maven2",
    ],
)
use_repo(maven, "maven")

# AppAuth for iOS and macOS, built from its release's Objective-C sources; only Apple builds
# fetch it.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "appauth",
    build_file = "//third_party:appauth.BUILD.bazel",
    sha256 = "908fc7ff2b7dd26e65e0e9ef6603e313de28855b4dc3071543f04238255f6df9",
    strip_prefix = "AppAuth-iOS-3.0.0",
    urls = ["https://github.com/openid/AppAuth-iOS/archive/refs/tags/3.0.0.tar.gz"],
)

# The repository's own tooling at its root, whose linters `aspect lint` applies here; consumers
# never see it.
bazel_dep(name = "autoload_dev", dev_dependency = True)
local_path_override(
    module_name = "autoload_dev",
    path = "../..",
)
