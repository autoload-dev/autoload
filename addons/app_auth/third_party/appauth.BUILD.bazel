# AppAuth for iOS and macOS, built from its release's Objective-C sources: the core and the
# user agents of the platform being built, as its Swift package's AppAuth product holds them.
load("@rules_cc//cc:objc_library.bzl", "objc_library")

objc_library(
    name = "AppAuth",
    srcs = glob(["Sources/AppAuthCore/*.m"]) + select({
        "@platforms//os:ios": glob(["Sources/AppAuth/iOS/*.m"]),
        "@platforms//os:osx": glob(["Sources/AppAuth/macOS/**/*.m"]),
        "//conditions:default": [],
    }),
    hdrs = [
        "Sources/AppAuth.h",
        "Sources/AppAuthCore.h",
    ] + glob([
        "Sources/AppAuthCore/*.h",
        "Sources/AppAuth/iOS/*.h",
        "Sources/AppAuth/macOS/**/*.h",
    ]),
    # The headers import each other by file name, as the Swift package's header search paths
    # allow.
    includes = [
        "Sources",
        "Sources/AppAuthCore",
        "Sources/AppAuth/iOS",
        "Sources/AppAuth/macOS",
        "Sources/AppAuth/macOS/LoopbackHTTPServer",
    ],
    sdk_frameworks = [
        "Foundation",
        "Security",
    ] + select({
        "@platforms//os:ios": [
            "AuthenticationServices",
            "SafariServices",
            "UIKit",
        ],
        "@platforms//os:osx": [
            "AppKit",
            "AuthenticationServices",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
