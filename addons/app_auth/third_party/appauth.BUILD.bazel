# AppAuth for iOS and macOS, built from its release's Objective-C sources: the core and the
# user agents of the platform being built, as its Swift package's AppAuth product holds them.
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:objc_library.bzl", "objc_library")

package(default_package_metadata = [":package_metadata"])

# The archive's identity and license, for the SBOM and license tools that read package
# metadata. Keep the version in step with the archive's URL in MODULE.bazel.
package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = (
        purl.builder()
            .type("github")
            .namespace("openid")
            .name("AppAuth-iOS")
            .version("3.0.0")
            .build()
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

objc_library(
    name = "AppAuth",
    srcs = glob(["Sources/AppAuthCore/*.m"]) + select({
        "@platforms//os:ios": glob(["Sources/AppAuth/iOS/*.m"]),
        "@platforms//os:osx": glob(["Sources/AppAuth/macOS/**/*.m"]),
        "//conditions:default": [],
    }),
    hdrs = [
        "Sources/AppAuth.h",
        "Sources/AppAuthCore.h",
    ] + glob([
        "Sources/AppAuthCore/*.h",
        "Sources/AppAuth/iOS/*.h",
        "Sources/AppAuth/macOS/**/*.h",
    ]),
    # The headers import each other by file name, as the Swift package's header search paths
    # allow.
    includes = [
        "Sources",
        "Sources/AppAuthCore",
        "Sources/AppAuth/iOS",
        "Sources/AppAuth/macOS",
        "Sources/AppAuth/macOS/LoopbackHTTPServer",
    ],
    sdk_frameworks = [
        "Foundation",
        "Security",
    ] + select({
        "@platforms//os:ios": [
            "AuthenticationServices",
            "SafariServices",
            "UIKit",
        ],
        "@platforms//os:osx": [
            "AppKit",
            "AuthenticationServices",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
