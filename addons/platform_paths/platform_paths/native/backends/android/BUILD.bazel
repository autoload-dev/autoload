load("@rules_android//rules:rules.bzl", "android_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//platform_paths:__subpackages__"])

cc_library(
    name = "android",
    srcs = ["android_backend.cc"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//platform_paths/native:backend_api",
        "@godot_cpp",
    ],
)

android_library(
    name = "plugin",
    srcs = ["org/example/platformpaths/PlatformPathsAndroidPlugin.java"],
    custom_package = "org.example.platformpaths",
    exports_manifest = 1,
    manifest = "AndroidManifest.xml",
    proguard_specs = ["consumer-rules.pro"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "@autoload_rules_godot//godot/platforms:android_plugin_api",
    ],
)
