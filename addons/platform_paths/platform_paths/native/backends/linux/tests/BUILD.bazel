filegroup(
    name = "cc_files",
    testonly = True,
    srcs = ["xdg_directories_test.cc"],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
