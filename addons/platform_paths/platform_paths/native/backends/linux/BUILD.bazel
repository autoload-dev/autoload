load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//platform_paths:__subpackages__"])

cc_library(
    name = "policy",
    srcs = ["xdg_directories.cc"],
    hdrs = ["xdg_directories.h"],
    deps = ["//platform_paths/native:backend_api"],
)

cc_library(
    name = "linux",
    srcs = ["linux_backend.cc"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":policy",
        "//platform_paths/native:backend_api",
    ],
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "linux_backend.cc",
        "xdg_directories.cc",
        "xdg_directories.h",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
