load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//platform_paths:__subpackages__"])

cc_library(
    name = "backend_api",
    hdrs = ["backend.h"],
)

cc_library(
    name = "native",
    srcs = [
        "platform_path_result.cc",
        "platform_paths.cc",
    ],
    hdrs = [
        "platform_path_result.h",
        "platform_paths.h",
    ],
    deps = [
        ":backend_api",
        "@godot_cpp",
    ],
)

filegroup(
    name = "registration",
    srcs = ["register_types.cc"],
)

filegroup(
    name = "cc_files",
    testonly = True,
    srcs = [
        "backend.h",
        "platform_path_result.cc",
        "platform_path_result.h",
        "platform_paths.cc",
        "platform_paths.h",
        "register_types.cc",
    ],
    tags = ["cc"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
