import %workspace%/shared.bazelrc

# rules_dart builds its summary analyzer for the exec platform with analysis summaries off;
# the exec configuration has to keep that setting, or the analyzer depends on itself.
build --experimental_propagate_custom_flag=@rules_dart//dart:analysis_summaries
# Native code built outside an application, such as tests and the tools of imports, targets
# a fixed macOS version instead of the Xcode SDK's: the Dart runtime refuses to start on a
# system older than its deployment target, as on CI runners whose Xcode is newer than their
# macOS. 12.0 is the highest minimum of the examples' dependencies (AppAuth).
build --macos_minimum_os=12.0
build --host_macos_minimum_os=12.0

# Runs an application from its sources with the editor: bazel run --config=editor //path/to:app
build:editor --@autoload_rules_godot//godot:variant=editor

build:android --platforms=@autoload_rules_godot//godot/platforms:android_arm64
build:multi_abi --platforms=//examples:android_distribution
# The release builds of examples/releases.bzl apply the same settings, ANDROID_RELEASE and
# APPLE_RELEASE of the ruleset's godot_configured_app; change both together.
build:android-release --config=android
build:android-release -c opt
build:android-release --copt=-g
build:android-release --strip=always
# Do not encode a changing sandbox directory in DWARF.
build:android-release --copt=-fdebug-compilation-dir=.

build:official --platforms=@autoload_rules_godot//godot/platforms:ios_sim_x86_64
# arm64 Simulator, as current Simulators on Apple silicon require; the @godot hub builds its
# runtime from the release's sources.
build:simulator --platforms=@autoload_rules_godot//godot/platforms:ios_sim_arm64
# An iOS device; a device build needs a provisioning profile on godot_app.
build:ios --platforms=@autoload_rules_godot//godot/platforms:ios_arm64
build:ios-release --config=official
build:ios-release -c opt
# Match the stripped application to its retained DWARF by executable/dSYM UUID.
build:ios-release --apple_generate_dsym
build:ios-release --objc_enable_binary_stripping

# Delivery format is independent of operating system, CPUs and C++ optimization
# (--compilation_mode).
build:aab --@autoload_rules_godot//godot:android_format=aab

# Opt in to BuildBuddy with --config=buildbuddy.
import %workspace%/buildbuddy.bazelrc
build:buildbuddy --workspace_status_command="bash buildbuddy_status.sh"
# Tell this module's invocations apart in BuildBuddy's history and trends.
build:buildbuddy --build_metadata=TAGS=autoload_dev

# CI's jobs write ci.bazelrc at the repository root to set --config=ci (shared.bazelrc); git
# ignores it.
try-import %workspace%/ci.bazelrc

# Personal settings for every module of this repository, such as `common --config=buildbuddy`,
# go in user.bazelrc at the repository root; git ignores it.
try-import %workspace%/user.bazelrc
