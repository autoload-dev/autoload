load("//godot:defs.bzl", "godot_pack", "godot_test")
load("//godot/private:adapter.bzl", "adapter_test")

# Every GDScript rules_godot stages into a project loads in a project that treats every
# GDScript warning as an error: building these tests runs the imports, the initialization,
# the probes, the validation, the export and the shell probe, and running them the run logger
# and the test adapters' case selection.

_FIXTURE = "//godot/private/tests/strict_warnings/fixtures/project_with_strict_warnings"

godot_pack(
    name = "pack",
    project = _FIXTURE + ":project",
    tags = ["manual"],
    deps = [_FIXTURE + ":main"],
)

# What the shell probe reports about the pack's export.
filegroup(
    name = "export_facts",
    srcs = [":pack"],
    output_group = "export_facts",
    tags = ["manual"],
)

# Run test: a source run passes with the default engine_errors, which needs the run logger.
godot_test(
    name = "source_run_under_strict_warnings_test",
    size = "small",
    project = _FIXTURE + ":project",
    deps = [_FIXTURE + ":main"],
)

# Run test: a run of the exported pack passes the same way.
godot_test(
    name = "pack_run_under_strict_warnings_test",
    size = "small",
    data = [":export_facts"],
    pack = ":pack",
)

# Run test: a test adapter selects its cases with rules_godot's case selection.
adapter_test(
    name = "adapter_under_strict_warnings_test",
    adapter = "//godot/private/tests/adapter/fixtures/fake_adapter:run.gd",
    cases = "addons/fake_adapter/cases.txt",
    kwargs = {
        "project": _FIXTURE + ":project",
        "size": "small",
    },
    main = "addons/fake_adapter/run.gd",
    deps = ["//godot/private/tests/adapter/fixtures/cases:passing"],
)
