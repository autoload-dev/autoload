load("@rules_godot//godot:defs.bzl", "godot_addon")

# GdUnit4 as an add-on from its unchanged upstream directory. The editor part is the editor
# plugin and the scenes it docks: Godot instantiates scenes while packing, these create
# GdUnit's singletons, and the export then crashes at exit. GdUnit's runtime classes use
# other classes of its UI directory, which stay in the runtime part.
_EDITOR = [
    "addons/gdUnit4/plugin.cfg",
    "addons/gdUnit4/plugin.gd",
    "addons/gdUnit4/src/network/GdUnitServer.tscn",
    "addons/gdUnit4/src/ui/GdUnitConsole.tscn",
    "addons/gdUnit4/src/ui/GdUnitInspector.tscn",
]

godot_addon(
    name = "gdunit4",
    srcs = glob(
        ["addons/gdUnit4/**"],
        exclude = _EDITOR + ["addons/gdUnit4/test/**"],
    ),
    directory = "addons/gdUnit4",
    editor_srcs = _EDITOR,
    strip_prefix = "addons/gdUnit4",
    testonly = True,
    visibility = ["//visibility:public"],
)
