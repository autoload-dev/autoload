load("//godot:defs.bzl", "godot_resources")
load("//godot/extension:defs.bzl", "godot_cc_extension")

# A godot-cpp extension class behind a GDScript wrapper at addons/native_counter.
package(default_visibility = ["//godot/private/tests/gdunit:__subpackages__"])

godot_cc_extension(
    name = "counter",
    srcs = ["native/counter.cc"],
    entry_symbol = "native_counter_init",
    resource_path = "addons/native_counter/counter.gdextension",
    tags = ["manual"],
    deps = ["@godot_cpp"],
)

# The wrapper uses the extension's class.
godot_resources(
    name = "native_counter",
    resource_paths = {
        "runtime/counter.gd": "addons/native_counter/counter.gd",
        "runtime/counter.gd.uid": "addons/native_counter/counter.gd.uid",
    },
    tags = ["manual"],
    deps = [":counter"],
)
