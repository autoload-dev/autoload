load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//godot/gdunit:defs.bzl", "godot_gdunit_test")
load(":gdunit_adapter_tests.bzl", "gdunit_adapter_test_suite")

package(default_testonly = True)

# Run test: the passing suites pass with two shards splitting them round-robin.
godot_gdunit_test(
    name = "sharded_gdunit_suites_pass_test",
    size = "small",
    project = "//godot/private/tests/gdunit/fixtures/gdunit_suites:project",
    shard_count = 2,
    suites = ["//godot/private/tests/gdunit/fixtures/gdunit_suites:passing_suites"],
)

py_library(
    name = "contract",
    srcs = ["contract.py"],
)

# Run test: GdUnit launchers report, shard, filter, forward arguments, pass with orphan
# nodes and fail the way Bazel's test encyclopedia requires.
py_test(
    name = "gdunit_launcher_follows_test_encyclopedia_test",
    size = "small",
    srcs = ["gdunit_launcher_test.py"],
    args = [
        "$(rootpath :sharded_gdunit_suites_pass_test)",
        "$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:failing_suite)",
        "$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:empty_suite)",
        "$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:skipped_suite)",
        "$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:native_assertion_failure)",
        "$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:orphan_suite)",
    ],
    data = [
        ":sharded_gdunit_suites_pass_test",
        "//godot/private/tests/gdunit/fixtures/gdunit_suites:empty_suite",
        "//godot/private/tests/gdunit/fixtures/gdunit_suites:failing_suite",
        "//godot/private/tests/gdunit/fixtures/gdunit_suites:native_assertion_failure",
        "//godot/private/tests/gdunit/fixtures/gdunit_suites:orphan_suite",
        "//godot/private/tests/gdunit/fixtures/gdunit_suites:skipped_suite",
    ],
    main = "gdunit_launcher_test.py",
    deps = [":contract"],
)

# Build-output test: a pack with GdUnit4 builds without the report templates Godot ignores
# and without the scenes its editor plugin docks.
py_test(
    name = "gdunit4_pack_leaves_out_editor_scenes_test",
    size = "small",
    srcs = ["gdunit4_pack_test.py"],
    args = ["$(rootpath //godot/private/tests/gdunit/fixtures/gdunit_suites:gdunit4_pack)"],
    data = ["//godot/private/tests/gdunit/fixtures/gdunit_suites:gdunit4_pack"],
    main = "gdunit4_pack_test.py",
    deps = ["//tools:pck_lib"],
)

gdunit_adapter_test_suite(name = "gdunit_adapter_test_suite")
