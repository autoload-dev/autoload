load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# The implementation of the public inspection helper //godot/testing:artifact_tests.bzl:
# its rules, launch templates and inspectors. The inspectors carry their own trimmed
# readers, so the helper depends on no build tool of the ruleset.
package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "android_bundle_test.bzl",
        "ios_app_test.bzl",
    ],
    visibility = ["//docs/public/api:__pkg__"],
)

# The launch templates the rules of this package expand.
exports_files(
    glob(["*.tpl"]),
    visibility = ["//visibility:private"],
)

py_library(
    name = "native_symbols",
    srcs = ["native_symbols.py"],
    visibility = ["//godot/testing/private/tests:__pkg__"],
)

py_library(
    name = "inspect_android_bundle_lib",
    srcs = [
        "inspect_android_bundle.py",
        "pck.py",
    ],
    visibility = ["//godot/testing/private/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_android_bundle",
    srcs = ["inspect_android_bundle.py"],
    deps = [":inspect_android_bundle_lib"],
)

py_library(
    name = "inspect_ios_app_lib",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    visibility = ["//godot/testing/private/tests:__pkg__"],
    deps = [":native_symbols"],
)

py_binary(
    name = "inspect_ios_app",
    srcs = [
        "apple_bundle.py",
        "inspect_ios_app.py",
    ],
    main = "inspect_ios_app.py",
    deps = [":native_symbols"],
)
