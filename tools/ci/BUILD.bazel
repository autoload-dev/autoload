load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//:addons.bzl", "ADDON_REPOSITORIES")
load(":license_texts_test.bzl", "license_texts_test")

py_library(
    name = "work_lib",
    srcs = ["work.py"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

# A module's release test: its registry test module, run in its release archive.
py_library(
    name = "release_archive_lib",
    srcs = ["release_archive.py"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

# Every released module carries the repository's license at its root, where its release
# archive holds it, as the text of its package metadata's license.
license_texts_test(
    name = "released_modules_carry_the_license_test",
    size = "small",
    expected = "//:LICENSE",
    package_licenses = ["@autoload_rules_godot//:license"] + [
        repository + "//:license"
        for repository in ADDON_REPOSITORIES
    ],
)

py_test(
    name = "release_archive_test",
    size = "small",
    srcs = ["release_archive_test.py"],
    deps = [":release_archive_lib"],
)

py_test(
    name = "release_module_test",
    size = "small",
    srcs = [
        "release_module.py",
        "release_module_test.py",
    ],
    deps = ["//tools/addons:new_lib"],
)

py_test(
    name = "work_test",
    size = "small",
    srcs = ["work_test.py"],
    # The Aspect tasks that name work.
    data = ["//:aspect_tasks"],
    deps = [
        ":work_lib",
        "//tools/addons:test_support",
    ],
)

# The setup action's shutdown of Bazel, through Node's test runner. On a GitHub Linux runner
# a case mounts a real file system with sudo, which needs the host outside a sandbox and the
# runner's variables, by which the action tells a fresh Linux runner.
py_test(
    name = "setup_action_test",
    size = "small",
    srcs = ["setup_action_test.py"],
    args = ["$(rootpath @multitool//tools/node)"],
    data = [
        "//:setup_action",
        "@multitool//tools/node",
    ],
    env_inherit = [
        "GITHUB_ACTIONS",
        "PERSISTENT_RUNNER",
        "RUNNER_OS",
    ],
    tags = ["no-sandbox"],
)

# Whether a pull request reaches the source-engine tests, which the Source engine workflow
# reads to run them by itself.
py_library(
    name = "source_engine_changes_lib",
    srcs = ["source_engine_changes.py"],
)

py_test(
    name = "source_engine_changes_test",
    size = "small",
    srcs = ["source_engine_changes_test.py"],
    deps = [":source_engine_changes_lib"],
)
