load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "work_lib",
    srcs = ["work.py"],
    # The ruleset's output contracts run per lane (rules_godot/).
    visibility = ["//visibility:public"],
    # The add-on modules' lanes, from their addon.pkl.
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "release_module_test",
    size = "small",
    srcs = [
        "release_module.py",
        "release_module_test.py",
    ],
    deps = ["//tools/addons:new_lib"],
)

py_test(
    name = "work_test",
    size = "small",
    srcs = ["work_test.py"],
    # The Aspect tasks that name work.
    data = ["//:aspect_tasks"],
    deps = [":work_lib"],
)

# The setup action's shutdown of Bazel, through Node's test runner. On a GitHub Linux runner
# a case mounts a real file system with sudo, which needs the host outside a sandbox and the
# runner's variables, by which the action tells a fresh Linux runner.
py_test(
    name = "setup_action_test",
    size = "small",
    srcs = ["setup_action_test.py"],
    args = ["$(rootpath @multitool//tools/node)"],
    data = [
        "//:setup_action",
        "@multitool//tools/node",
    ],
    env_inherit = [
        "GITHUB_ACTIONS",
        "PERSISTENT_RUNNER",
        "RUNNER_OS",
    ],
    tags = ["no-sandbox"],
)
