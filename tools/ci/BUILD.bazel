load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The lanes alone, without the work's dependencies: the ruleset's API contract cases run per
# lane (rules_godot/docs).
py_library(
    name = "lanes_lib",
    srcs = ["lanes.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "work_lib",
    srcs = ["work.py"],
    # The add-on modules' lanes, from their addon.pkl, the applications', from their app.pkl,
    # and the change since origin/main as Code Health reads it.
    deps = [
        ":lanes_lib",
        "//tools/addons:new_lib",
        "//tools/apps:apps_lib",
        "//tools/code_health:codescene_lib",
        "//tools/setup:modules_lib",
    ],
)

# A module's release test: its registry test module, run in its release archive.
py_library(
    name = "release_archive_lib",
    srcs = ["release_archive.py"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "release_archive_test",
    size = "small",
    srcs = ["release_archive_test.py"],
    deps = [":release_archive_lib"],
)

py_test(
    name = "release_module_test",
    size = "small",
    srcs = [
        "release_module.py",
        "release_module_test.py",
    ],
    deps = ["//tools/addons:new_lib"],
)

py_test(
    name = "work_test",
    size = "small",
    srcs = ["work_test.py"],
    # The Aspect tasks that name work.
    data = ["//:aspect_tasks"],
    deps = [
        ":work_lib",
        "//tools/addons:test_support",
    ],
)

# The setup action's shutdown of Bazel, through Node's test runner. On a GitHub Linux runner
# a case mounts a real file system with sudo, which needs the host outside a sandbox and the
# runner's variables, by which the action tells a fresh Linux runner.
py_test(
    name = "setup_action_test",
    size = "small",
    srcs = ["setup_action_test.py"],
    args = ["$(rootpath @multitool//tools/node)"],
    data = [
        "//:setup_action",
        "@multitool//tools/node",
    ],
    env_inherit = [
        "GITHUB_ACTIONS",
        "PERSISTENT_RUNNER",
        "RUNNER_OS",
    ],
    tags = ["no-sandbox"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "lanes.py",
        "release_archive.py",
        "release_archive_test.py",
        "release_module.py",
        "release_module_test.py",
        "setup_action_test.py",
        "work.py",
        "work_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
