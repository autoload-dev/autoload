load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "context_lib",
    srcs = [
        "bazel.py",
        "cache.py",
        "context.py",
        "environment.py",
        "layout.py",
        "python_modules.py",
    ],
    deps = ["//tools/setup:modules_lib"],
)

# The rules that judge each file on its own, on given files, which the file lint runs
# (tools/lint/files.py).
py_binary(
    name = "files",
    srcs = ["files.py"],
    visibility = [
        "//tools/format:__pkg__",
        "//tools/lint:__pkg__",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":per_file_lib",
    ],
)

py_test(
    name = "files_test",
    size = "small",
    srcs = ["files_test.py"],
    deps = [
        ":files",
        ":rules_lib",
    ],
)

py_library(
    name = "framework_lib",
    srcs = ["framework.py"],
    deps = [":context_lib"],
)

# The rules that judge each file on its own, which need no Bazel, and their
# register (per_file.py).
py_library(
    name = "per_file_rules_lib",
    srcs = [
        "documents.py",
        "rules/fixture_references.py",
        "rules/public_documentation_links.py",
        "rules/reading_order.py",
        "rules/region_headers.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
    ],
)

py_library(
    name = "per_file_lib",
    srcs = ["per_file.py"],
    deps = [
        ":framework_lib",
        ":per_file_rules_lib",
    ],
)

py_library(
    name = "rules_lib",
    srcs = [
        "naming.py",
        "operations.py",
        "registry.py",
        "rules/rg001.py",
        "rules/rg002.py",
        "rules/rg006.py",
        "rules/rg007.py",
        "rules/rg008.py",
        "rules/rg009.py",
        "rules/rg012.py",
        "rules/rg014.py",
        "rules/rg015.py",
        "rules/rg017.py",
        "rules/rg018.py",
        "rules/rg019.py",
        "rules/rg020.py",
        "rules/rg021.py",
        "rules/rg022.py",
        "rules/rg023.py",
        "rules/rg026.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":per_file_lib",
        "//tools/addons:new_lib",
    ],
)

py_binary(
    name = "conventions",
    srcs = ["check.py"],
    args = ["$(rootpath @buildifier_prebuilt//:buildozer)"],
    data = ["@buildifier_prebuilt//:buildozer"],
    main = "check.py",
    tags = ["manual"],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":rules_lib",
        "//tools/addons:new_lib",
    ],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_support.py"],
    deps = [
        ":context_lib",
        "//tools/addons:new_lib",
        "//tools/addons:test_support",
    ],
)

py_test(
    name = "bazel_test",
    size = "small",
    srcs = ["bazel_test.py"],
    deps = [
        ":context_lib",
