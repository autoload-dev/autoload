load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "context_lib",
    srcs = [
        "bazel.py",
        "cache.py",
        "context.py",
        "environment.py",
        "layout.py",
        "python_modules.py",
    ],
    deps = ["//tools/setup:modules_lib"],
)

# The rules that judge each file on its own, on given files, which the file lint runs
# (tools/lint/files.py).
py_binary(
    name = "files",
    srcs = ["files.py"],
    visibility = [
        "//tools/format:__pkg__",
        "//tools/lint:__pkg__",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":per_file_lib",
    ],
)

py_test(
    name = "files_test",
    size = "small",
    srcs = ["files_test.py"],
    deps = [
        ":files",
        ":rules_lib",
    ],
)

py_library(
    name = "framework_lib",
    srcs = ["framework.py"],
    deps = [":context_lib"],
)

# The rules that judge each file on its own, which need no Bazel, and their
# register (per_file.py).
py_library(
    name = "per_file_rules_lib",
    srcs = [
        "documents.py",
        "naming.py",
        "rules/definitions_before_callers.py",
        "rules/no_claude_md.py",
        "rules/no_fixtures_in_public_documentation.py",
        "rules/no_internal_links_in_public_documentation.py",
        "rules/region_headers_named_in_head.py",
        "rules/shared_module_files_as_generated.py",
        "rules/snake_case_package_paths.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_library(
    name = "per_file_lib",
    srcs = ["per_file.py"],
    deps = [
        ":framework_lib",
        ":per_file_rules_lib",
    ],
)

py_library(
    name = "rules_lib",
    srcs = [
        "addon_modules.py",
        "operations.py",
        "registry.py",
        "rules/addon_module_examples_define_edit_and_pack.py",
        "rules/addon_module_named_after_directory.py",
        "rules/addon_modules_own_template_files.py",
        "rules/application_content_under_main.py",
        "rules/application_tests_under_tests.py",
        "rules/backends_under_native.py",
        "rules/documented_targets_exist.py",
        "rules/engine_files_under_engines.py",
        "rules/exported_files_declare_visibility.py",
        "rules/godot_process_tests_tagged.py",
        "rules/linked_skills.py",
        "rules/no_component_names_in_tooling.py",
        "rules/no_godot_in_addon_modules.py",
        "rules/no_stray_entries_in_addon_module_roots.py",
        "rules/no_test_only_dependencies_in_addon_modules.py",
        "rules/production_independent_of_tests.py",
        "rules/project_named_after_directory.py",
        "rules/projects_at_fixed_places.py",
        "rules/registry_templates_have_their_module.py",
        "rules/registry_test_module_in_bcr.py",
        "rules/release_archives_without_tests.py",
        "rules/snake_case_target_names.py",
        "rules/unique_extension_names.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":per_file_lib",
        "//tools/addons:new_lib",
    ],
)

py_binary(
    name = "conventions",
    srcs = ["check.py"],
    args = ["$(rootpath @buildifier_prebuilt//:buildozer)"],
    data = ["@buildifier_prebuilt//:buildozer"],
    main = "check.py",
    tags = ["manual"],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":rules_lib",
        "//tools/addons:new_lib",
    ],
)

py_library(
    name = "test_support",
