load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "context_lib",
    srcs = [
        "context.py",
        "environment.py",
        "layout.py",
    ],
    # The API documentation's checks read Bazel evidence through it (tools/docs).
    visibility = ["//visibility:public"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_library(
    name = "framework_lib",
    srcs = ["framework.py"],
    deps = [":context_lib"],
)

py_library(
    name = "rules_lib",
    srcs = [
        "documents.py",
        "manifests.py",
        "naming.py",
        "registry.py",
        "rules/rg001.py",
        "rules/rg002.py",
        "rules/rg003.py",
        "rules/rg004.py",
        "rules/rg006.py",
        "rules/rg007.py",
        "rules/rg008.py",
        "rules/rg009.py",
        "rules/rg012.py",
        "rules/rg013.py",
        "rules/rg014.py",
        "rules/rg015.py",
        "rules/rg016.py",
        "rules/rg017.py",
        "rules/rg018.py",
        "rules/rg019.py",
        "rules/rg020.py",
        "rules/rg021.py",
        "rules/rg023.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
        "//tools/addons:new_lib",
        "//tools/pkl:evaluate_lib",
    ],
)

py_binary(
    name = "conventions",
    srcs = ["check.py"],
    args = ["$(rootpath @buildifier_prebuilt//:buildozer)"],
    data = ["@buildifier_prebuilt//:buildozer"],
    main = "check.py",
    tags = ["manual"],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":rules_lib",
    ],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_support.py"],
    deps = [
        ":context_lib",
        "//tools/addons:new_lib",
    ],
)

py_test(
    name = "context_test",
    size = "small",
    srcs = ["context_test.py"],
    args = ["$(rootpath @buildifier_prebuilt//:buildozer)"],
    data = ["@buildifier_prebuilt//:buildozer"],
    deps = [
        ":context_lib",
        ":test_support",
    ],
)

py_test(
    name = "framework_test",
    size = "small",
    srcs = ["framework_test.py"],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":rules_lib",
        ":test_support",
    ],
)

