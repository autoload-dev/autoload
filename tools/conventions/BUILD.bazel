load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "context_lib",
    srcs = [
        "bazel.py",
        "cache.py",
        "context.py",
        "environment.py",
        "layout.py",
        "python_modules.py",
    ],
    # The API documentation's checks read Bazel evidence through it (tools/docs).
    visibility = ["//visibility:public"],
    deps = ["//tools/setup:modules_lib"],
)

# The rules that judge each file on its own, on given files, which the lint check's aspects run
# per package (tools/lint/linters.bzl).
py_binary(
    name = "files",
    srcs = ["files.py"],
    visibility = ["//tools/lint:__pkg__"],
    deps = [
        ":context_lib",
        ":framework_lib",
        ":per_file_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "files_test",
    size = "small",
    srcs = ["files_test.py"],
    deps = [
        ":files",
        ":rules_lib",
    ],
)

py_library(
    name = "framework_lib",
    srcs = ["framework.py"],
    deps = [":context_lib"],
)

# The rules that judge each file on its own, which need no Bazel, and their
# register (per_file.py).
py_library(
    name = "per_file_rules_lib",
    srcs = [
        "documents.py",
        "rules/rg004.py",
        "rules/rg013.py",
        "rules/rg024.py",
        "rules/rg025.py",
    ],
    deps = [
        ":context_lib",
        ":framework_lib",
    ],
)

py_library(
    name = "per_file_lib",
    srcs = ["per_file.py"],
    deps = [
        ":framework_lib",
        ":per_file_rules_lib",
    ],
)

