load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "android",
    srcs = ["sdk.py"],
    data = ["sdk.json"],
)

# The Java Bazel builds with, for the Android SDK's tools; work.py and sdk.py run it as a script.
py_binary(
    name = "java",
    srcs = ["java.py"],
    tags = ["manual"],
)

py_library(
    name = "requirements_lib",
    srcs = ["requirements.py"],
    # The ruleset's artifact inspection checks the provisioned SDK (rules_godot/).
    visibility = ["//visibility:public"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "sdk_test",
    size = "small",
    srcs = ["sdk_test.py"],
    deps = [":android"],
)

# Reads the checkout's modules, the nested ones included, which no label reaches; so it never
# comes from the cache.
py_test(
    name = "requirements_test",
    size = "small",
    srcs = ["requirements_test.py"],
    tags = ["external"],
    deps = [":requirements_lib"],
)
