load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "android",
    srcs = ["sdk.py"],
    data = ["sdk.json"],
)

py_library(
    name = "requirements_lib",
    srcs = ["requirements.py"],
    # The ruleset's artifact inspection checks the provisioned SDK (rules_godot/).
    visibility = ["//visibility:public"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "sdk_test",
    size = "small",
    srcs = ["sdk_test.py"],
    deps = [":android"],
)
