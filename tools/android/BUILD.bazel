load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("//tools/setup:module_files.bzl", "MODULE_FILES")

py_library(
    name = "android",
    srcs = ["sdk.py"],
    data = ["sdk.json"],
    visibility = ["//tools/setup:__pkg__"],
)

# The Java Bazel builds with, for the Android SDK's tools; work.py and sdk.py run it as a script.
py_binary(
    name = "java",
    srcs = ["java.py"],
    tags = ["manual"],
)

py_library(
    name = "requirements_lib",
    srcs = ["requirements.py"],
    deps = ["//tools/setup:modules_lib"],
)

py_test(
    name = "sdk_test",
    size = "small",
    srcs = ["sdk_test.py"],
    deps = [":android"],
)

# Checks a copy of the modules' files, those of the ruleset's Linux toolchains and the
# provisioned packages, and changed copies of them.
py_test(
    name = "requirements_test",
    size = "small",
    srcs = ["requirements_test.py"],
    data = MODULE_FILES + [
        "sdk.json",
        "@autoload_rules_godot//godot/platforms/private:android_toolchains.bzl",
    ],
    deps = [
        ":requirements_lib",
        "//tools/setup:checkout_lib",
    ],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "java.py",
        "requirements.py",
        "requirements_test.py",
        "sdk.py",
        "sdk_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
