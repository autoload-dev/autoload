load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Pkl modules, evaluated by the pinned Pkl CLI, which every target that depends on this
# library finds in its runfiles.
py_library(
    name = "evaluate_lib",
    srcs = ["evaluate.py"],
    data = ["@multitool//tools/pkl"],
    visibility = ["//tools:__subpackages__"],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "evaluate_test",
    size = "small",
    srcs = ["evaluate_test.py"],
    deps = [":evaluate_lib"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "evaluate.py",
        "evaluate_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
