load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The applications of examples/, from their app.pkl.
py_library(
    name = "apps_lib",
    srcs = ["apps.py"],
    data = ["App.pkl"],
    visibility = [
        "//tools/addons:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
    ],
    deps = [
        "//tools/pkl:evaluate_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "apps_test",
    size = "small",
    srcs = ["apps_test.py"],
    deps = [
        ":apps_lib",
        "//tools/addons:test_support",
    ],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "apps.py",
        "apps_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
