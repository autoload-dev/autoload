load("@aspect_rules_lint//format:defs.bzl", "format_multirun")

# Every module's Python and Starlark, through `aspect format`. Buildifier lints Starlark as it
# formats, with the warnings .buildifier.json selects; a warning fails the check and the fix
# alike. No lint aspect sees BUILD and MODULE.bazel files.
format_multirun(
    name = "format",
    python = "@aspect_rules_lint//format:ruff",
    starlark = "@buildifier_prebuilt//:buildifier",
    starlark_check_args = ["-mode=check"],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=warn",
    ],
    tags = ["manual"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
