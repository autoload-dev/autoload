load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("@rules_multirun//:defs.bzl", "multirun")

# Every module's Python, Starlark, C and C++ and shell scripts, through `aspect format`.
# Buildifier lints Starlark as it formats, with the warnings .buildifier.json selects; a warning
# fails the check and the fix alike. clang-format reads //:.clang-format and the files beside
# the sources it formats, shfmt //:.editorconfig.
format_multirun(
    name = "languages",
    cc = "//tools/lint:clang_format",
    python = "@aspect_rules_lint//format:ruff",
    shell = "@multitool//tools/shfmt",
    starlark = "@buildifier_prebuilt//:buildifier",
    starlark_check_args = ["-mode=check"],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=warn",
    ],
    tags = ["manual"],
)

# `aspect format` runs this target with the files to format, or none for every file: rules_lint's
# formatters, and the file lint's for the languages format_multirun has none for, such as
# Markdown and Objective-C (tools/lint/files.py).
multirun(
    name = "format",
    commands = [
        ":languages",
        "//tools/lint:fix",
    ],
    jobs = 0,
    tags = ["manual"],
)
