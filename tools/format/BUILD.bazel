load("@aspect_rules_lint//format:defs.bzl", "format_multirun")

# Formats only: Buildifier's lint, which .buildifier.json turns on, is //tools/lint's job.
format_multirun(
    name = "format",
    python = "@aspect_rules_lint//format:ruff",
    starlark = "@buildifier_prebuilt//:buildifier",
    starlark_check_args = [
        "-mode=check",
        "-lint=off",
    ],
    starlark_fix_args = [
        "-mode=fix",
        "-lint=off",
    ],
    tags = ["manual"],
)
