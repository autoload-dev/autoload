load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

godot_cc_extension(
    name = "twin",
    srcs = ["twin.cc"],
)

godot_cc_extension(
    name = "static_twin",
    srcs = ["twin.cc"],
)

godot_resources(
    name = "both",
    srcs = ["both/both.gd"],
    prefix = "twins",
    deps = [
        ":static_twin",
        ":twin",
    ],
)

godot_resources(
    name = "twins",
    srcs = ["twins.gd"],
    prefix = "twins",
    # Both extensions register Twin; this scene uses the first.
    deps = [":twin"],
)

godot_resources(
    name = "static",
    srcs = ["static/twins_static.gd"],
    prefix = "twins",
)
