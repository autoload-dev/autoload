load("@autoload_rules_godot//godot:defs.bzl", "godot_resources")

godot_resources(
    name = "components_courier",
    srcs = [
        "components/courier/courier.gd",
        "components/courier/courier.gd.uid",
        "components/courier/courier.tscn",
    ],
    prefix = "main",
    deps = ["//game/main/shared"],
)

godot_resources(
    name = "main",
    srcs = [
        "game.gd",
        "game.gd.uid",
        "game.tscn",
        "greeting.dart",
        "greeting.dart.uid",
    ],
    prefix = "main",
    deps = [
        ":sky",
        "//addons/dart_lang",
        "//addons/inventory",
        "//addons/inventory:tools",
        "//game/main/run",
    ],
)

godot_resources(
    name = "sky",
    srcs = [
        "sky.png",
        "sky.png.import",
    ],
    prefix = "main",
)
