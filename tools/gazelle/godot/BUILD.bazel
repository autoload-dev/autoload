load("@gazelle//:def.bzl", "gazelle_binary", "gazelle_generation_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# The Gazelle language that declares Godot projects, resources and GdUnit tests
# (docs/internal/gazelle.md).
go_library(
    name = "godot",
    srcs = [
        "files.go",
        "generate.go",
        "keep.go",
        "language.go",
        "resolve.go",
        "scanner.go",
        "tests.go",
        "units.go",
    ],
    data = [":scanner"],
    importpath = "github.com/autoload-dev/autoload/tools/gazelle/godot",
    visibility = ["//tools/gazelle:__pkg__"],
    x_defs = {"scannerRlocation": "$(rlocationpath :scanner)"},
    deps = [
        "@gazelle//config",
        "@gazelle//label",
        "@gazelle//language",
        "@gazelle//pathtools",
        "@gazelle//repo",
        "@gazelle//resolve",
        "@gazelle//rule",
        "@rules_go//go/runfiles",
    ],
)

# The scanner the language starts once per run: the ruleset's resource graph scanner reads
# the references of Godot files (scanner.py).
py_library(
    name = "scanner_lib",
    srcs = ["scanner.py"],
    deps = [
        "@autoload_rules_godot//tools/resource_graph:graph_lib",
        "@autoload_rules_godot//tools/resources:text_lib",
    ],
)

# Both name the ruleset's scanner too: ty's lint aspect searches the repositories of a
# target's direct dependencies only.
py_binary(
    name = "scanner",
    srcs = ["scanner.py"],
    deps = [
        ":scanner_lib",
        "@autoload_rules_godot//tools/resource_graph:graph_lib",
        "@autoload_rules_godot//tools/resources:text_lib",
    ],
)

py_test(
    name = "scanner_test",
    size = "small",
    srcs = ["scanner_test.py"],
    deps = [
        ":scanner_lib",
        "@autoload_rules_godot//tools/resource_graph:graph_lib",
        "@autoload_rules_godot//tools/resources:text_lib",
    ],
)

# Gazelle with this language alone, which the golden tests run.
gazelle_binary(
    name = "gazelle",
    testonly = True,
    languages = [":godot"],
)

# Each directory of testdata/ is a repository: Gazelle runs over it and its BUILD.out files
# are what it must write over its BUILD.in files. `UPDATE_SNAPSHOTS=true bazel run
# //tools/gazelle/godot:generation_test` rewrites them.
gazelle_generation_test(
    name = "generation_test",
    size = "small",
    gazelle_binary = ":gazelle",
    test_data = glob(["testdata/**"]),
)

# A second run over the tree of testdata/project as the first left it changes nothing.
gazelle_generation_test(
    name = "second_run_test",
    size = "small",
    build_in_suffix = ".out",
    gazelle_binary = ":gazelle",
    test_data = glob(["testdata/project/**"]),
)
