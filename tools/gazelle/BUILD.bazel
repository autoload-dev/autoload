load("@gazelle//:def.bzl", "gazelle_binary")
load("@rules_multirun//:defs.bzl", "multirun")
load("//:addons.bzl", "ADDON_REPOSITORIES")
load(":defs.bzl", "addon_gazelles", "module_gazelle")

# Gazelle with the languages this repository generates declarations for: `starlark`, the
# bzl_library targets of bazel_skylib's plugin, which this module patches (MODULE.bazel), and
# `lint`, the filegroups of the lint check's Markdown and GDScript (lint/lint.go).
gazelle_binary(
    name = "gazelle_binary",
    languages = [
        "@bazel_skylib_gazelle_plugin//bzl",
        "//tools/gazelle/lint",
    ],
)

# Gazelle runs from this module for each module it maintains, with the module's directory as
# its repository root; the module's root BUILD file holds its directives. `bazel run
# //tools/gazelle:<module>` updates the module's BUILD files, and
# `bazel run //tools/gazelle:<module>_check` fails with the diff where one differs from what
# Gazelle generates. The root module's are `root` and `root_check`, an add-on module's
# `addons.<directory>` and `addons.<directory>_check`, all add-on modules' `addons` and
# `addons_check`; `update` and `check` run them for every module.
# The ruleset's bzl_library targets leave out its white-box tests' modules.
module_gazelle(
    name = "rules_godot",
    directory = "rules_godot",
    languages = {
        "starlark": ["-exclude=**/tests"],
        "lint": [],
    },
)

module_gazelle(
    name = "root",
    directory = ".",
    languages = {"lint": []},
)

addon_gazelles(
    name = "addons",
    repositories = ADDON_REPOSITORIES,
)

multirun(
    name = "update",
    commands = [
        "rules_godot",
        "root",
        "addons",
    ],
)

# The checks only read, so they run at once, each module's output kept apart.
multirun(
    name = "check",
    buffer_output = True,
    commands = [
        "rules_godot_check",
        "root_check",
        "addons_check",
    ],
    jobs = 0,
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "defs.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
