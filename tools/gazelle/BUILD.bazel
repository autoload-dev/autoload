load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")

# Gazelle with the bzl_library targets of bazel_skylib's plugin, which this module patches
# (MODULE.bazel): the only BUILD declarations the repository generates, those of the ruleset.
gazelle_binary(
    name = "gazelle_binary",
    languages = ["@bazel_skylib_gazelle_plugin//bzl"],
)

# Gazelle runs from this module with the ruleset's directory as its repository root; the
# ruleset's root BUILD file holds its directives, and its bzl_library targets leave out its
# white-box tests' modules. `bazel run //tools/gazelle:update` updates its BUILD files,
# `bazel run //tools/gazelle:check` fails with the diff where one differs from what Gazelle
# generates.
_ARGS = [
    "-repo_root=rules_godot",
    "-exclude=**/tests",
    "rules_godot",
]

gazelle(
    name = "update",
    args = _ARGS,
    gazelle = ":gazelle_binary",
    mode = "fix",
)

gazelle(
    name = "check",
    args = _ARGS,
    gazelle = ":gazelle_binary",
    mode = "diff",
)
