load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/setup:module_files.bzl", "MODULE_FILES")

# The checkout's modules and their declarations, as the setup checks read them.
py_library(
    name = "modules_lib",
    srcs = ["modules.py"],
    visibility = [
        "//tools/addons:__pkg__",
        "//tools/android:__pkg__",
        "//tools/apps:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
        "//tools/docs:__pkg__",
        "//tools/generate:__pkg__",
    ],
)

py_test(
    name = "modules_test",
    size = "small",
    srcs = ["modules_test.py"],
    deps = [":modules_lib"],
)

# A checkout-shaped copy of the modules' files a test declares, for the setup checks' tests.
py_library(
    name = "checkout_lib",
    testonly = True,
    srcs = ["checkout.py"],
    visibility = ["//tools/android:__pkg__"],
    deps = [
        ":modules_lib",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "checkout_test",
    size = "small",
    srcs = ["checkout_test.py"],
    data = MODULE_FILES,
    deps = [":checkout_lib"],
)

# The Bazel wrapper that Bazelisk runs in place of Bazel, with its slots and profiles.
py_test(
    name = "bazel_wrapper_test",
    size = "small",
    srcs = ["bazel_wrapper_test.py"],
    args = ["$(rootpath //:tools/bazel)"],
    data = ["//:tools/bazel"],
)

# The shared-pin check of the root module and its consumer modules, on a copy of their files.
py_test(
    name = "pins_test",
    size = "small",
    srcs = [
        "pins.py",
        "pins_test.py",
    ],
    data = MODULE_FILES,
    deps = [
        ":checkout_lib",
        ":modules_lib",
    ],
)

# The setup check `aspect doctor` runs as a script (.aspect/work.axl).
py_test(
    name = "doctor_test",
    size = "small",
    srcs = [
        "doctor.py",
        "doctor_test.py",
    ],
    deps = [
        "//tools/android",
        "//tools/code_health:codescene_lib",
    ],
)
