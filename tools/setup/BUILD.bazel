load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The checkout's modules and their declarations, as the setup checks read them.
py_library(
    name = "modules_lib",
    srcs = ["modules.py"],
    visibility = [
        "//tools/addons:__pkg__",
        "//tools/android:__pkg__",
        "//tools/apps:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
        "//tools/docs:__pkg__",
        "//tools/generate:__pkg__",
    ],
)

py_test(
    name = "modules_test",
    size = "small",
    srcs = ["modules_test.py"],
    deps = [":modules_lib"],
)

# The Bazel wrapper that Bazelisk runs in place of Bazel, with its slots and profiles.
py_test(
    name = "bazel_wrapper_test",
    size = "small",
    srcs = ["bazel_wrapper_test.py"],
    args = ["$(rootpath //:tools/bazel)"],
    data = ["//:tools/bazel"],
)

# The shared-pin check of the root module and its consumer modules; `aspect work test:setup`
# runs pins.py on the checkout.
py_test(
    name = "pins_test",
    size = "small",
    srcs = [
        "pins.py",
        "pins_test.py",
    ],
    deps = [":modules_lib"],
)

# The setup check `aspect doctor` runs as a script (.aspect/work.axl).
py_test(
    name = "doctor_test",
    size = "small",
    srcs = [
        "doctor.py",
        "doctor_test.py",
    ],
    deps = [
        "//tools/android",
        "//tools/code_health:codescene_lib",
    ],
)
