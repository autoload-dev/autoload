#!/usr/bin/env bash
# Bazelisk runs this script in place of Bazel in this repository's modules and passes the
# Bazel binary as BAZEL_REAL. AUTOLOAD_BAZEL_FLAGS, whitespace-separated Bazel flags, are
# added after the command name of every command that reads build options, so Aspect tasks
# and the build tools that run Bazel use them per invocation, as with
# `AUTOLOAD_BAZEL_FLAGS=--config=buildbuddy aspect work <name>`. Flags on the command
# line come after them and win. Without the variable, this script only runs Bazel.
#
# Bazelisk also puts this directory first on PATH, so Bazel commands that build tools run in
# other workspaces, such as a generated consumer, reach this script as well. Those workspaces
# do not define this repository's configs, so the flags are added only in a workspace whose
# own tools/bazel is this script.
set -eo pipefail

arguments=("$@")
read -r -a flags <<<"${AUTOLOAD_BAZEL_FLAGS:-}"

# The workspace is the nearest directory with a boundary file, as for Bazel itself.
workspace="$PWD"
while [[ -n "$workspace" ]]; do
    for boundary in MODULE.bazel REPO.bazel WORKSPACE.bazel WORKSPACE; do
        [[ -f "$workspace/$boundary" ]] && break 2
    done
    workspace="${workspace%/*}"
done

# Only a workspace whose own tools/bazel is this script defines this repository's configs.
[[ -n "$workspace" && "$workspace/tools/bazel" -ef "${BASH_SOURCE[0]}" ]] || exec "$BAZEL_REAL" "$@"

if [[ ${#flags[@]} -gt 0 ]]; then
    # The command is the first argument that is not a startup option.
    for index in "${!arguments[@]}"; do
        if [[ "${arguments[$index]}" != -* ]]; then
            case "${arguments[$index]}" in
                build | test | run | coverage | cquery | aquery | info)
                    arguments=(
                        "${arguments[@]:0:index+1}"
                        "${flags[@]}"
                        "${arguments[@]:index+1}"
                    )
                    ;;
            esac
            break
        fi
    done
fi

# A startup option on the command line chooses the output base itself.
[[ " ${arguments[*]} " == *" --output_base="* || " ${arguments[*]} " == *" --output_user_root="* ]] &&
    exec "$BAZEL_REAL" "${arguments[@]}"

# A worktree that leased a Bazel slot (docs/internal/agent-setup.md, "Worktrees") keeps each
# module's output base in that slot. .bazel-slot at the worktree root, the nearest directory
# with a .git, names each module's base.
base=""
root="$workspace"
until [[ -e "$root/.git" || -z "$root" ]]; do root="${root%/*}"; done
if [[ -n "$root" && -f "$root/.bazel-slot" ]]; then
    module="${workspace#"$root"}"
    module="${module#/}"
    while read -r name slot; do
        # An output base is named by 32 hexadecimal digits, never the output user root itself.
        [[ "$name" == "${module:-.}" && "${slot##*/}" =~ ^[0-9a-f]{32}$ ]] && base="$slot" && break
    done <"$root/.bazel-slot"
fi

# A profile keeps the work of one Bazel configuration, such as android, in an output base and
# server of its own, so desktop and mobile work keep their analysis instead of discarding each
# other's (docs/internal/verification-recipes.md#profiles). AUTOLOAD_BAZEL_PROFILE names it,
# as the named work sets it; the default profile is the workspace's own output base. A
# profile's base lies in the same output user root, named by the MD5 of the default base or
# workspace and the profile, so `aspect output-bases` and `aspect gc` treat it like any other.
# Its server exits after AUTOLOAD_BAZEL_PROFILE_IDLE_SECONDS without a command. Profiles
# belong to the root module: the nested modules' commands that its work starts, such as the
# contract checker's in the ruleset, keep their module's own server.
profile="${AUTOLOAD_BAZEL_PROFILE:-default}"
if [[ "$profile" != default && "$workspace" == "$root" ]]; then
    # Bazel's default output user root and MD5 tool of this system; macOS keeps md5 in /sbin,
    # which a test's strict PATH leaves out.
    if [[ "$OSTYPE" == darwin* ]]; then
        user_root="$HOME/Library/Caches/bazel/_bazel_${USER:-$(id -un)}"
        md5=/sbin/md5
    else
        user_root="${XDG_CACHE_HOME:-$HOME/.cache}/bazel/_bazel_${USER:-$(id -un)}"
        md5=md5sum
    fi
    [[ -n "$base" ]] && user_root="${base%/*}"
    digest="$(printf '%s' "${base:-$workspace}:$profile" | "$md5" | cut -c1-32)"
    base="$user_root/$digest"
    arguments=("--max_idle_secs=${AUTOLOAD_BAZEL_PROFILE_IDLE_SECONDS:-900}" "${arguments[@]}")
fi
[[ -n "$base" ]] && arguments=("--output_base=$base" "${arguments[@]}")
exec "$BAZEL_REAL" "${arguments[@]}"
