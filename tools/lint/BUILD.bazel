load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python/uv:lock.bzl", "lock")

# The gate of the lint check (check.bzl): it fails with the reports of the linters that found
# something in a target.
exports_files(["check.sh"])

# The Python packages of the linters, from PyPI as @lint_pypi (MODULE.bazel). `bazel run
# //tools/lint:requirements.update` relocks them; the resolution leaves out releases newer
# than its date, so relocking is reproducible until the date moves. No test compares the
# lock with its sources: rules_python's lock action needs the network and is never cached.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements.txt",
    args = [
        "--universal",
        "--exclude-newer=2026-11-10",
    ],
)

# GDScript's declaration order through gdlint and //:.gdlintrc (gdscript.py), which the aspect
# `gdlint` runs (linters.bzl).
py_binary(
    name = "gdscript",
    srcs = ["gdscript.py"],
    deps = [
        "@lint_pypi//gdtoolkit",
        "@lint_pypi//lark",
        "@lint_pypi//pyyaml",
    ],
)

py_test(
    name = "gdscript_test",
    size = "small",
    srcs = ["gdscript_test.py"],
    args = ["$(rootpath //:.gdlintrc)"],
    data = ["//:.gdlintrc"],
    deps = [":gdscript"],
)

py_test(
    name = "check_test",
    size = "small",
    srcs = ["check_test.py"],
    args = ["$(rootpath :check.sh)"],
    data = [":check.sh"],
)

# The GitHub workflows and actions, through jactionlint; rules_lint has no aspect for them.
# Python is linted by the lint check (check.bzl, `--config=check`), Starlark by //tools/format.
py_test(
    name = "workflows_test",
    size = "small",
    srcs = ["workflows_test.py"],
    args = ["$(rootpath @multitool//tools/jactionlint)"],
    data = [
        "//:workflows",
        "@multitool//tools/jactionlint",
    ],
)
