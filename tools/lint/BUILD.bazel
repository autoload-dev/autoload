load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python/entry_points:py_console_script_binary.bzl", "py_console_script_binary")
load("@rules_python//python/uv:lock.bzl", "lock")
load(":files.bzl", "FILE_TOOLS", "FILE_TOOL_PATHS")

# The gate of the lint check (check.bzl): it fails with the reports of the linters that found
# something in a target.
exports_files(["check.sh"])

# The Python packages of the linters, from PyPI as @lint_pypi (MODULE.bazel). `bazel run
# //tools/lint:requirements.update` relocks them; the resolution leaves out releases newer
# than its date, so relocking is reproducible until the date moves. No test compares the
# lock with its sources: rules_python's lock action needs the network and is never cached.
lock(
    name = "requirements",
    srcs = ["requirements.in"],
    out = "requirements.txt",
    args = [
        "--universal",
        "--exclude-newer=2026-11-10",
    ],
)

# GDScript's declaration order through gdlint and //:.gdlintrc (gdscript.py), which the file
# lint runs (files.py).
py_binary(
    name = "gdscript",
    srcs = ["gdscript.py"],
    visibility = ["//tools/format:__pkg__"],
    deps = [
        "@lint_pypi//gdtoolkit",
        "@lint_pypi//lark",
        "@lint_pypi//pyyaml",
    ],
)

# clang-format from its PyPI package, which //tools/format runs on C and C++ and the file lint
# on Objective-C, with //:.clang-format.
py_console_script_binary(
    name = "clang_format",
    pkg = "@lint_pypi//clang_format",
    script = "clang-format",
    visibility = ["//tools/format:__pkg__"],
)

# The file lint (files.py): the linters of files without targets of their own, which find
# their executables through the variables of files.bzl.
py_binary(
    name = "files",
    srcs = ["files.py"],
    data = FILE_TOOLS.values(),
    env = FILE_TOOL_PATHS,
    visibility = ["//tools/format:__pkg__"],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "files_test",
    size = "small",
    srcs = ["files_test.py"],
    deps = [":files"],
)

py_test(
    name = "gdscript_test",
    size = "small",
    srcs = ["gdscript_test.py"],
    args = ["$(rootpath //:.gdlintrc)"],
    data = ["//:.gdlintrc"],
    deps = [":gdscript"],
)

py_test(
    name = "check_test",
    size = "small",
    srcs = ["check_test.py"],
    args = ["$(rootpath :check.sh)"],
    data = [":check.sh"],
)

# `aspect lint` runs the linters of the lint check (.aspect/config.axl, check.bzl).
py_test(
    name = "linters_test",
    size = "small",
    srcs = ["linters_test.py"],
    args = [
        "$(rootpath //:.aspect/config.axl)",
        "$(rootpath :check.bzl)",
    ],
    data = [
        ":check.bzl",
        "//:.aspect/config.axl",
    ],
)

# The GitHub workflows and actions, through jactionlint; rules_lint has no aspect for them.
# Python is linted by the lint check (check.bzl, `--config=check`), Starlark by //tools/format,
# the files without targets by the file lint.
py_test(
    name = "workflows_test",
    size = "small",
    srcs = ["workflows_test.py"],
    args = ["$(rootpath @multitool//tools/jactionlint)"],
    data = [
        "//:workflows",
        "@multitool//tools/jactionlint",
    ],
)
