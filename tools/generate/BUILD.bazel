load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Regenerates the generated files; `python3 -m tools.generate.generate` runs it on
# the checkout, since it runs Bazel in several modules.
py_library(
    name = "generate_lib",
    srcs = ["generate.py"],
    deps = [
        "//tools/addons:new_lib",
        "//tools/setup:modules_lib",
    ],
)

py_test(
    name = "generate_test",
    size = "small",
    srcs = ["generate_test.py"],
    deps = [":generate_lib"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "generate.py",
        "generate_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
