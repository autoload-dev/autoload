load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(
    default_testonly = True,
    default_visibility = ["//visibility:private"],
)

# Mach-O and ELF files as the toolchains write them, for the inspectors' tests.
py_library(
    name = "native_fixtures",
    srcs = ["native_fixtures.py"],
)

py_test(
    name = "inspect_android_bundle_test",
    size = "small",
    srcs = ["inspect_android_bundle_test.py"],
    deps = ["//tools/artifact_tests:inspect_android_bundle_lib"],
)

py_test(
    name = "inspect_ios_app_test",
    size = "small",
    srcs = ["inspect_ios_app_test.py"],
    deps = [
        ":native_fixtures",
        "//tools/artifact_tests:inspect_ios_app_lib",
    ],
)

py_test(
    name = "apple_bundle_test",
    size = "small",
    srcs = ["apple_bundle_test.py"],
    deps = ["//tools/artifact_tests:inspect_ios_app_lib"],
)

py_test(
    name = "native_symbols_test",
    size = "small",
    srcs = ["native_symbols_test.py"],
    deps = [
        ":native_fixtures",
        "//tools/artifact_tests:native_symbols",
    ],
)

py_test(
    name = "inspect_spdx_test",
    size = "small",
    srcs = ["inspect_spdx_test.py"],
    deps = ["//tools/artifact_tests:inspect_spdx_lib"],
)
