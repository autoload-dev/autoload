load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Code Health through the CodeScene CLI, Starlark and GDScript included;
# `python3 -m tools.code_health.codescene` runs codescene.py on the checkout.
py_library(
    name = "codescene_lib",
    srcs = [
        "batch.py",
        "change.py",
        "codescene.py",
        "documentation.py",
        "macros.py",
        "scan.py",
        "survey.py",
        "translation.py",
    ],
    visibility = ["//tools/setup:__pkg__"],
)

# The pinned CodeScene CLI (//:multitool.lock.json), whose archive does not mark it
# executable; the code-health task passes it as CODESCENE_CLI.
genrule(
    name = "codescene_cli",
    srcs = ["@multitool//tools/cs"],
    # Named `cs`, which batch.py identifies by its path, size and modification time.
    outs = ["cs"],
    cmd = "cp -L $(execpath @multitool//tools/cs) $@ && chmod +x $@",
    executable = True,
    tags = ["manual"],
)

py_test(
    name = "batch_test",
    size = "small",
    srcs = ["batch_test.py"],
    deps = [":codescene_lib"],
)

py_test(
    name = "change_test",
    size = "small",
    srcs = ["change_test.py"],
    deps = [":codescene_lib"],
)

py_test(
    name = "translation_test",
    size = "small",
    srcs = ["translation_test.py"],
    deps = [":codescene_lib"],
)
