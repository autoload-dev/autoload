load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Code Health of the whole repository through the CodeScene CLI, Starlark and GDScript
# included; `mise run code-health` runs codescene.py on the checkout.
py_library(
    name = "codescene_lib",
    srcs = ["codescene.py"],
)

py_test(
    name = "codescene_test",
    size = "small",
    srcs = ["codescene_test.py"],
    deps = [":codescene_lib"],
)
