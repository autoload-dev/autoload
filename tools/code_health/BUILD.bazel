load("@rules_python//python:defs.bzl", "py_library", "py_test")

# Code Health through the CodeScene CLI, Starlark and GDScript included;
# `python3 -m tools.code_health.codescene` runs codescene.py on the checkout.
py_library(
    name = "codescene_lib",
    srcs = [
        "change.py",
        "codescene.py",
        "documentation.py",
        "macros.py",
        "scan.py",
        "survey.py",
        "translation.py",
    ],
)

py_test(
    name = "change_test",
    size = "small",
    srcs = ["change_test.py"],
    deps = [":codescene_lib"],
)

py_test(
    name = "translation_test",
    size = "small",
    srcs = ["translation_test.py"],
    deps = [":codescene_lib"],
)
