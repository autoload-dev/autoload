"""The Bazel Central Registry's test module of {{module_name}}: a consumer that packs its add-ons."""

module(name = "{{module_name}}_bcr_smoke")

bazel_dep(name = "{{module_name}}", version = "0.0.0")
local_path_override(
    module_name = "{{module_name}}",
    path = "../..",
)

bazel_dep(name = "autoload_rules_godot", version = "0.1.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# An application registers its engine, whose toolchains rules_godot registers.
godot_engines = use_extension("@autoload_rules_godot//godot:extensions.bzl", "godot_engines")
godot_engines.engine(
    name = "godot",
    default = True,
    version = "4.7.2",
)
