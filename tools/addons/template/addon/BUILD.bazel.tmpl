load("@autoload_rules_godot//godot:defs.bzl", "godot_addon")
load("@autoload_rules_godot//godot/extension:defs.bzl", "godot_cc_extension")

package(default_visibility = ["//visibility:private"])

# {{title}}: the {{class}} class, with one backend per platform in native/backends.
godot_addon(
    name = "{{addon}}",
    directory = "addons/{{extension}}",
    visibility = ["//visibility:public"],
    deps = [":{{extension}}"],
)

# The name is unique across all add-ons and applications: on iOS it names the framework.
godot_cc_extension(
    name = "{{extension}}",
    srcs = ["//{{addon}}/native:registration"],
    entry_symbol = "{{extension}}_init",
    platform_deps = select({
        "@platforms//os:android": ["//{{addon}}/native/backends/android:plugin"],
        "//conditions:default": [],
    }),
    resource_path = "addons/{{extension}}/{{extension}}.gdextension",
    target_compatible_with = select({
        "@platforms//os:osx": [],
        "@platforms//os:ios": [],
        "@platforms//os:linux": [],
        "@platforms//os:android": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    # The editor and desktop runs use the unsupported backend, so editor builds never fetch
    # a platform SDK.
    deps = ["//{{addon}}/native"] + select({
        "@autoload_rules_godot//godot:tool": ["//{{addon}}/native/backends/unsupported"],
        "@platforms//os:ios": ["//{{addon}}/native/backends/apple"],
        "@platforms//os:android": ["//{{addon}}/native/backends/android"],
        "//conditions:default": ["//{{addon}}/native/backends/unsupported"],
    }),
)
