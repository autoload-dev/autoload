load("@rules_android//rules:rules.bzl", "android_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//{{addon}}:__subpackages__"])

cc_library(
    name = "android",
    srcs = ["android_backend.cc"],
    target_compatible_with = ["@platforms//os:android"],
    deps = [
        "//{{addon}}/native:backend_api",
        "@godot_cpp",
    ],
)

# The Godot Android plugin; applications containing the add-on package it without listing
# it. Maven libraries it needs come from the root module's @maven graph.
android_library(
    name = "plugin",
    srcs = ["dev/autoload/{{module}}/{{addon}}/{{class}}Plugin.java"],
    custom_package = "dev.autoload.{{module}}.{{addon}}",
    exports_manifest = 1,
    manifest = "AndroidManifest.xml",
    proguard_specs = ["consumer-rules.pro"],
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
    deps = ["@godot//android:plugin_api"],
)
