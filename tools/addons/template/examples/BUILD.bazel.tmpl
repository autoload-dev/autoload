load("@autoload_rules_godot//godot:app.bzl", "godot_app")
load(
    "@autoload_rules_godot//godot:defs.bzl",
    "godot_editor",
    "godot_metadata_sync",
    "godot_pack",
    "godot_project",
    "godot_run",
)

package(default_visibility = ["//visibility:public"])

exports_files(["project.godot"])

godot_project(
    name = "demo",
    main_scene = "main/demo.tscn",
    project_file = "project.godot",
)

godot_pack(
    name = "pack",
    project = ":demo",
    deps = ["//examples/addons/{{module}}/main"],
)

godot_run(
    name = "run",
    headless = False,
    pack = ":pack",
)

godot_editor(
    name = "edit",
    project = ":demo",
    deps = ["//examples/addons/{{module}}/main"],
)

godot_metadata_sync(
    name = "update",
    size = "small",
    project = ":demo",
    deps = ["//examples/addons/{{module}}/main"],
)

godot_app(
    name = "app",
    application_id = "dev.autoload.examples.{{module}}",
    # A device build needs a provisioning profile for the application id. Put yours at
    # examples/addons/{{module}}/signing/{{module}}.mobileprovision (gitignored) and build with
    # --define=ios_signing=local, e.g. via `build:ios --define=ios_signing=local` in user.bazelrc.
    ios_provisioning_profile = select({
        ":local_ios_signing": "//examples/addons/{{module}}:provisioning_profile",
        "//conditions:default": None,
    }),
    pack = ":pack",
)

config_setting(
    name = "local_ios_signing",
    define_values = {"ios_signing": "local"},
)

# The local, gitignored iOS provisioning profile of the example applications. Empty without
# one; only device builds with --define=ios_signing=local select it.
filegroup(
    name = "provisioning_profile",
    srcs = glob(
        ["signing/{{module}}*.mobileprovision"],
        allow_empty = True,
    ),
)
