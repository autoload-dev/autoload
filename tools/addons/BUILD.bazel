load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# The add-on generator and its template; the conventions check (RG015) tests its rule against
# generated modules.
py_library(
    name = "new_lib",
    srcs = [
        "modules.py",
        "new.py",
        "registry.py",
        "uids.py",
    ],
    data = ["Addon.pkl"] + glob(["template/**"]),
    visibility = [
        "//tools/android:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
    ],
    deps = [
        "//tools/setup:modules_lib",
    ],
)

# `bazel run //tools/addons:new -- <module> [--addon <addon>]` writes a module or an add-on
# into this checkout (addons/AGENTS.md).
py_binary(
    name = "new",
    srcs = ["new.py"],
    tags = ["manual"],
    deps = [":new_lib"],
)

# A module's lane work, which tools/ci/work.py runs for each add-on module, and the
# generator's self-test, which runs a lane of a fresh module.
py_library(
    name = "lanes_lib",
    srcs = [
        "lanes.py",
        "selftest.py",
    ],
    deps = [":new_lib"],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_support.py"],
    # The files a repository test root starts from.
    data = [
        "//:.bazelversion",
        "//:bcr_metadata",
    ],
    deps = [":new_lib"],
)

py_test(
    name = "new_test",
    size = "small",
    srcs = ["new_test.py"],
    deps = [
        ":new_lib",
        ":test_support",
    ],
)

py_test(
    name = "lanes_test",
    size = "small",
    srcs = ["lanes_test.py"],
    deps = [":lanes_lib"],
)
