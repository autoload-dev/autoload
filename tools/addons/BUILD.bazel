load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# The add-on generator and its template; the conventions check (RG015) tests its rule against
# generated modules.
py_library(
    name = "new_lib",
    srcs = [
        "declarations.py",
        "modules.py",
        "new.py",
        "registry.py",
        "uids.py",
    ],
    data = glob(["template/**"]),
    visibility = [
        "//tools/android:__pkg__",
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
        "//tools/generate:__pkg__",
    ],
    deps = [
        "//tools/setup:modules_lib",
    ],
)

# `bazel run //tools/addons:new -- <module> [--addon <addon>]` writes a module or an add-on
# into this checkout (addons/AGENTS.md).
py_binary(
    name = "new",
    srcs = ["new.py"],
    tags = ["manual"],
    deps = [":new_lib"],
)

# The generator's self-test, which tests a fresh module as CI's job of this host does.
py_library(
    name = "selftest_lib",
    srcs = ["selftest.py"],
    deps = [":new_lib"],
)

py_library(
    name = "test_support",
    testonly = True,
    srcs = ["test_support.py"],
    # The files a repository test root starts from.
    data = [
        "//:.bazelversion",
        "//:bcr_metadata",
    ],
    visibility = [
        "//tools/ci:__pkg__",
        "//tools/conventions:__pkg__",
    ],
    deps = [":new_lib"],
)

py_test(
    name = "declarations_test",
    size = "small",
    srcs = ["declarations_test.py"],
    deps = [
        ":new_lib",
        ":test_support",
    ],
)

# root.targets, which the development verbs pass to Bazel, names every module of addons.bzl.
py_test(
    name = "root_targets_test",
    size = "small",
    srcs = ["root_targets_test.py"],
    args = [
        "$(rootpath //:addons.bzl)",
        "$(rootpath //:root.targets)",
    ],
    data = [
        "//:addons.bzl",
        "//:root.targets",
    ],
    deps = [":new_lib"],
)

py_test(
    name = "new_test",
    size = "small",
    srcs = ["new_test.py"],
    deps = [
        ":new_lib",
        ":test_support",
    ],
)

py_test(
    name = "selftest_test",
    size = "small",
    srcs = ["selftest_test.py"],
    deps = [
        ":selftest_lib",
        ":test_support",
    ],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "declarations.py",
        "declarations_test.py",
        "modules.py",
        "new.py",
        "new_test.py",
        "registry.py",
        "root_targets_test.py",
        "selftest.py",
        "selftest_test.py",
        "test_support.py",
        "uids.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = ["BUILD.bazel"],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
