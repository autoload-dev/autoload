load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

# The ruleset's tests of its API documentation (@autoload_rules_godot//godot/tests/...) run
# these checks in the ruleset's module.
package(default_visibility = ["//visibility:public"])

exports_files([
    "api_docs.py",
    "bcr_metadata_test.py",
    "contracts.py",
    "coverage_test.py",
    "evaluated_mismatch_test.py",
])

py_library(
    name = "ruleset_lib",
    srcs = ["ruleset.py"],
)

py_proto_library(
    name = "stardoc_py",
    deps = ["@stardoc//stardoc/proto:stardoc_output_proto"],
)

py_library(
    name = "coverage_lib",
    srcs = ["coverage.py"],
    deps = [
        ":output_contracts_lib",
        ":stardoc_py",
    ],
)

py_test(
    name = "coverage_unit_test",
    size = "small",
    srcs = ["coverage_unit_test.py"],
    deps = [":coverage_lib"],
)

py_library(
    name = "inventory_lib",
    srcs = ["api_docs.py"],
    deps = ["//tools/setup:modules_lib"],
)

py_library(
    name = "surface_lib",
    srcs = ["surface.py"],
    deps = [
        ":coverage_lib",
        ":ruleset_lib",
    ],
)

py_test(
    name = "inventory_test",
    size = "small",
    srcs = ["inventory_test.py"],
    deps = [":inventory_lib"],
)

starlark_doc_extract(
    name = "undocumented_fixture",
    src = "undocumented.bzl",
)

py_test(
    name = "evaluated_extraction_test",
    size = "small",
    srcs = ["evaluated_extraction_test.py"],
    args = [
        "$(rootpath :undocumented_fixture.textproto)",
        "$(rootpath :undocumented.bzl)",
    ],
    data = [
        "undocumented.bzl",
        ":undocumented_fixture.textproto",
    ],
    deps = [":coverage_lib"],
)

py_test(
    name = "surface_test",
    size = "small",
    srcs = ["surface_test.py"],
    deps = [
        ":coverage_lib",
        ":surface_lib",
    ],
)

py_library(
    name = "output_contracts_lib",
    srcs = ["output_contracts.py"],
    deps = [":ruleset_lib"],
)

py_test(
    name = "output_contracts_test",
    size = "small",
    srcs = ["output_contracts_test.py"],
    deps = [":output_contracts_lib"],
)

py_library(
    name = "evidence_lib",
    srcs = ["evidence.py"],
    deps = [
        ":output_contracts_lib",
        "//tools/conventions:context_lib",
    ],
)

py_test(
    name = "evidence_test",
    size = "small",
    srcs = ["evidence_test.py"],
    deps = [
        ":evidence_lib",
        "//tools/conventions:context_lib",
    ],
)

py_library(
    name = "contracts_lib",
    srcs = [
        "contracts.py",
        "public_contracts.py",
        "repository_contracts.py",
    ],
    deps = [
        ":coverage_lib",
        ":evidence_lib",
        ":output_contracts_lib",
        ":ruleset_lib",
        "//tools/conventions:context_lib",
    ],
)

py_test(
    name = "contracts_test",
    size = "small",
    srcs = ["contracts_test.py"],
    deps = [
        ":contracts_lib",
        ":evidence_lib",
        ":output_contracts_lib",
    ],
)

py_test(
    name = "repository_contracts_test",
    size = "small",
    srcs = ["repository_contracts_test.py"],
    deps = [":contracts_lib"],
)

py_test(
    name = "public_contracts_test",
    size = "small",
    srcs = [
        "public_contracts_test.py",
        "repository_contracts_test.py",
    ],
    deps = [":contracts_lib"],
)

filegroup(
    name = "python_files",
    testonly = True,
    srcs = [
        "api_docs.py",
        "bcr_metadata_test.py",
        "contracts.py",
        "contracts_test.py",
        "coverage.py",
        "coverage_test.py",
        "coverage_unit_test.py",
        "evaluated_extraction_test.py",
        "evaluated_mismatch_test.py",
        "evidence.py",
        "evidence_test.py",
        "inventory_test.py",
        "output_contracts.py",
        "output_contracts_test.py",
        "public_contracts.py",
        "public_contracts_test.py",
        "repository_contracts.py",
        "repository_contracts_test.py",
        "ruleset.py",
        "surface.py",
        "surface_test.py",
    ],
    tags = ["python_files"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "undocumented.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
