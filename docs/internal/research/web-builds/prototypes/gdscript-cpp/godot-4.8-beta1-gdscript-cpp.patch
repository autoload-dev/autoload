diff --git a/modules/gdscript/gdscript_ast_dump.cpp b/modules/gdscript/gdscript_ast_dump.cpp
new file mode 100644
index 0000000..54e3188
--- /dev/null
+++ b/modules/gdscript/gdscript_ast_dump.cpp
@@ -0,0 +1,355 @@
+/**************************************************************************/
+/*  gdscript_ast_dump.cpp                                                 */
+/**************************************************************************/
+/* PROTOTYPE: the analyzed syntax tree of a script, with its types, as    */
+/* JSON for an ahead-of-time compiler outside the engine.                 */
+/**************************************************************************/
+
+#include "gdscript_bytecode.h"
+
+#include "gdscript.h"
+#include "gdscript_cache.h"
+#include "gdscript_parser.h"
+
+#include "core/io/json.h"
+#include "core/variant/variant_utility.h"
+
+using P = GDScriptParser;
+
+// Reads the compiled script's member layout, which the syntax tree does not have.
+class GDScriptAstDump {
+public:
+	static GDScript *subclass(GDScript *p_script, const StringName &p_name) {
+		return p_script && p_script->subclasses.has(p_name) ? p_script->subclasses[p_name].ptr() : nullptr;
+	}
+
+	static Dictionary member_indices(GDScript *p_script) {
+		Dictionary indices;
+		if (p_script) {
+			for (const KeyValue<StringName, GDScript::MemberInfo> &kv : p_script->member_indices) {
+				indices[kv.key] = kv.value.index;
+			}
+		}
+		return indices;
+	}
+};
+
+namespace {
+
+const char *NODE_NAMES[] = {
+	"none", "annotation", "array", "assert", "assignment", "await", "binary", "break",
+	"breakpoint", "call", "cast", "class", "constant", "continue", "dictionary", "enum",
+	"for", "function", "get_node", "identifier", "if", "lambda", "literal", "match",
+	"match_branch", "parameter", "pass", "pattern", "preload", "return", "self", "signal",
+	"subscript", "suite", "ternary", "type", "type_test", "unary", "variable", "while",
+};
+
+const char *KIND_NAMES[] = { "builtin", "native", "script", "class", "enum", "variant", "resolving", "unresolved" };
+
+const char *SOURCE_NAMES[] = {
+	"undefined", "parameter", "local_variable", "local_constant", "local_iterator", "local_bind",
+	"member_variable", "member_constant", "member_function", "member_signal", "member_class",
+	"inherited_variable", "static_variable", "native_class",
+};
+
+Dictionary datatype(const P::DataType &p_type) {
+	Dictionary d;
+	d["kind"] = KIND_NAMES[p_type.kind];
+	d["hard"] = p_type.is_hard_type();
+	if (p_type.is_meta_type) {
+		d["meta"] = true;
+	}
+	if (p_type.kind == P::DataType::BUILTIN) {
+		d["builtin"] = Variant::get_type_name(p_type.builtin_type);
+	}
+	if (p_type.native_type != StringName()) {
+		d["native"] = p_type.native_type;
+	}
+	if (p_type.kind == P::DataType::CLASS && p_type.class_type) {
+		d["class"] = p_type.class_type->fqcn;
+	}
+	if (!p_type.script_path.is_empty()) {
+		d["script"] = p_type.script_path;
+	}
+	if (p_type.kind == P::DataType::ENUM) {
+		d["enum"] = p_type.enum_type;
+	}
+	if (!p_type.container_element_types.is_empty()) {
+		Array elements;
+		for (const P::DataType &e : p_type.container_element_types) {
+			elements.push_back(datatype(e));
+		}
+		d["elements"] = elements;
+	}
+	return d;
+}
+
+Dictionary value(const Variant &p_value) {
+	Dictionary d;
+	d["type"] = Variant::get_type_name(p_value.get_type());
+	if (p_value.get_type() == Variant::OBJECT) {
+		Object *obj = p_value;
+		Resource *res = Object::cast_to<Resource>(obj);
+		d["text"] = res ? res->get_path() : String(obj ? obj->get_class() : "null");
+	} else {
+		d["text"] = VariantUtilityFunctions::var_to_str(p_value);
+	}
+	return d;
+}
+
+Variant node(const P::Node *p_node);
+
+template <typename T>
+Array nodes(const T &p_list) {
+	Array a;
+	for (const P::Node *n : p_list) {
+		a.push_back(node(n));
+	}
+	return a;
+}
+
+void assignable(Dictionary &d, const P::AssignableNode *p_node) {
+	d["name"] = p_node->identifier->name;
+	d["type"] = datatype(p_node->type_constraint);
+	d["initializer"] = node(p_node->initializer);
+	d["conversion"] = p_node->use_conversion_assign;
+}
+
+void expression(Dictionary &d, const P::ExpressionNode *p_node) {
+	d["type"] = datatype(p_node->type_constraint);
+	if (p_node->is_constant && p_node->reduced) {
+		d["constant"] = value(p_node->reduced_value);
+	}
+	switch (p_node->type) {
+		case P::Node::ARRAY:
+			d["elements"] = nodes(static_cast<const P::ArrayNode *>(p_node)->elements);
+			break;
+		case P::Node::ASSIGNMENT: {
+			const P::AssignmentNode *n = static_cast<const P::AssignmentNode *>(p_node);
+			d["operator"] = n->operation == P::AssignmentNode::OP_NONE ? String() : Variant::get_operator_name(n->variant_op);
+			d["assignee"] = node(n->assignee);
+			d["value"] = node(n->assigned_value);
+			d["conversion"] = n->use_conversion_assign;
+		} break;
+		case P::Node::AWAIT:
+			d["operand"] = node(static_cast<const P::AwaitNode *>(p_node)->to_await);
+			break;
+		case P::Node::BINARY_OPERATOR: {
+			const P::BinaryOpNode *n = static_cast<const P::BinaryOpNode *>(p_node);
+			static const char *ops[] = { "+", "-", "*", "/", "%", "**", "<<", ">>", "&", "|", "^", "and", "or", "in", "==", "!=", "<", "<=", ">", ">=" };
+			d["operator"] = ops[n->operation];
+			d["left"] = node(n->left_operand);
+			d["right"] = node(n->right_operand);
+		} break;
+		case P::Node::CALL: {
+			const P::CallNode *n = static_cast<const P::CallNode *>(p_node);
+			d["function"] = n->function_name;
+			d["callee"] = node(n->callee);
+			d["arguments"] = nodes(n->arguments);
+			d["super"] = n->is_super;
+			d["static"] = n->is_static;
+		} break;
+		case P::Node::CAST:
+			d["operand"] = node(static_cast<const P::CastNode *>(p_node)->operand);
+			break;
+		case P::Node::DICTIONARY: {
+			Array pairs;
+			for (const P::DictionaryNode::Pair &pair : static_cast<const P::DictionaryNode *>(p_node)->elements) {
+				Array kv;
+				kv.push_back(node(pair.key));
+				kv.push_back(node(pair.value));
+				pairs.push_back(kv);
+			}
+			d["pairs"] = pairs;
+		} break;
+		case P::Node::GET_NODE:
+			d["path"] = static_cast<const P::GetNodeNode *>(p_node)->full_path;
+			break;
+		case P::Node::IDENTIFIER: {
+			const P::IdentifierNode *n = static_cast<const P::IdentifierNode *>(p_node);
+			d["name"] = n->name;
+			d["source"] = SOURCE_NAMES[n->source];
+		} break;
+		case P::Node::LAMBDA:
+			d["function"] = node(static_cast<const P::LambdaNode *>(p_node)->function);
+			break;
+		case P::Node::LITERAL:
+			d["value"] = value(static_cast<const P::LiteralNode *>(p_node)->value);
+			break;
+		case P::Node::PRELOAD:
+			d["path"] = static_cast<const P::PreloadNode *>(p_node)->resolved_path;
+			break;
+		case P::Node::SUBSCRIPT: {
+			const P::SubscriptNode *n = static_cast<const P::SubscriptNode *>(p_node);
+			d["base"] = node(n->base);
+			if (n->is_attribute) {
+				d["attribute"] = n->attribute->name;
+			} else {
+				d["index"] = node(n->index);
+			}
+		} break;
+		case P::Node::TERNARY_OPERATOR: {
+			const P::TernaryOpNode *n = static_cast<const P::TernaryOpNode *>(p_node);
+			d["condition"] = node(n->condition);
+			d["true"] = node(n->true_expr);
+			d["false"] = node(n->false_expr);
+		} break;
+		case P::Node::TYPE_TEST: {
+			const P::TypeTestNode *n = static_cast<const P::TypeTestNode *>(p_node);
+			d["operand"] = node(n->operand);
+			d["test"] = datatype(n->test_datatype);
+		} break;
+		case P::Node::UNARY_OPERATOR: {
+			const P::UnaryOpNode *n = static_cast<const P::UnaryOpNode *>(p_node);
+			static const char *ops[] = { "+", "-", "~", "not" };
+			d["operator"] = ops[n->operation];
+			d["operand"] = node(n->operand);
+		} break;
+		default:
+			break;
+	}
+}
+
+Dictionary function(const P::FunctionNode *p_node) {
+	Dictionary d;
+	d["name"] = p_node->identifier ? String(p_node->identifier->name) : String();
+	d["static"] = p_node->is_static;
+	d["coroutine"] = p_node->is_coroutine;
+	d["return"] = datatype(p_node->return_type_constraint);
+	d["parameters"] = nodes(p_node->parameters);
+	d["vararg"] = p_node->rest_parameter != nullptr;
+	d["body"] = node(p_node->body);
+	return d;
+}
+
+void statement(Dictionary &d, const P::Node *p_node) {
+	switch (p_node->type) {
+		case P::Node::ASSERT:
+			d["condition"] = node(static_cast<const P::AssertNode *>(p_node)->condition);
+			break;
+		case P::Node::CONSTANT:
+		case P::Node::PARAMETER:
+			assignable(d, static_cast<const P::AssignableNode *>(p_node));
+			break;
+		case P::Node::VARIABLE: {
+			const P::VariableNode *n = static_cast<const P::VariableNode *>(p_node);
+			assignable(d, n);
+			d["onready"] = n->onready;
+			d["exported"] = n->exported;
+			d["static"] = n->is_static;
+			d["property"] = n->property != P::VariableNode::PROP_NONE;
+		} break;
+		case P::Node::FOR: {
+			const P::ForNode *n = static_cast<const P::ForNode *>(p_node);
+			d["variable"] = n->variable->name;
+			d["variable_type"] = datatype(n->variable->type_constraint);
+			d["conversion"] = n->use_conversion_assign;
+			d["list"] = node(n->list);
+			d["body"] = node(n->loop);
+		} break;
+		case P::Node::FUNCTION:
+			d.merge(function(static_cast<const P::FunctionNode *>(p_node)));
+			break;
+		case P::Node::IF: {
+			const P::IfNode *n = static_cast<const P::IfNode *>(p_node);
+			d["condition"] = node(n->condition);
+			d["then"] = node(n->true_block);
+			d["else"] = node(n->false_block);
+		} break;
+		case P::Node::MATCH: {
+			const P::MatchNode *n = static_cast<const P::MatchNode *>(p_node);
+			d["test"] = node(n->test);
+			d["branches"] = nodes(n->branches);
+		} break;
+		case P::Node::MATCH_BRANCH: {
+			const P::MatchBranchNode *n = static_cast<const P::MatchBranchNode *>(p_node);
+			d["patterns"] = nodes(n->patterns);
+			d["body"] = node(n->block);
+			d["guard"] = node(n->guard_body);
+		} break;
+		case P::Node::PATTERN: {
+			const P::PatternNode *n = static_cast<const P::PatternNode *>(p_node);
+			static const char *kinds[] = { "literal", "expression", "bind", "array", "dictionary", "rest", "wildcard" };
+			d["kind"] = kinds[n->pattern_type];
+			if (n->pattern_type == P::PatternNode::PT_LITERAL) {
+				d["value"] = node(n->literal);
+			} else if (n->pattern_type == P::PatternNode::PT_EXPRESSION) {
+				d["value"] = node(n->expression);
+			}
+		} break;
+		case P::Node::RETURN: {
+			const P::ReturnNode *n = static_cast<const P::ReturnNode *>(p_node);
+			d["value"] = node(n->return_value);
+			d["type"] = datatype(n->return_type);
+			d["conversion"] = n->use_conversion;
+		} break;
+		case P::Node::SUITE: {
+			d["statements"] = nodes(static_cast<const P::SuiteNode *>(p_node)->statements);
+		} break;
+		case P::Node::WHILE: {
+			const P::WhileNode *n = static_cast<const P::WhileNode *>(p_node);
+			d["condition"] = node(n->condition);
+			d["body"] = node(n->loop);
+		} break;
+		default:
+			break;
+	}
+}
+
+Variant node(const P::Node *p_node) {
+	if (!p_node) {
+		return Variant();
+	}
+	Dictionary d;
+	d["node"] = NODE_NAMES[p_node->type];
+	d["line"] = p_node->start_line;
+	if (p_node->is_expression()) {
+		expression(d, static_cast<const P::ExpressionNode *>(p_node));
+	} else {
+		statement(d, p_node);
+	}
+	return d;
+}
+
+Dictionary klass(const P::ClassNode *p_class, GDScript *p_script) {
+	Dictionary d;
+	d["fqcn"] = p_class->fqcn;
+	d["base"] = datatype(p_class->base_type);
+	Array members;
+	for (const P::ClassNode::Member &m : p_class->members) {
+		switch (m.type) {
+			case P::ClassNode::Member::CLASS: {
+				Dictionary c = klass(m.m_class, GDScriptAstDump::subclass(p_script, m.m_class->identifier->name));
+				c["node"] = "class";
+				c["name"] = m.m_class->identifier->name;
+				members.push_back(c);
+			} break;
+			case P::ClassNode::Member::CONSTANT:
+			case P::ClassNode::Member::FUNCTION:
+			case P::ClassNode::Member::VARIABLE:
+			case P::ClassNode::Member::SIGNAL:
+				members.push_back(node(m.get_source_node()));
+				break;
+			default:
+				break;
+		}
+	}
+	d["members"] = members;
+	d["member_indices"] = GDScriptAstDump::member_indices(p_script);
+	return d;
+}
+
+} // namespace
+
+String GDScriptBytecodeWriter::ast(const String &p_path) {
+	Error err = OK;
+	bool scripting = ScriptServer::is_scripting_enabled();
+	ScriptServer::set_scripting_enabled(false);
+	Ref<GDScript> script = GDScriptCache::get_full_script(p_path, err);
+	Ref<GDScriptParserRef> ref = GDScriptCache::get_parser(p_path, GDScriptParserRef::FULLY_SOLVED, err);
+	ScriptServer::set_scripting_enabled(scripting);
+	ERR_FAIL_COND_V(err != OK || ref.is_null(), String());
+	Dictionary d = klass(ref->get_parser()->get_tree(), script.ptr());
+	d["path"] = p_path;
+	return JSON::stringify(d, "\t", false);
+}
