diff --git a/modules/gdscript/gdscript_native.h b/modules/gdscript/gdscript_native.h
new file mode 100644
index 0000000..7cc2a24
--- /dev/null
+++ b/modules/gdscript/gdscript_native.h
@@ -0,0 +1,161 @@
+/**************************************************************************/
+/*  gdscript_native.h                                                     */
+/**************************************************************************/
+/* PROTOTYPE: what GDScript compiled to C++ ahead of time (gen_cpp.py)    */
+/* needs from the runtime.                                                */
+/**************************************************************************/
+
+#pragma once
+
+#include "gdscript.h"
+#include "gdscript_function.h"
+
+#include "core/config/engine.h"
+#include "core/object/class_db.h"
+#include "core/io/resource_loader.h"
+#include "core/variant/variant_internal.h"
+#include "core/variant/variant_utility.h"
+
+#include <initializer_list>
+
+// A compiled function: script class, function name and the entry the runtime calls.
+struct GDScriptNativeEntry {
+	const char *fqcn;
+	const char *name;
+	GDScriptNativeFunction function;
+};
+
+struct GDScriptNative {
+	static Variant *members(GDScriptInstance *p_instance) { return p_instance ? p_instance->members.ptr() : nullptr; }
+
+	static Variant evaluate(Variant::Operator p_op, const Variant &p_a, const Variant &p_b) {
+		Variant result;
+		bool valid = false;
+		Variant::evaluate(p_op, p_a, p_b, result, valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), "Invalid operands in compiled GDScript.");
+		return result;
+	}
+
+	static Variant get_named(const Variant &p_base, const StringName &p_name) {
+		bool valid = false;
+		Variant result = p_base.get_named(p_name, valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), vformat("Invalid access to property '%s' in compiled GDScript.", p_name));
+		return result;
+	}
+
+	static Variant get_key(const Dictionary &p_base, const StringName &p_key) {
+		const Variant *value = p_base.getptr(p_key);
+		ERR_FAIL_NULL_V_MSG(value, Variant(), vformat("Invalid access to key '%s' in compiled GDScript.", p_key));
+		return *value;
+	}
+
+	static Variant get_indexed(const Variant &p_base, const Variant &p_index) {
+		bool valid = false;
+		Variant result = p_base.get(p_index, &valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), "Invalid index in compiled GDScript.");
+		return result;
+	}
+
+	static Variant construct(Variant::Type p_type, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[8];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Variant result;
+		Callable::CallError err;
+		Variant::construct(p_type, result, pointers, count, err);
+		ERR_FAIL_COND_V_MSG(err.error != Callable::CallError::CALL_OK, Variant(), "Invalid construction in compiled GDScript.");
+		return result;
+	}
+
+	static Dictionary dictionary(std::initializer_list<Variant> p_pairs) {
+		Dictionary d;
+		for (const Variant *it = p_pairs.begin(); it != p_pairs.end(); it += 2) {
+			d[it[0]] = it[1];
+		}
+		return d;
+	}
+
+	static Array array(std::initializer_list<Variant> p_items) {
+		Array a;
+		for (const Variant &item : p_items) {
+			a.push_back(item);
+		}
+		return a;
+	}
+
+	// The GDScript instance of an object; the analyzer checked the object's class.
+	static GDScriptInstance *instance(const Variant &p_object) {
+		Object *object = p_object.get_validated_object();
+		ERR_FAIL_NULL_V_MSG(object, nullptr, "Compiled GDScript accessed a null or freed instance.");
+		return static_cast<GDScriptInstance *>(object->get_script_instance());
+	}
+
+	// The same for a value that may be null, such as a typed local before assignment.
+	static GDScriptInstance *instance_or_null(const Variant &p_object) {
+		Object *object = p_object.get_validated_object();
+		return object ? static_cast<GDScriptInstance *>(object->get_script_instance()) : nullptr;
+	}
+
+	static Variant owner(GDScriptInstance *p_instance) { return Variant(p_instance->owner); }
+
+	static Variant call(const Variant &p_base, const StringName &p_method, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		Variant result;
+		const_cast<Variant &>(p_base).callp(p_method, pointers, count, result, err);
+		ERR_FAIL_COND_V_MSG(err.error != Callable::CallError::CALL_OK, Variant(), vformat("Compiled GDScript failed to call '%s'.", p_method));
+		return result;
+	}
+
+	static Variant utility(const StringName &p_function, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		Variant result;
+		Variant::call_utility_function(p_function, &result, pointers, count, err);
+		return result;
+	}
+
+	static Variant resource(const char *p_path) { return ResourceLoader::load(String::utf8(p_path)); }
+
+	// A script class by its fully qualified name, inner classes included.
+	static Variant script_class(const char *p_fqcn) {
+		const String fqcn = String::utf8(p_fqcn);
+		Ref<GDScript> script = ResourceLoader::load(fqcn.get_slice("::", 0));
+		ERR_FAIL_COND_V(script.is_null(), Variant());
+		return Variant(script->find_class(fqcn));
+	}
+
+	// A method of an engine singleton (`OS.get_name()`) or a static method of a native
+	// class (`JSON.stringify()`).
+	static Variant call_native(const StringName &p_class, const StringName &p_method, std::initializer_list<Variant> p_args) {
+		Object *singleton = Engine::get_singleton()->get_singleton_object(p_class);
+		if (singleton) {
+			return call(Variant(singleton), p_method, p_args);
+		}
+		const MethodBind *method = ClassDB::get_method(p_class, p_method);
+		ERR_FAIL_NULL_V_MSG(method, Variant(), vformat("Compiled GDScript found no method %s.%s.", p_class, p_method));
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		return method->call(nullptr, pointers, count, err);
+	}
+
+	// An engine singleton, the base of calls like `OS.get_name()`.
+	static Variant native(const StringName &p_class) { return Engine::get_singleton()->get_singleton_object(p_class); }
+
+	// A constant the generator could only write as text, parsed once.
+	static Variant constant(const char *p_text) { return VariantUtilityFunctions::str_to_var(String::utf8(p_text)); }
+};
