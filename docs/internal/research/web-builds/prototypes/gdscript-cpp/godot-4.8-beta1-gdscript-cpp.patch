diff --git a/modules/gdscript/gdscript_native.h b/modules/gdscript/gdscript_native.h
new file mode 100644
index 0000000..d6c1291
--- /dev/null
+++ b/modules/gdscript/gdscript_native.h
@@ -0,0 +1,393 @@
+/**************************************************************************/
+/*  gdscript_native.h                                                     */
+/**************************************************************************/
+/* PROTOTYPE: what GDScript compiled to C++ ahead of time (gen_cpp.py)    */
+/* needs from the runtime.                                                */
+/**************************************************************************/
+
+#pragma once
+
+#include "gdscript.h"
+#include "gdscript_function.h"
+
+#include "core/config/engine.h"
+#include "scene/main/node.h"
+#include "core/object/class_db.h"
+#include "core/variant/binder_common.h"
+#include "core/io/resource_loader.h"
+#include "core/variant/variant_internal.h"
+#include "core/variant/variant_utility.h"
+
+#include <initializer_list>
+#include <type_traits>
+#include <utility>
+
+// A compiled function: script class, function name and the entry the runtime calls.
+struct GDScriptNativeEntry {
+	const char *fqcn;
+	const char *name;
+	GDScriptNativeFunction function;
+};
+
+// `RequiredResult<T>`, which engine methods return for objects that are null only on error.
+template <typename>
+struct GDScriptNativeIsRequired : std::false_type {};
+template <typename T>
+struct GDScriptNativeIsRequired<RequiredResult<T>> : std::true_type {};
+
+struct GDScriptNative {
+	static Variant *members(GDScriptInstance *p_instance) { return p_instance ? p_instance->members.ptr() : nullptr; }
+
+	static Variant evaluate(Variant::Operator p_op, const Variant &p_a, const Variant &p_b) {
+		Variant result;
+		bool valid = false;
+		Variant::evaluate(p_op, p_a, p_b, result, valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), "Invalid operands in compiled GDScript.");
+		return result;
+	}
+
+	static Variant get_named(const Variant &p_base, const StringName &p_name) {
+		bool valid = false;
+		Variant result = p_base.get_named(p_name, valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), vformat("Invalid access to property '%s' in compiled GDScript.", p_name));
+		return result;
+	}
+
+	static Variant get_key(const Dictionary &p_base, const StringName &p_key) {
+		const Variant *value = p_base.getptr(p_key);
+		ERR_FAIL_NULL_V_MSG(value, Variant(), vformat("Invalid access to key '%s' in compiled GDScript.", p_key));
+		return *value;
+	}
+
+	static Variant get_indexed(const Variant &p_base, const Variant &p_index) {
+		bool valid = false;
+		Variant result = p_base.get(p_index, &valid);
+		ERR_FAIL_COND_V_MSG(!valid, Variant(), "Invalid index in compiled GDScript.");
+		return result;
+	}
+
+	static Variant construct(Variant::Type p_type, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[8];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Variant result;
+		Callable::CallError err;
+		Variant::construct(p_type, result, pointers, count, err);
+		ERR_FAIL_COND_V_MSG(err.error != Callable::CallError::CALL_OK, Variant(), "Invalid construction in compiled GDScript.");
+		return result;
+	}
+
+	static Dictionary dictionary(std::initializer_list<Variant> p_pairs) {
+		Dictionary d;
+		for (const Variant *it = p_pairs.begin(); it != p_pairs.end(); it += 2) {
+			d[it[0]] = it[1];
+		}
+		return d;
+	}
+
+	static Array array(std::initializer_list<Variant> p_items) {
+		Array a;
+		for (const Variant &item : p_items) {
+			a.push_back(item);
+		}
+		return a;
+	}
+
+	// The GDScript instance of an object; the analyzer checked the object's class.
+	static GDScriptInstance *instance(const Variant &p_object) {
+		Object *object = p_object.get_validated_object();
+		ERR_FAIL_NULL_V_MSG(object, nullptr, "Compiled GDScript accessed a null or freed instance.");
+		return static_cast<GDScriptInstance *>(object->get_script_instance());
+	}
+
+	// The same for a value that may be null, such as a typed local before assignment.
+	static GDScriptInstance *instance_or_null(const Variant &p_object) {
+		Object *object = p_object.get_validated_object();
+		return object ? static_cast<GDScriptInstance *>(object->get_script_instance()) : nullptr;
+	}
+
+	static Variant owner(GDScriptInstance *p_instance) { return Variant(p_instance->owner); }
+
+	static Variant call(const Variant &p_base, const StringName &p_method, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		Variant result;
+		const_cast<Variant &>(p_base).callp(p_method, pointers, count, result, err);
+		ERR_FAIL_COND_V_MSG(err.error != Callable::CallError::CALL_OK, Variant(), vformat("Compiled GDScript failed to call '%s'.", p_method));
+		return result;
+	}
+
+	static Variant utility(const StringName &p_function, std::initializer_list<Variant> p_args) {
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		Variant result;
+		Variant::call_utility_function(p_function, &result, pointers, count, err);
+		return result;
+	}
+
+	static Variant resource(const char *p_path) { return ResourceLoader::load(String::utf8(p_path)); }
+
+	// A script class by its fully qualified name, inner classes included.
+	static Variant script_class(const char *p_fqcn) {
+		const String fqcn = String::utf8(p_fqcn);
+		Ref<GDScript> script = ResourceLoader::load(fqcn.get_slice("::", 0));
+		ERR_FAIL_COND_V(script.is_null(), Variant());
+		return Variant(script->find_class(fqcn));
+	}
+
+	// `Class.new()` of an engine class; reference counted objects come back referenced.
+	static Variant instantiate(const StringName &p_class) {
+		Object *object = ClassDB::instantiate(p_class);
+		ERR_FAIL_NULL_V_MSG(object, Variant(), vformat("Compiled GDScript could not create a %s.", p_class));
+		RefCounted *counted = Object::cast_to<RefCounted>(object);
+		return counted ? Variant(Ref<RefCounted>(counted)) : Variant(object);
+	}
+
+	// A method of an engine singleton (`OS.get_name()`) or a static method of a native
+	// class (`JSON.stringify()`).
+	static Variant call_native(const StringName &p_class, const StringName &p_method, std::initializer_list<Variant> p_args) {
+		Object *singleton = Engine::get_singleton()->has_singleton(p_class) ? Engine::get_singleton()->get_singleton_object(p_class) : nullptr;
+		if (singleton) {
+			return call(Variant(singleton), p_method, p_args);
+		}
+		const MethodBind *method = ClassDB::get_method(p_class, p_method);
+		ERR_FAIL_NULL_V_MSG(method, Variant(), vformat("Compiled GDScript found no method %s.%s.", p_class, p_method));
+		const Variant *pointers[16];
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			pointers[count++] = &arg;
+		}
+		Callable::CallError err;
+		return method->call(nullptr, pointers, count, err);
+	}
+
+	// An engine singleton, the base of calls like `OS.get_name()`.
+	static Variant native(const StringName &p_class) { return Engine::get_singleton()->get_singleton_object(p_class); }
+
+	// Direct engine calls: the member function pointer a class binds, called with the
+	// binder's own argument conversion, but without a MethodBind or a lookup by name.
+	template <typename T>
+	static T *receiver(const Variant &p_object) {
+		T *object = Object::cast_to<T>(p_object.get_validated_object());
+		ERR_FAIL_NULL_V_MSG(object, nullptr, "Compiled GDScript called an engine method on a null or wrong object.");
+		return object;
+	}
+
+	static int pointers(std::initializer_list<Variant> p_args, const Variant **r_pointers) {
+		int count = 0;
+		for (const Variant &arg : p_args) {
+			r_pointers[count++] = &arg;
+		}
+		return count;
+	}
+
+	template <typename T, typename... P>
+	static Variant invoke(const Variant &p_object, void (T::*p_method)(P...), std::initializer_list<Variant> p_args) {
+		T *object = receiver<T>(p_object);
+		const Variant *args[16];
+		Callable::CallError err;
+		if (object) {
+			call_with_variant_args(object, p_method, args, pointers(p_args, args), err);
+		}
+		return Variant();
+	}
+
+	template <typename T, typename... P>
+	static Variant invoke(const Variant &p_object, void (T::*p_method)(P...) const, std::initializer_list<Variant> p_args) {
+		T *object = receiver<T>(p_object);
+		const Variant *args[16];
+		Callable::CallError err;
+		if (object) {
+			call_with_variant_argsc(object, p_method, args, pointers(p_args, args), err);
+		}
+		return Variant();
+	}
+
+	template <typename T, typename R, typename... P>
+	static Variant invoke(const Variant &p_object, R (T::*p_method)(P...), std::initializer_list<Variant> p_args) {
+		T *object = receiver<T>(p_object);
+		const Variant *args[16];
+		Callable::CallError err;
+		Variant result;
+		if (object) {
+			call_with_variant_args_ret(object, p_method, args, pointers(p_args, args), result, err);
+		}
+		return result;
+	}
+
+	template <typename T, typename R, typename... P>
+	static Variant invoke(const Variant &p_object, R (T::*p_method)(P...) const, std::initializer_list<Variant> p_args) {
+		T *object = receiver<T>(p_object);
+		const Variant *args[16];
+		Callable::CallError err;
+		Variant result;
+		if (object) {
+			call_with_variant_args_retc(object, p_method, args, pointers(p_args, args), result, err);
+		}
+		return result;
+	}
+
+	template <typename R, typename... P>
+	static Variant invoke_static(R (*p_method)(P...), std::initializer_list<Variant> p_args) {
+		const Variant *args[16];
+		Callable::CallError err;
+		Variant result;
+		call_with_variant_args_static_ret(p_method, args, pointers(p_args, args), result, err);
+		return result;
+	}
+
+	template <typename... P>
+	static Variant invoke_static(void (*p_method)(P...), std::initializer_list<Variant> p_args) {
+		const Variant *args[16];
+		Callable::CallError err;
+		call_with_variant_args_static(p_method, args, pointers(p_args, args), err);
+		return Variant();
+	}
+
+	static void set_indexed(Variant &p_base, const Variant &p_index, const Variant &p_value) {
+		bool valid = false;
+		p_base.set(p_index, p_value, &valid);
+		ERR_FAIL_COND_MSG(!valid, "Invalid index assignment in compiled GDScript.");
+	}
+
+	static void set_named(Variant &p_base, const StringName &p_name, const Variant &p_value) {
+		bool valid = false;
+		p_base.set_named(p_name, p_value, valid);
+		ERR_FAIL_COND_MSG(!valid, vformat("Invalid assignment of property '%s' in compiled GDScript.", p_name));
+	}
+
+	// A method of the script's object, or one of its signals, as a value.
+	static Callable method(GDScriptInstance *p_instance, const StringName &p_name) { return Callable(p_instance->owner, p_name); }
+	static Signal signal(GDScriptInstance *p_instance, const StringName &p_name) { return Signal(p_instance->owner, p_name); }
+
+	// A builtin value's method as a value, such as a signal's `emit`.
+	static Callable bound_method(const Variant &p_base, const StringName &p_name) { return Callable::create(p_base, p_name); }
+
+	static bool is_native(const Variant &p_value, const StringName &p_class) {
+		Object *object = p_value.get_validated_object();
+		return object && object->is_class(p_class);
+	}
+
+	static bool is_script(const Variant &p_value, const char *p_fqcn) {
+		Object *object = p_value.get_validated_object();
+		if (!object) {
+			return false;
+		}
+		Variant target = script_class(p_fqcn);
+		for (Ref<Script> script = object->get_script(); script.is_valid(); script = script->get_base_script()) {
+			if (Variant(script) == target) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	// `value as Class`: the object if it is one, null otherwise.
+	static Variant cast_native(const Variant &p_value, const StringName &p_class) { return is_native(p_value, p_class) ? p_value : Variant(); }
+	static Variant cast_script(const Variant &p_value, const char *p_fqcn) { return is_script(p_value, p_fqcn) ? p_value : Variant(); }
+
+	// `match`: a literal pattern matches a value of the same type that equals it.
+	static bool matches(const Variant &p_value, const Variant &p_pattern) {
+		return p_value.get_type() == p_pattern.get_type() && p_value == p_pattern;
+	}
+
+	static Array typed_array(Variant::Type p_type, const StringName &p_class, const Variant &p_script, std::initializer_list<Variant> p_items) {
+		Array a;
+		a.set_typed(p_type, p_class, p_script);
+		for (const Variant &item : p_items) {
+			a.push_back(item);
+		}
+		return a;
+	}
+
+	// `$Path`: a node relative to the script's node.
+	static Variant get_node(GDScriptInstance *p_instance, const char *p_path) {
+		Node *node = Object::cast_to<Node>(p_instance->owner);
+		ERR_FAIL_NULL_V_MSG(node, Variant(), "Compiled GDScript used $ outside a node.");
+		return Variant(node->get_node(NodePath(String::utf8(p_path))));
+	}
+
+	// Typed direct engine calls: arguments go to the method's parameter types without a
+	// Variant where the generator knows their C++ type, and the result comes back in the
+	// type the GDScript expression has.
+	template <typename R>
+	using Result = std::conditional_t<std::is_void_v<R>, void, std::decay_t<R>>;
+
+	// An argument as the parameter P takes it.
+	template <typename P, typename A>
+	static decltype(auto) arg(A &&p_value) {
+		using D = std::decay_t<A>;
+		using T = std::decay_t<P>;
+		if constexpr (std::is_same_v<D, Variant>) {
+			return VariantCaster<P>::cast(p_value);
+		} else if constexpr (std::is_same_v<D, T>) {
+			return std::forward<A>(p_value);
+		} else if constexpr (std::is_constructible_v<T, A>) {
+			return T(std::forward<A>(p_value));
+		} else if constexpr (std::is_enum_v<T>) {
+			return static_cast<T>(p_value);
+		} else {
+			return VariantCaster<P>::cast(Variant(p_value));
+		}
+	}
+
+	// A result as the type T the expression has.
+	template <typename T, typename R>
+	static T to(R &&p_value) {
+		using D = std::decay_t<R>;
+		if constexpr (GDScriptNativeIsRequired<D>::value) {
+			return to<T>(p_value._internal_ptr_dont_use());
+		} else if constexpr (std::is_same_v<D, Variant>) {
+			return T(p_value);
+		} else if constexpr (std::is_same_v<T, Variant>) {
+			if constexpr (std::is_enum_v<D> || !std::is_constructible_v<Variant, D>) {
+				return Variant(static_cast<int64_t>(p_value));
+			} else {
+				return Variant(p_value);
+			}
+		} else if constexpr (std::is_constructible_v<T, D>) {
+			return T(p_value);
+		} else {
+			return T(static_cast<int64_t>(p_value));
+		}
+	}
+
+	template <typename T, typename R, typename... P, typename... A>
+	static Result<R> direct(const Variant &p_object, R (T::*p_method)(P...), A &&...p_args) {
+		static_assert(sizeof...(P) == sizeof...(A));
+		T *object = receiver<T>(p_object);
+		if (unlikely(!object)) {
+			return Result<R>();
+		}
+		return (object->*p_method)(arg<P>(std::forward<A>(p_args))...);
+	}
+
+	template <typename T, typename R, typename... P, typename... A>
+	static Result<R> direct(const Variant &p_object, R (T::*p_method)(P...) const, A &&...p_args) {
+		static_assert(sizeof...(P) == sizeof...(A));
+		const T *object = receiver<T>(p_object);
+		if (unlikely(!object)) {
+			return Result<R>();
+		}
+		return (object->*p_method)(arg<P>(std::forward<A>(p_args))...);
+	}
+
+	template <typename R, typename... P, typename... A>
+	static Result<R> direct_static(R (*p_method)(P...), A &&...p_args) {
+		static_assert(sizeof...(P) == sizeof...(A));
+		return p_method(arg<P>(std::forward<A>(p_args))...);
+	}
+
+	// A constant the generator could only write as text, parsed once.
+	static Variant constant(const char *p_text) { return VariantUtilityFunctions::str_to_var(String::utf8(p_text)); }
+};
