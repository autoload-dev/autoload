+
+#pragma once
+
+#include "core/object/ref_counted.h"
+#include "core/templates/vector.h"
+
+class GDScript;
+
+// Saves a compiled GDScript (its classes, members, constants and the bytecode of every
+// function) into a portable buffer, and restores it without parsing or compiling. The
+// buffer replaces the binary tokens in an exported `.gdc` file. Function pointers into the
+// engine are stored by name and resolved again when loading, so the build that compiles
+// and the build that loads need the same classes and methods, not the same binary.
+class GDScriptBytecode {
+public:
+	static constexpr uint32_t MAGIC = 0x43424447; // "GDBC"
+	static constexpr uint32_t VERSION = 1;
+
+	static bool is_bytecode(const Vector<uint8_t> &p_buffer);
+
+	// Creates the inner class objects of a script, as GDScriptCompiler::make_scripts() does.
+	static Error make_shell(GDScript *p_script, const Vector<uint8_t> &p_buffer);
+	// Restores a compiled script whose shell make_shell() created.
+	static Error load(GDScript *p_script, const Vector<uint8_t> &p_buffer);
+	// Serializes a valid, compiled script.
+	static Error save(GDScript *p_script, Vector<uint8_t> &r_buffer);
+};
+
+// Exposes GDScriptBytecode::save() to scripts, so a build-time tool can compile a project's
+// scripts and write their bytecode.
+class GDScriptBytecodeWriter : public RefCounted {
+	GDCLASS(GDScriptBytecodeWriter, RefCounted);
+
+protected:
+	static void _bind_methods();
+
+public:
+	static PackedByteArray compile(const String &p_path);
+};
