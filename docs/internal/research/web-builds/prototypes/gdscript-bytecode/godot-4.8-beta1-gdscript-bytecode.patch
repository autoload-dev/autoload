+/**************************************************************************/
+/*  gdscript_no_compiler.cpp                                              */
+/**************************************************************************/
+/* PROTOTYPE: the entry points of the parser, analyzer and compiler in a  */
+/* runtime that only loads precompiled bytecode (GDSCRIPT_NO_COMPILER).   */
+/* Every one fails, so a script without bytecode reports an error.        */
+/**************************************************************************/
+
+#ifdef GDSCRIPT_NO_COMPILER
+
+#include "gdscript_analyzer.h"
+#include "gdscript_compiler.h"
+#include "gdscript_parser.h"
+
+#include "core/object/class_db.h"
+
+GDScriptParser::GDScriptParser() {}
+
+GDScriptParser::~GDScriptParser() {}
+
+Error GDScriptParser::parse(const String &p_source_code, const String &p_script_path, bool p_for_completion, bool p_parse_body) {
+	ERR_FAIL_V_MSG(ERR_UNAVAILABLE, vformat("Cannot parse \"%s\": this build only runs precompiled GDScript.", p_script_path));
+}
+
+Error GDScriptParser::parse_binary(const Vector<uint8_t> &p_binary, const String &p_script_path) {
+	ERR_FAIL_V_MSG(ERR_UNAVAILABLE, vformat("Cannot parse \"%s\": this build only runs precompiled GDScript.", p_script_path));
+}
+
+void GDScriptParser::clear() {}
+
+void GDScriptParser::cleanup() {}
+
+void GDScriptParser::get_annotation_list(List<MethodInfo> *r_annotations) const {}
+
+GDScriptAnalyzer::GDScriptAnalyzer(GDScriptParser *p_parser) {
+	parser = p_parser;
+}
+
+Error GDScriptAnalyzer::resolve_inheritance() {
+	return ERR_UNAVAILABLE;
+}
+
+Error GDScriptAnalyzer::resolve_interface() {
+	return ERR_UNAVAILABLE;
+}
+
+Error GDScriptAnalyzer::resolve_body() {
+	return ERR_UNAVAILABLE;
+}
+
+Error GDScriptAnalyzer::analyze() {
+	return ERR_UNAVAILABLE;
+}
+
+bool GDScriptAnalyzer::class_exists(const StringName &p_class) {
+	return ClassDB::class_exists(p_class) && ClassDB::is_class_exposed(p_class);
+}
+
+GDScriptCompiler::GDScriptCompiler() {}
+
+Error GDScriptCompiler::compile(const GDScriptParser *p_parser, GDScript *p_script, bool p_keep_state) {
+	return ERR_UNAVAILABLE;
+}
+
+String GDScriptCompiler::get_error() const {
+	return "This build only runs precompiled GDScript.";
+}
+
+int GDScriptCompiler::get_error_line() const {
+	return -1;
+}
+
+void GDScriptCompiler::make_scripts(GDScript *p_script, const GDScriptParser::ClassNode *p_class, bool p_keep_state) {}
+
+#endif // GDSCRIPT_NO_COMPILER
