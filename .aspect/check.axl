"""The check before a push: one entry point for people, the pre-push hook and agents."""

load("./work.axl", "run", "run_work")

def _check_impl(ctx: TaskContext) -> int:
    aspect = ctx.std.env.current_exe()

    # Each step reports on its own and runs alone as well.
    steps = [
        ("format", lambda: run(ctx, aspect, ["format", "--severity=fail"])),
        # The whole repository's lint, generated files and conventions, the setup contracts,
        # the setup action's tests, and the fast tests of the modules with the documentation
        # check.
        ("work", lambda: run_work(ctx, "lint", "generated", "conventions", "test:setup", "test:actions", "test:fast")),
        ("code-health", lambda: run(ctx, aspect, ["code-health", "--if-available"])),
    ]
    failed = []
    for name, step in steps:
        ctx.task.phase(name, description = name)
        if step() != 0:
            failed.append(name)
            if not ctx.args.keep_going:
                break
    if failed:
        return TaskConclusion(exit_code = 1, text = "Failed: " + ", ".join(failed))
    return 0

check = task(
    implementation = _check_impl,
    summary = "Check the change before a push: format, lint, generated files, conventions, fast tests, Code Health.",
    args = {
        "keep_going": args.boolean(default = False, short = "k", description = "Run every step even after one fails"),
    },
)
