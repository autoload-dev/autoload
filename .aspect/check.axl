"""The check before a push: one entry point for people, the pre-push hook and agents."""

load("./work.axl", "run_work")

def _aspect(ctx: TaskContext, *arguments) -> int:
    """Run another Aspect task in the repository root."""
    command = ctx.std.process.command(ctx.std.env.current_exe()).args(list(arguments))
    return command.current_dir(ctx.std.env.aspect_root_dir()).spawn().wait().code

def _check_impl(ctx: TaskContext) -> int:
    # Each step reports on its own and runs alone as well.
    steps = [
        ("format", lambda: _aspect(ctx, "format", "--severity=fail")),
        ("lint", lambda: _aspect(ctx, "lint")),
        # The whole repository's lint and generated files, the setup contracts, the setup
        # action's tests, and the fast tests of the modules with the documentation check.
        ("work", lambda: run_work(ctx, "lint", "generated", "test:setup", "test:actions", "test:fast")),
        ("code-health", lambda: _aspect(ctx, "code-health", "--if-available")),
    ]
    failed = []
    for name, step in steps:
        ctx.task.phase(name, description = name)
        if step() != 0:
            failed.append(name)
            if not ctx.args.keep_going:
                break
    if failed:
        return TaskConclusion(exit_code = 1, text = "Failed: " + ", ".join(failed))
    return 0

check = task(
    implementation = _check_impl,
    summary = "Check the change before a push: format, lint, generated files, fast tests, Code Health.",
    args = {
        "keep_going": args.boolean(default = False, short = "k", description = "Run every step even after one fails"),
    },
)
