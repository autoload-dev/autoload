"""
The repository's development verbs, which a developer, the Git hooks and CI share.

`aspect check` runs every check and the fast tests, as the pre-push hook does; `aspect tests`
runs one tier of tests; `aspect fix` formats the changed files and regenerates what the
checks compare. Each is a thin layer over Bazel targets and the `.bazelrc` configs `check`
and `fast`, run in the two workspaces of development: the root module, which builds the
add-on modules and the consumers, and the ruleset with its own tests.
"""

load("./work.axl", "run", "run_work", "run_work_tool", "spawn")

# The workspaces of development, relative to the repository root.
WORKSPACES = [".", "rules_godot"]

# The checks that are no Bazel targets: the lanes' work runs them whole (tools/ci/work.py).
TOOL_CHECKS = [
    "generated",
    "gazelle",
    "conventions",
]

# `bazel test` with no test among the targets, such as a tier a workspace has none of.
_NO_TESTS = 4

# The test tiers, each a config of shared.bazelrc: `fast` leaves out the tests that start a
# Godot process (RG026), `all` runs every test this host can run.
TIERS = ["fast", "all"]

# The argument that lets a task's steps go on after one fails.
KEEP_GOING = args.boolean(default = False, short = "k", description = "Run every step even after one fails")

def _patterns(ctx: TaskContext, workspace: str):
    """A workspace's target patterns, with the add-on modules' in the root module.

    The root module builds, tests and lints the add-on modules from there (RG027).
    """
    if workspace != ".":
        return ["//..."]
    addons = ctx.std.env.aspect_root_dir() + "/addons"
    names = [
        entry.path.rpartition("/")[2]
        for entry in ctx.std.fs.read_dir(addons)
        if not entry.is_file
    ]
    modules = [name for name in names if ctx.std.fs.exists(addons + "/" + name + "/MODULE.bazel")]
    return ["//..."] + ["@autoload_{}//...".format(module) for module in sorted(modules)]

def bazel(ctx: TaskContext, command: str, flags) -> int:
    """Run a Bazel command with the flags over every workspace's patterns at once.

    The workspaces have servers of their own, so their commands run side by side.

    Args:
        ctx: the running task's context.
        command: the Bazel command, such as `build` or `test`.
        flags: the flags of the command.

    Returns:
        0, or the first workspace's failing exit code.
    """
    children = [
        spawn(ctx, "bazel", [command] + list(flags) + ["--"] + _patterns(ctx, workspace), directory = workspace)
        for workspace in WORKSPACES
    ]
    codes = [child.wait().code for child in children]
    failed = [code for code in codes if code not in (0, _NO_TESTS)]
    return failed[0] if failed else 0

def bazel_tests(ctx: TaskContext, flags) -> int:
    """Run `bazel test` with the flags over every workspace's patterns at once."""
    return bazel(ctx, "test", flags)

def steps(ctx: TaskContext, steps):
    """Run named steps in order; stop at the first failure unless asked to keep going.

    Args:
        ctx: the running task's context, with the `keep_going` argument.
        steps: pairs of a step's name and a function that runs it and returns its exit code.

    Returns:
        The task's conclusion.
    """
    failed = []
    for name, step in steps:
        ctx.task.phase(name, description = name)
        if step() != 0:
            failed.append(name)
            if not ctx.args.keep_going:
                break
    if failed:
        return TaskConclusion(exit_code = 1, text = "Failed: " + ", ".join(failed))
    return 0

def run_checks(ctx: TaskContext, every: bool):
    """Run every check and the fast tests.

    Args:
        ctx: the running task's context, with the `keep_going` argument.
        every: whether the formatter covers the whole tree, as CI's does, or the files
            changed since the merge base with origin/main, as the pre-push hook's does.

    Returns:
        The task's conclusion.
    """
    aspect = ctx.std.env.current_exe()
    scope = ["--scope=all"] if every else []
    return steps(ctx, [
        ("format", lambda: run(ctx, aspect, ["format", "--severity=fail"] + scope)),
        # The lint check of the filegroups that Gazelle declares per package, which are no
        # tests (tools/lint/check.bzl): Markdown, GDScript and the per-file convention rules.
        ("lint", lambda: bazel(ctx, "build", ["--config=check", "--config=sources"])),
        ("bazel", lambda: bazel_tests(ctx, ["--config=check", "--config=fast"])),
        ("tools", lambda: run_work(ctx, *TOOL_CHECKS)),
        ("code-health", lambda: run(ctx, aspect, ["code-health", "--if-available"])),
    ])

def _check_impl(ctx: TaskContext):
    return run_checks(ctx, ctx.args.all)

check = task(
    implementation = _check_impl,
    summary = "Run every check and the fast tests: formatting, lint, generated files, conventions, API documentation, Code Health.",
    args = {
        "all": args.boolean(default = False, description = "Format the whole tree, as CI does, not only what changed since origin/main"),
        "keep_going": KEEP_GOING,
    },
)

# The checks of CI's Linux job before its Bazel work: the formatter on the whole tree, then
# the checks that are no Bazel targets.
CI_CHECKS = ["format"] + TOOL_CHECKS

def _ci_steps(ctx: TaskContext, host: str):
    """A host's CI job: on Linux every check first, then the host's lanes (tools/ci/hosts.py)."""
    checks = CI_CHECKS if host == "linux" else []
    return steps(ctx, [(check, lambda check = check: run_work(ctx, check)) for check in checks] + [
        ("bazel", lambda: run_work_tool(ctx, [host], module = "tools.ci.hosts")),
    ])

def _ci_task(host: str, summary: str):
    return task(
        group = ["ci"],
        implementation = lambda ctx: _ci_steps(ctx, host),
        summary = summary,
        args = {"keep_going": KEEP_GOING},
    )

linux = _ci_task("linux", "Run CI's Linux job: every check, then the quality, desktop and android lanes.")
macos = _ci_task("macos", "Run CI's macOS job: the desktop and ios lanes.")

def _test_impl(ctx: TaskContext) -> int:
    return bazel_tests(ctx, ["--config=" + ctx.args.tier])

tests = task(
    implementation = _test_impl,
    summary = "Run a tier of tests in the root module and the ruleset: fast (default) or all this host can run.",
    args = {
        "tier": args.string(default = "fast", values = TIERS, description = "fast: every test that starts no Godot process; all: every test"),
    },
)

def _fix_impl(ctx: TaskContext):
    aspect = ctx.std.env.current_exe()
    return steps(ctx, [
        ("format", lambda: run(ctx, aspect, ["format", "--severity=info"])),
        ("generate", lambda: run(ctx, aspect, ["generate"])),
    ])

fix = task(
    implementation = _fix_impl,
    summary = "Format the changed files and regenerate the lock and generated files the checks compare.",
    args = {
        "keep_going": KEEP_GOING,
    },
)
