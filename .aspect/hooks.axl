"""
The Git hooks' tasks, which `aspect bootstrap` installs: `aspect pre-commit` keeps a commit
formatted, its lock files current, its files linted and its Code Health from declining; `aspect pre-push` checks
the pushed checkout as CI's Linux job would, without its whole-tree formatter and its slower tests.
"""

load("./develop.axl", "KEEP_GOING", "file_lint", "run_checks", "steps")
load("./work.axl", "output", "python", "run")

def _lines(text: str) -> list:
    return [line for line in text.split("\n") if line]

def _diff(ctx: TaskContext, path: str) -> str:
    """A file's changes that are not staged."""
    return output(ctx, "git", ["diff", "--", path])

def _format_staged(ctx: TaskContext, aspect: str, staged) -> int:
    """Format the staged files and stage the result.

    A file with unstaged changes as well is formatted too, but staging it would take those
    along, so a change to it fails the step.
    """
    partial = {path: _diff(ctx, path) for path in _lines(output(ctx, "git", ["diff", "--name-only"])) if path in staged}
    if run(ctx, aspect, ["format", "--severity=info", "--"] + staged) != 0:
        return 1
    reformatted = [path for path, before in partial.items() if _diff(ctx, path) != before]
    if reformatted:
        print("Formatting changed partially staged files; stage them whole or as formatted: " + ", ".join(reformatted))
        return 1
    whole = [path for path in staged if path not in partial]
    return run(ctx, "git", ["add", "--"] + whole) if whole else 0

def _generate_staged(ctx: TaskContext, staged) -> int:
    """Regenerate the lock files the staged files shape, and stage them."""
    before = _lines(output(ctx, "git", ["diff", "--name-only"]))
    if python(ctx, ["-m", "tools.generate.generate"] + staged) != 0:
        return 1
    locks = [
        path
        for path in _lines(output(ctx, "git", ["diff", "--name-only"]))
        if path not in before and path.endswith("MODULE.bazel.lock")
    ]
    return run(ctx, "git", ["add", "--"] + locks) if locks else 0

def _pre_commit_impl(ctx: TaskContext):
    staged = _lines(output(ctx, "git", ["diff", "--cached", "--name-only", "--diff-filter=ACMR"]))
    if not staged:
        return 0
    aspect = ctx.std.env.current_exe()
    return steps(ctx, [
        ("format", lambda: _format_staged(ctx, aspect, staged)),
        ("generate", lambda: _generate_staged(ctx, staged)),
        ("lint", lambda: file_lint(ctx, staged)),
        ("code-health", lambda: run(ctx, aspect, ["code-health", "--staged", "--if-available"])),
    ])

pre_commit = task(
    implementation = _pre_commit_impl,
    summary = "Before a commit: format and stage the staged files, regenerate their lock files, lint them, review their Code Health.",
    args = {
        "keep_going": KEEP_GOING,
    },
)

def _pre_push_impl(ctx: TaskContext):
    # The pushed checkout gets `aspect check` (.aspect/develop.axl): the formatter and the
    # tool checks only where the change since origin/main reaches.
    return run_checks(ctx, False)

pre_push = task(
    implementation = _pre_push_impl,
    summary = "Before a push: check the checkout's formatting, lint, conventions, tests and Code Health.",
    args = {
        "keep_going": KEEP_GOING,
        # The hook's remote name and URL, which Git appends; the checks read the checkout.
        "remote": args.positional(minimum = 0, maximum = 2, default = []),
    },
)
