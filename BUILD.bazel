# The Aspect CLI's tasks, which name pieces of the named work, and the root module's target
# patterns they pass to Bazel.
filegroup(
    name = "aspect_tasks",
    srcs = glob([".aspect/*.axl"]) + ["root.targets"],
    visibility = ["//tools/ci:__pkg__"],
)

# The root module's declarations and Bazel settings, with those it shares with the other
# modules, which the setup checks read (tools/setup/checkout.py).
filegroup(
    name = "module_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "MODULE.bazel",
        "addons.MODULE.bazel",
        "buildbuddy.bazelrc",
        "shared.bazelrc",
    ],
    visibility = [
        "//tools/android:__pkg__",
        "//tools/setup:__pkg__",
    ],
)

exports_files(
    [
        ".bazelversion",
        ".buildifier.json",
        # It names the module to the lint check's per-file convention rules (tools/lint).
        "MODULE.bazel",
        "pyproject.toml",
        "ty.toml",
    ],
    visibility = ["//visibility:public"],
)

# The rules of gdlint and rumdl, which the lint check reads (tools/lint/check.bzl).
exports_files(
    [
        ".gdlintrc",
        ".rumdl.toml",
    ],
    visibility = ["//visibility:public"],
)

# The Aspect CLI's configuration, whose lint task runs the linters of the lint check.
exports_files(
    [".aspect/config.axl"],
    visibility = ["//tools/lint:__pkg__"],
)

# The add-on modules' generated repositories and the root's target patterns, which a test
# compares (tools/addons:root_targets_test).
exports_files(
    [
        "addons.bzl",
        "root.targets",
    ],
    visibility = ["//tools/addons:__pkg__"],
)

# The Bazel wrapper (tools/bazel), whose test runs it in a scratch workspace.
exports_files(
    ["tools/bazel"],
    visibility = ["//tools/setup:__pkg__"],
)

# The ruleset's registry metadata template, which the add-on generator's tests start from.
filegroup(
    name = "bcr_metadata",
    srcs = [".bcr/rules_godot/metadata.template.json"],
    visibility = ["//tools/addons:__pkg__"],
)

# The GitHub workflows and jactionlint's settings, which //tools/lint:workflows_test lints with.
filegroup(
    name = "workflows",
    srcs = glob([".github/workflows/*.yml"]) + [".github/jactionlint.yaml"],
    visibility = ["//tools/lint:__pkg__"],
)

# The setup action's shutdown of Bazel with its Node tests, which //tools/ci:setup_action_test runs.
filegroup(
    name = "setup_action",
    srcs = glob([".github/actions/setup/stop-bazel/**"]),
    visibility = ["//tools/ci:__pkg__"],
)

filegroup(
    name = "markdown_files",
    testonly = True,
    srcs = [
        ".agents/skills/bazel-api-docs/SKILL.md",
        ".agents/skills/bazel-api-docs/references/upstream.md",
        ".agents/skills/code-health/SKILL.md",
        "AGENTS.md",
        "README.md",
        "docs/AGENTS.md",
        "docs/internal/AGENTS.md",
        "docs/internal/README.md",
        "docs/internal/agent-setup.md",
        "docs/internal/code-health.md",
        "docs/internal/conventions.md",
        "docs/internal/glossary.md",
        "docs/internal/releasing.md",
        "docs/internal/verification.md",
        "docs/internal/verification-architecture.md",
        "docs/internal/verification-platforms.md",
        "docs/internal/verification-recipes.md",
    ],
    tags = ["markdown"],
    visibility = ["//visibility:private"],
)

filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "addons.MODULE.bazel",
        "addons.bzl",
    ],
    tags = ["starlark"],
    visibility = ["//visibility:private"],
)
