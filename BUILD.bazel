# The Godot language of Gazelle (tools/gazelle/godot, docs/internal/gazelle.md) declares the
# Godot projects, resources and GdUnit tests of examples/ and e2e/. The classes that the
# add-on modules' extensions register resolve to their targets here: Gazelle runs in this
# module alone and cannot index the add-on modules.
#
# gazelle:resolve godot class AppAuth @autoload_app_auth//app_auth
# gazelle:resolve godot class AppAuthLogin @autoload_app_auth//app_auth
# gazelle:resolve godot class AppAuthResult @autoload_app_auth//app_auth
# gazelle:resolve godot class FirebaseAnalytics @autoload_firebase//analytics
# gazelle:resolve godot class FirebaseCore @autoload_firebase//core
# gazelle:resolve godot class FirebaseFirestore @autoload_firebase//firestore
# gazelle:resolve godot class FirestoreTask @autoload_firebase//firestore
# gazelle:resolve godot class GdUnitTestSuite @autoload_gdunit//gdunit
# gazelle:resolve godot class PlatformPathResult @autoload_platform_paths//platform_paths
# gazelle:resolve godot class PlatformPaths @autoload_platform_paths//platform_paths
# gazelle:resolve godot class SQLiteDatabase @autoload_sqlite//sqlite
# gazelle:resolve godot class SentryBreadcrumb @autoload_sentry//sentry
# gazelle:resolve godot class SentrySDK @autoload_sentry//sentry

# The Aspect CLI's tasks, which name pieces of the named work, and the root module's target
# patterns they pass to Bazel.
filegroup(
    name = "aspect_tasks",
    srcs = glob([".aspect/*.axl"]) + ["root.targets"],
    visibility = ["//tools/ci:__pkg__"],
)

# The root module's declarations and Bazel settings, with those it shares with the other
# modules, which the setup checks read (tools/setup/checkout.py).
filegroup(
    name = "module_files",
    srcs = [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        "MODULE.bazel",
        "addons.MODULE.bazel",
        "buildbuddy.bazelrc",
        "shared.bazelrc",
        "//third_party/maven:android_ide_common_30_1_3_install.json",
        "//third_party/maven:bazel_worker_maven_install.json",
        "//third_party/maven:rules_android_maven_install.json",
    ],
    visibility = [
        "//tools/android:__pkg__",
        "//tools/setup:__pkg__",
    ],
)

exports_files(
    [
        ".bazelversion",
        ".buildifier.json",
        # The license every released module carries a copy of (tools/generate).
        "LICENSE",
        # It names the module to the lint check's per-file convention rules (tools/lint).
        "MODULE.bazel",
        "pyproject.toml",
        "ty.toml",
    ],
    visibility = ["//visibility:public"],
)

# The rules of gdlint, which the file lint reads from the checkout and
# //tools/lint:gdscript_test from its runfiles.
exports_files(
    [".gdlintrc"],
    visibility = ["//visibility:public"],
)

# The Aspect CLI's configuration, whose lint task runs the linters of the lint check.
exports_files(
    [".aspect/config.axl"],
    visibility = ["//tools/lint:__pkg__"],
)

# The add-on modules' generated repositories and the root's target patterns, which a test
# compares (tools/addons:root_targets_test).
exports_files(
    [
        "addons.bzl",
        "root.targets",
    ],
    visibility = ["//tools/addons:__pkg__"],
)

# The Bazel wrapper (tools/bazel), whose test runs it in a scratch workspace.
exports_files(
    ["tools/bazel"],
    visibility = ["//tools/setup:__pkg__"],
)

# The ruleset's registry metadata template, which the add-on generator's tests start from.
filegroup(
    name = "bcr_metadata",
    srcs = [".bcr/rules_godot/metadata.template.json"],
    visibility = ["//tools/addons:__pkg__"],
)

# The GitHub workflows and jactionlint's settings, which //tools/lint:workflows_test lints with.
filegroup(
    name = "workflows",
    srcs = glob([
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
    ]) + [".github/jactionlint.yaml"],
    visibility = ["//tools/lint:__pkg__"],
)

# The setup action's shutdown of Bazel with its Node tests, which //tools/ci:setup_action_test runs.
filegroup(
    name = "setup_action",
    srcs = glob([".github/actions/setup/stop-bazel/**"]),
    visibility = ["//tools/ci:__pkg__"],
)
