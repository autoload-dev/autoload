# The Aspect CLI's tasks, which name pieces of the lanes' work.
filegroup(
    name = "aspect_tasks",
    srcs = glob([".aspect/*.axl"]),
    visibility = ["//tools/ci:__pkg__"],
)

exports_files(
    [
        ".bazelversion",
        ".buildifier.json",
        "pyproject.toml",
        "ty.toml",
    ],
    visibility = ["//visibility:public"],
)

# The pinned Maven installations of the examples and scenarios (MODULE.bazel).
exports_files([
    "android_ide_common_30_1_3_install.json",
    "bazel_worker_maven_install.json",
    "maven_install.json",
    "rules_android_maven_install.json",
])

# The ruleset's registry metadata template, which the add-on generator's tests start from.
filegroup(
    name = "bcr_metadata",
    srcs = [".bcr/rules_godot/metadata.template.json"],
    visibility = ["//tools/addons:__pkg__"],
)

# The GitHub workflows and jactionlint's settings, which //tools/lint:workflows_test lints with.
filegroup(
    name = "workflows",
    srcs = glob([".github/workflows/*.yml"]) + [".github/jactionlint.yaml"],
    visibility = ["//tools/lint:__pkg__"],
)

# The setup action's shutdown of Bazel with its Node tests, which //tools/ci:setup_action_test runs.
filegroup(
    name = "setup_action",
    srcs = glob([".github/actions/setup/stop-bazel/**"]),
    visibility = ["//tools/ci:__pkg__"],
)
